               "eligible_only_if": [],
               "check": null
            }
         ]
      },
      {
         "id": "d",
         "prompt": "Find \\( \\displaystyle \\lim_{x \\to 2} \\frac{h(x) + x - 2}{x - 2} \\) and \\( \\displaystyle \\lim_{x \\to 2} \\frac{(x - 2)\\,g(x)}{h(x)} \\).",
         "setup_required": false,
         "answer_latex": "5, \\quad -\\frac{1}{4}",
         "worked_solution": [
            {
               "text": "Split the fraction into the given quotient plus 1.",
               "latex": "\\lim_{x \\to 2} \\frac{h(x) + x - 2}{x - 2} = \\lim_{x \\to 2} \\left[ \\frac{h(x)}{x - 2} + 1 \\right] = 4 + 1 = 5"
            },
            {
               "text": "Write the second limit as a product of the reciprocal quotient and g.",
               "latex": "\\lim_{x \\to 2} \\frac{(x - 2)\\,g(x)}{h(x)} = \\frac{1}{4} \\cdot (-1) = -\\frac{1}{4}"
            }
