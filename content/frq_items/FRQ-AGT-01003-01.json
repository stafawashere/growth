               "criterion": "Gives 2/3 as the limit of (f(x) + g(x))/(x + 1), or an equivalent exact value.",
               "eligible_only_if": [],
               "check": null
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( \\displaystyle \\lim_{x \\to 2} \\sqrt{f(x) + 6} \\) and \\( \\displaystyle \\lim_{x \\to 2} \\cos\\left( \\pi g(x) \\right) \\).",
         "setup_required": false,
         "answer_latex": "3, \\quad -1",
         "worked_solution": [
            {
               "text": "The square root is continuous at 9, so the limit passes inside.",
               "latex": "\\lim_{x \\to 2} \\sqrt{f(x) + 6} = \\sqrt{3 + 6} = 3"
            },
            {
               "text": "Cosine is continuous everywhere.",
               "latex": "\\lim_{x \\to 2} \\cos\\left( \\pi g(x) \\right) = \\cos(-\\pi) = -1"
            }
         ],
         "points": [
            {
               "point_id": "b1",
