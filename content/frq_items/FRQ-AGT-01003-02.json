   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( \\displaystyle \\lim_{x \\to 1^{-}} \\left[ f(x) + 2g(x) \\right] \\) and \\( \\displaystyle \\lim_{x \\to 1^{+}} \\left[ f(x) + 2g(x) \\right] \\). Does \\( \\displaystyle \\lim_{x \\to 1} \\left[ f(x) + 2g(x) \\right] \\) exist? Give a reason for your answer.",
         "setup_required": false,
         "answer_latex": "0, \\quad 10, \\quad \\text{does not exist}",
         "worked_solution": [
            {
               "text": "Left-hand limit by the sum and constant multiple theorems.",
               "latex": "\\lim_{x \\to 1^{-}} \\left[ f(x) + 2g(x) \\right] = 4 + 2(-2) = 0"
            },
            {
               "text": "Right-hand limit.",
               "latex": "\\lim_{x \\to 1^{+}} \\left[ f(x) + 2g(x) \\right] = 4 + 2(3) = 10"
            },
            {
               "text": "The one-sided limits differ, so the two-sided limit does not exist.",
               "latex": "0 \\neq 10"
            }
         ],
