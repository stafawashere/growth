   "stem": {
      "text": "A tank initially holds 50 liters of pure water. Starting at time \\( t = 0 \\), brine is pumped into the tank and nothing flows out. For \\( t \\ge 0 \\) minutes, the volume of liquid in the tank is \\( V(t) = 50 + 4t \\) liters and the amount of salt in the tank is \\( A(t) = 3t \\) grams. The concentration of salt in the tank is \\( C(t) = \\dfrac{A(t)}{V(t)} \\) grams per liter. A second tank contains \\( B(t) = 3t - 20 + 20e^{-t/10} \\) grams of salt at time \\( t \\) minutes."
   },
   "skills": [
      "BC-SKL-01058",
      "BC-SKL-01059",
      "BC-SKL-01060",
      "BC-SKL-01061",
      "BC-SKL-01063",
      "BC-SKL-01062"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Write a limit expression that describes the concentration of salt in the first tank in the long run, and evaluate it.",
         "setup_required": false,
         "answer_latex": "\\lim_{t \\to \\infty} \\frac{3t}{50 + 4t} = \\frac{3}{4}",
         "worked_solution": [
            {
               "text": "Long run means t increasing without bound.",
               "latex": "\\lim_{t \\to \\infty} C(t) = \\lim_{t \\to \\infty} \\frac{3t}{50 + 4t}"
            },
            {
               "text": "Divide numerator and denominator by t.",
               "latex": "\\lim_{t \\to \\infty} \\frac{3}{\\frac{50}{t} + 4} = \\frac{3}{4}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99054",
               "skills": [
                  "BC-SKL-01060"
               ],
               "criterion": "Writes the limit of C(t), or of 3t/(50 + 4t), as t tends to infinity in limit notation. A limit as t tends to 0, or arithmetic with infinity substituted, does not earn the point.",
               "eligible_only_if": [],
               "check": null
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-01058",
                  "BC-SKL-01059"
               ],
               "criterion": "Gives 3/4, or 0.75, grams per liter as the value.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "answer",
                  "expected": "3/4",
                  "up_to_constant": false,
                  "variable": "t"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( C'(t) \\). Write a limit expression that describes the rate of change of the concentration of salt in the first tank in the long run, and evaluate it.",
         "setup_required": false,
         "answer_latex": "\\lim_{t \\to \\infty} C'(t) = 0",
         "worked_solution": [
            {
               "text": "Quotient rule.",
               "latex": "C'(t) = \\frac{3(50 + 4t) - 3t \\cdot 4}{(50 + 4t)^{2}} = \\frac{150}{(50 + 4t)^{2}}"
            },
            {
               "text": "The numerator is constant and the denominator grows without bound.",
               "latex": "\\lim_{t \\to \\infty} C'(t) = \\lim_{t \\to \\infty} \\frac{150}{(50 + 4t)^{2}} = 0"
            }
         ],
