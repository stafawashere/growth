      {
         "id": "c",
         "prompt": "Let \\( k(x) = f\\left( x^{2} \\right) \\). Find \\( k'(x) \\) and \\( k'\\left( \\sqrt{\\pi} \\right) \\).",
         "setup_required": false,
         "answer_latex": "k'\\left( \\sqrt{\\pi} \\right) = 6\\sqrt{\\pi}\\,e^{\\pi}",
         "worked_solution": [
            {
               "text": "Chain rule with inner function x^2.",
               "latex": "k'(x) = 2x\\,f'\\left( x^{2} \\right) = 2x\\left( 3e^{x^{2}} - 4\\sin\\left( x^{2} \\right) \\right)"
            },
            {
               "text": "Evaluate at x = sqrt(pi), where x^2 = pi and sin(pi) = 0.",
               "latex": "k'\\left( \\sqrt{\\pi} \\right) = 2\\sqrt{\\pi}\\left( 3e^{\\pi} - 4\\sin\\pi \\right) = 6\\sqrt{\\pi}\\,e^{\\pi}"
            }
