      {
         "id": "d",
         "prompt": "Let \\( w(x) = h\\left( e^{x} \\right) \\). Find \\( w'(x) \\) and \\( w'(0) \\), and write an equation for the line tangent to the graph of \\( w \\) at \\( x = 0 \\).",
         "setup_required": false,
         "answer_latex": "y = -2\\sin 1 + (1 - 2\\cos 1)x",
         "worked_solution": [
            {
               "text": "Write w explicitly.",
               "latex": "w(x) = \\ln\\left( e^{x} \\right) - 2\\sin\\left( e^{x} \\right) = x - 2\\sin\\left( e^{x} \\right)"
            },
            {
               "text": "Chain rule.",
               "latex": "w'(x) = 1 - 2e^{x}\\cos\\left( e^{x} \\right)"
            },
            {
               "text": "Slope at x = 0.",
               "latex": "w'(0) = 1 - 2\\cos 1"
            },
            {
               "text": "Point at x = 0.",
               "latex": "w(0) = 0 - 2\\sin 1 = -2\\sin 1"
            },
            {
               "text": "Tangent line.",
               "latex": "y = -2\\sin 1 + (1 - 2\\cos 1)x"
            }
         ],
