         "prompt": "Find \\( f'(x) \\) and \\( f'(0) \\).",
         "setup_required": false,
         "answer_latex": "f'(0) = 3",
         "worked_solution": [
            {
               "text": "Differentiate term by term.",
               "latex": "f'(x) = 3e^{x} - 4\\sin x"
            },
            {
               "text": "Evaluate at x = 0.",
               "latex": "f'(0) = 3e^{0} - 4\\sin 0 = 3"
            }
