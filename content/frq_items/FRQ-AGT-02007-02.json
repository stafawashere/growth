      {
         "id": "b",
         "prompt": "Find \\( h''(x) \\) and \\( h''\\left( \\tfrac{\\pi}{2} \\right) \\). Show the work that leads to your answers.",
         "setup_required": false,
         "answer_latex": "h''\\left( \\frac{\\pi}{2} \\right) = 2 - \\frac{4}{\\pi^{2}}",
         "worked_solution": [
            {
               "text": "First derivative.",
               "latex": "h'(x) = \\frac{1}{x} - 2\\cos x"
            },
            {
               "text": "Second derivative.",
               "latex": "h''(x) = -\\frac{1}{x^{2}} + 2\\sin x"
            },
            {
               "text": "Evaluate at x = pi/2.",
               "latex": "h''\\left( \\frac{\\pi}{2} \\right) = -\\frac{4}{\\pi^{2}} + 2\\sin\\frac{\\pi}{2} = 2 - \\frac{4}{\\pi^{2}}"
            }
         ],
