   "stem": {
      "text": "Let \\( f(x) = x^{2}e^{x} \\) and \\( g(x) = \\dfrac{3x + 1}{x^{2} + 1} \\)."
   },
   "skills": ["BC-SKL-02036", "BC-SKL-02038", "BC-SKL-02039", "BC-SKL-02040", "BC-SKL-02042"],
   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( f'(x) \\).",
         "setup_required": false,
         "answer_latex": "f'(x) = e^{x}(x^{2} + 2x)",
         "worked_solution": [
            {"text": "Apply the product rule.", "latex": "f'(x) = 2x\\,e^{x} + x^{2}e^{x}"},
            {"text": "Factor.", "latex": "f'(x) = e^{x}(x^{2} + 2x)"}
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99022",
               "skills": ["BC-SKL-02036", "BC-SKL-02038"],
               "criterion": "Applies the product rule to get 2xe^x + x^2 e^x or an equivalent expression.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "(x**2 + 2*x)*exp(x)", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( g'(x) \\) and the value of \\( g'(1) \\).",
         "setup_required": false,
         "answer_latex": "g'(1) = -\\frac{1}{2}",
         "worked_solution": [
            {"text": "Apply the quotient rule.", "latex": "g'(x) = \\frac{3(x^{2}+1) - (3x+1)(2x)}{(x^{2}+1)^{2}}"},
            {"text": "Simplify the numerator.", "latex": "g'(x) = \\frac{-3x^{2} - 2x + 3}{(x^{2}+1)^{2}}"},
            {"text": "Substitute x = 1.", "latex": "g'(1) = \\frac{-3 - 2 + 3}{4} = -\\frac{1}{2}"}
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99080",
               "skills": ["BC-SKL-02039", "BC-SKL-02040"],
               "criterion": "Writes the quotient-rule derivative with 3(x^2 + 1) - (3x + 1)(2x) over (x^2 + 1)^2, or an equivalent expression.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "any_line", "expected": "(3*(x**2 + 1) - (3*x + 1)*2*x)/(x**2 + 1)**2", "up_to_constant": false, "each_side": false, "variable": "x"}
            },
            {
               "point_id": "b2",
               "point_type_id": "BC-PT-99004",
               "skills": ["BC-SKL-02039"],
               "criterion": "Gives g'(1) = -1/2.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "-1/2", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "c",
         "prompt": "Let \\( h(x) = f(x)\\,g(x) \\). Find \\( h'(1) \\). Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "h'(1) = \\frac{11e}{2}",
         "worked_solution": [
            {"text": "Product rule for h.", "latex": "h'(1) = f'(1)g(1) + f(1)g'(1)"},
            {"text": "Values from the given functions and parts (a) and (b).", "latex": "f(1) = e, \\quad f'(1) = 3e, \\quad g(1) = 2, \\quad g'(1) = -\\frac{1}{2}"},
            {"text": "Combine.", "latex": "h'(1) = 6e - \\frac{e}{2} = \\frac{11e}{2}"}
         ],
         "points": [
            {
               "point_id": "c1",
               "point_type_id": "BC-PT-99005",
               "skills": ["BC-SKL-02036"],
               "criterion": "Sets up h'(1) = f'(1)g(1) + f(1)g'(1) with the values substituted and gives 11e/2.",
