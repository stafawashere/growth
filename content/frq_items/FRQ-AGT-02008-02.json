   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( f'(x) \\) and \\( f'(1) \\).",
         "setup_required": false,
         "answer_latex": "f'(1) = 3",
         "worked_solution": [
            {
               "text": "Product rule.",
               "latex": "f'(x) = 2\\ln x + (2x + 1) \\cdot \\frac{1}{x}"
            },
            {
               "text": "Evaluate at x = 1, where ln 1 = 0.",
               "latex": "f'(1) = 2 \\cdot 0 + \\frac{3}{1} = 3"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99022",
               "skills": [
                  "BC-SKL-02036"
               ],
               "criterion": "Gives f'(x) = 2 ln x + (2x + 1)/x, or an equivalent expression such as 2 ln x + 2 + 1/x. The product of the derivatives, 2/x, does not earn the point.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "2*log(x) + (2*x + 1)/x",
                  "up_to_constant": false,
                  "variable": "x",
                  "each_side": false
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99004",
               "skills": [
