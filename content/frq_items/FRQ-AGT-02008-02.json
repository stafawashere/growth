               "criterion": "Gives f'(1) = 3.",
               "eligible_only_if": [],
               "check": null,
               "follows_from": [
                  "a1"
               ]
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( g'(x) \\), and simplify it to a single fraction whose numerator is a constant. Find \\( g'\\left( \\tfrac{\\pi}{6} \\right) \\).",
         "setup_required": false,
         "answer_latex": "g'\\left( \\frac{\\pi}{6} \\right) = -\\frac{2}{3}",
         "worked_solution": [
            {
               "text": "Quotient rule.",
               "latex": "g'(x) = \\frac{-\\sin x\\,(1 + \\sin x) - \\cos x \\cdot \\cos x}{(1 + \\sin x)^{2}}"
            },
            {
               "text": "Use sin^2 x + cos^2 x = 1 in the numerator.",
               "latex": "g'(x) = \\frac{-\\sin x - 1}{(1 + \\sin x)^{2}} = -\\frac{1}{1 + \\sin x}"
            },
            {
               "text": "Evaluate at x = pi/6, where sin x = 1/2.",
               "latex": "g'\\left( \\frac{\\pi}{6} \\right) = -\\frac{1}{1 + \\frac{1}{2}} = -\\frac{2}{3}"
            }
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99080",
               "skills": [
                  "BC-SKL-02039",
                  "BC-SKL-02040"
               ],
               "criterion": "Applies the quotient rule with the numerator -sin x(1 + sin x) - cos x cos x over (1 + sin x)^2, or writes any expression equivalent to g'(x). A numerator in reversed order or an unsquared denominator does not earn the point.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "(-sin(x)*(1 + sin(x)) - cos(x)**2)/(1 + sin(x))**2",
                  "up_to_constant": false,
                  "variable": "x",
                  "each_side": false
               }
            },
            {
               "point_id": "b2",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-02039"
               ],
               "criterion": "Simplifies g'(x) to -1/(1 + sin x), using sin^2 x + cos^2 x = 1. An unsimplified quotient does not earn the point.",
               "eligible_only_if": [
                  "b1"
               ],
               "check": null
            },
            {
               "point_id": "b3",
               "point_type_id": "BC-PT-99005",
