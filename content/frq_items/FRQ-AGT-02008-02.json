               "criterion": "Gives g'(pi/6) = -2/3, with a derivative expression shown.",
               "eligible_only_if": [],
               "check": null,
               "follows_from": [
                  "b1"
               ]
            }
         ]
      },
      {
         "id": "c",
         "prompt": "Let \\( p(x) = x^{2} g(x) \\). Find \\( p'(x) \\) and \\( p'\\left( \\tfrac{\\pi}{2} \\right) \\).",
         "setup_required": false,
         "answer_latex": "p'\\left( \\frac{\\pi}{2} \\right) = -\\frac{\\pi^{2}}{8}",
         "worked_solution": [
            {
               "text": "Product rule, with g'(x) from part (b).",
               "latex": "p'(x) = 2x\\,g(x) + x^{2} g'(x) = \\frac{2x\\cos x}{1 + \\sin x} - \\frac{x^{2}}{1 + \\sin x}"
            },
            {
               "text": "At x = pi/2, g(pi/2) = 0 and g'(pi/2) = -1/2.",
               "latex": "p'\\left( \\frac{\\pi}{2} \\right) = \\pi \\cdot 0 + \\frac{\\pi^{2}}{4} \\cdot \\left( -\\frac{1}{2} \\right) = -\\frac{\\pi^{2}}{8}"
            }
         ],
         "points": [
            {
               "point_id": "c1",
               "point_type_id": "BC-PT-99022",
               "skills": [
                  "BC-SKL-02036",
                  "BC-SKL-02038"
               ],
               "criterion": "Gives p'(x) = 2x g(x) + x^2 g'(x) with g and g' written out, or any expression equivalent to p'(x).",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "2*x*cos(x)/(1 + sin(x)) - x**2/(1 + sin(x))",
                  "up_to_constant": false,
                  "variable": "x",
                  "each_side": false
               }
            },
            {
               "point_id": "c2",
               "point_type_id": "BC-PT-99004",
               "skills": [
