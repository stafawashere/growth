   "stem": {
      "text": "The functions \\( f \\) and \\( g \\) are differentiable for all real numbers. The table gives values of \\( f \\), \\( g \\), and their derivatives at selected values of \\( x \\). \\[ \\begin{array}{c|cccc} x & 0 & 1 & 2 & 3 \\\\ \\hline f(x) & 2 & -1 & 3 & 4 \\\\ f'(x) & 5 & 2 & -4 & 1 \\\\ g(x) & 1 & 4 & -3 & 2 \\\\ g'(x) & -3 & 3 & 5 & 6 \\end{array} \\]"
   },
   "skills": [
      "BC-SKL-02037",
      "BC-SKL-02041",
      "BC-SKL-02017"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Let \\( h(x) = f(x)\\,g(x) \\). Find \\( h'(1) \\). Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "h'(1) = 5",
         "worked_solution": [
            {
               "text": "Product rule.",
               "latex": "h'(x) = f'(x)\\,g(x) + f(x)\\,g'(x)"
            },
            {
               "text": "Substitute the values at x = 1.",
               "latex": "h'(1) = 2 \\cdot 4 + (-1) \\cdot 3 = 5"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99022",
               "skills": [
                  "BC-SKL-02037"
               ],
               "criterion": "Writes h'(x) = f'(x)g(x) + f(x)g'(x), or the same rule with the values at x = 1 substituted. A product of the two derivatives, f'(1)g'(1), does not earn the point.",
               "eligible_only_if": [],
               "check": null
            },
            {
               "point_id": "a2",
