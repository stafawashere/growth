                  "target": "answer",
                  "expected": "5",
                  "up_to_constant": false,
                  "variable": "x"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Let \\( k(x) = \\dfrac{g(x)}{f(x)} \\). Find \\( k'(0) \\) and \\( k'(2) \\).",
         "setup_required": false,
         "answer_latex": "k'(0) = -\\frac{11}{4}, \\quad k'(2) = \\frac{1}{3}",
         "worked_solution": [
            {
               "text": "Quotient rule.",
               "latex": "k'(x) = \\frac{g'(x)\\,f(x) - g(x)\\,f'(x)}{\\left[ f(x) \\right]^{2}}"
            },
            {
               "text": "At x = 0.",
               "latex": "k'(0) = \\frac{(-3)(2) - (1)(5)}{2^{2}} = -\\frac{11}{4}"
            },
            {
               "text": "At x = 2.",
               "latex": "k'(2) = \\frac{(5)(3) - (-3)(-4)}{3^{2}} = \\frac{1}{3}"
            }
         ],
