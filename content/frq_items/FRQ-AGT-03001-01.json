   "stem": {
      "text": "Let \\( f(x) = x\\sqrt{5 + 4x^{2}} \\), and let \\( h(x) = \\ln\\big(\\cos(2x)\\big) \\) for \\( -\\tfrac{\\pi}{4} < x < \\tfrac{\\pi}{4} \\)."
   },
   "skills": ["BC-SKL-03002", "BC-SKL-03003", "BC-SKL-03006"],
   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( f'(x) \\).",
         "setup_required": false,
         "answer_latex": "f'(x) = \\sqrt{5 + 4x^{2}} + \\frac{4x^{2}}{\\sqrt{5 + 4x^{2}}}",
         "worked_solution": [
            {"text": "Product rule, with the chain rule on the square root.", "latex": "f'(x) = \\sqrt{5 + 4x^{2}} + x \\cdot \\frac{8x}{2\\sqrt{5 + 4x^{2}}}"},
            {"text": "Simplify.", "latex": "f'(x) = \\sqrt{5 + 4x^{2}} + \\frac{4x^{2}}{\\sqrt{5 + 4x^{2}}}"}
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99023",
               "skills": ["BC-SKL-03002", "BC-SKL-03006"],
               "criterion": "Differentiates the square root as 8x over 2 times the root inside a correct product rule, giving an expression equivalent to sqrt(5 + 4x^2) + 4x^2/sqrt(5 + 4x^2).",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "sqrt(5 + 4*x**2) + 4*x**2/sqrt(5 + 4*x**2)", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( f'(1) \\).",
         "setup_required": false,
         "answer_latex": "f'(1) = \\frac{13}{3}",
         "worked_solution": [
            {"text": "Substitute x = 1.", "latex": "f'(1) = 3 + \\frac{4}{3} = \\frac{13}{3}"}
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99004",
               "skills": ["BC-SKL-03002"],
               "criterion": "Gives f'(1) = 13/3.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "13/3", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "c",
         "prompt": "Find \\( h'(x) \\) and the value of \\( h'\\left(\\tfrac{\\pi}{8}\\right) \\).",
         "setup_required": false,
         "answer_latex": "h'\\left(\\tfrac{\\pi}{8}\\right) = -2",
         "worked_solution": [
            {"text": "Chain rule through the logarithm, the cosine and 2x.", "latex": "h'(x) = \\frac{1}{\\cos(2x)} \\cdot \\big(-\\sin(2x)\\big) \\cdot 2 = -2\\tan(2x)"},
            {"text": "Substitute x = pi/8.", "latex": "h'\\left(\\tfrac{\\pi}{8}\\right) = -2\\tan\\tfrac{\\pi}{4} = -2"}
         ],
         "points": [
            {
               "point_id": "c1",
               "point_type_id": "BC-PT-99023",
               "skills": ["BC-SKL-03003"],
               "criterion": "Writes h'(x) = -2tan(2x) or an equivalent expression carrying all three layers of the chain rule.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "any_line", "expected": "-2*tan(2*x)", "up_to_constant": false, "each_side": false, "variable": "x"}
            },
            {
               "point_id": "c2",
               "point_type_id": "BC-PT-99004",
