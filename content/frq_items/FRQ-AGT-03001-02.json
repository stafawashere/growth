         "worked_solution": [
            {
               "text": "The derivative of sin(pi x), which carries its own factor pi, times the exponential evaluated at sin(pi x).",
               "latex": "g'(x) = \\pi\\cos(\\pi x) \\cdot e^{\\sin(\\pi x)}"
            },
            {
               "text": "Substitute x = 1, where sin(pi) = 0 and cos(pi) = -1.",
               "latex": "g'(1) = e^{0} \\cdot (-1) \\cdot \\pi = -\\pi"
