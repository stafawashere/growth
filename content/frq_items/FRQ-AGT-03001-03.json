         "worked_solution": [
            {
               "text": "Derivative of the logarithm at the quadratic, times the derivative of the quadratic.",
               "latex": "F'(x) = \\frac{1}{x^{2} + 4x + 5} \\cdot (2x + 4) = \\frac{2x + 4}{x^{2} + 4x + 5}"
            },
            {
               "text": "Substitute x = 0.",
               "latex": "F'(0) = \\frac{4}{5}"
            }
         ],
