         ]
      },
      {
         "id": "b",
         "prompt": "Find the value of \\( \\dfrac{d^{2}y}{dx^{2}} \\) at the point \\( (1, 2) \\).",
         "setup_required": false,
         "answer_latex": "24",
         "worked_solution": [
            {"text": "Slope at (1, 2).", "latex": "\\frac{dy}{dx}\\Big|_{(1,2)} = 1 \\cdot 4 + 1 = 5"},
            {"text": "Second derivative at (1, 2).", "latex": "\\frac{d^{2}y}{dx^{2}}\\Big|_{(1,2)} = 4 + 2(1)(2)(5) = 24"}
         ],
