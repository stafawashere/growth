   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( \\dfrac{d^{2}y}{dx^{2}} \\) in terms of \\( x \\) and \\( y \\).",
         "setup_required": false,
         "answer_latex": "\\frac{d^{2}y}{dx^{2}} = y^{2} + 2xy\\left(xy^{2} + 1\\right)",
         "worked_solution": [
            {"text": "Differentiate x y^2 with the product rule, and y^2 with the chain rule.", "latex": "\\frac{d^{2}y}{dx^{2}} = y^{2} + 2xy\\frac{dy}{dx}"},
            {"text": "Substitute the differential equation for dy/dx.", "latex": "\\frac{d^{2}y}{dx^{2}} = y^{2} + 2xy\\left(xy^{2} + 1\\right)"}
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99022",
               "skills": ["BC-SKL-03030", "BC-SKL-03033"],
