      },
      {
         "id": "c",
         "prompt": "Let \\( g(x) = x e^{2x} \\). Find \\( g'(x) \\) and \\( g''(x) \\), and find the value of \\( g'''(0) \\).",
         "setup_required": false,
         "answer_latex": "g'''(0) = 12",
         "worked_solution": [
            {"text": "Product rule.", "latex": "g'(x) = e^{2x} + 2xe^{2x} = e^{2x}(1 + 2x)"},
            {"text": "Differentiate again.", "latex": "g''(x) = 2e^{2x} + 2e^{2x}(1 + 2x) = e^{2x}(4 + 4x)"},
            {"text": "Differentiate a third time.", "latex": "g'''(x) = 4e^{2x} + 2e^{2x}(4 + 4x) = e^{2x}(12 + 8x)"},
            {"text": "Substitute x = 0.", "latex": "g'''(0) = 12"}
         ],
