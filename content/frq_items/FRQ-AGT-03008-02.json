                  "kind": "numeric_three_decimals",
                  "expected": "4*pi"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find \\( \\dfrac{dy}{dx} \\) for the curve \\( C \\) in terms of \\( x \\) and \\( y \\).",
         "setup_required": false,
         "answer_latex": "\\frac{dy}{dx} = -\\frac{y}{x + 2y}",
         "worked_solution": [
            {
               "text": "Differentiate both sides with respect to x: product rule on xy, chain rule on y^2.",
               "latex": "y + x\\frac{dy}{dx} + 2y\\frac{dy}{dx} = 0"
            },
            {
               "text": "Collect the terms in dy/dx and solve.",
               "latex": "\\frac{dy}{dx} = -\\frac{y}{x + 2y}"
            }
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99022",
