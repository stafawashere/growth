   },
   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( g'(x) \\) and \\( g''(x) \\), and find the value of \\( g''\\left(\\sqrt{\\pi}\\right) \\).",
         "setup_required": false,
         "answer_latex": "g''\\left(\\sqrt{\\pi}\\right) = 4\\pi",
         "worked_solution": [
            {
               "text": "Chain rule on the cosine of x^2.",
               "latex": "g'(x) = -\\sin\\left(x^{2}\\right) \\cdot 2x = -2x\\sin\\left(x^{2}\\right)"
            },
            {
               "text": "Product rule on -2x times sin(x^2), with the chain rule on sin(x^2).",
               "latex": "g''(x) = -2\\sin\\left(x^{2}\\right) - 2x \\cdot 2x\\cos\\left(x^{2}\\right) = -2\\sin\\left(x^{2}\\right) - 4x^{2}\\cos\\left(x^{2}\\right)"
            },
            {
               "text": "At x = sqrt(pi), x^2 = pi, sin(pi) = 0 and cos(pi) = -1.",
               "latex": "g''\\left(\\sqrt{\\pi}\\right) = -2 \\cdot 0 - 4\\pi \\cdot (-1) = 4\\pi"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99023",
               "skills": [
                  "BC-SKL-03030"
               ],
               "criterion": "Writes g'(x) = -2x sin(x^2) or an equivalent expression; the factor 2x from x^2 must be present.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "-2*x*sin(x**2)",
                  "up_to_constant": false,
                  "each_side": false,
                  "variable": "x"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99022",
               "skills": [
                  "BC-SKL-03030",
                  "BC-SKL-03032"
               ],
               "criterion": "Applies the product rule to the two factors of g'(x), producing -2 sin(x^2) plus -2x times the derivative of sin(x^2). Treating -2x as a constant, or differentiating only one factor, does not earn the point.",
               "eligible_only_if": [],
