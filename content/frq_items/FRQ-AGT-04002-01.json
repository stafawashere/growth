   "stem": {
      "text": "A hot air balloon rises from a field. Its height above the ground is \\( B(t) \\) feet and the amount of propane left in its tank is \\( P(t) \\) gallons, where \\( t \\) is measured in minutes after launch. Both \\( B \\) and \\( P \\) are differentiable, and \\( P \\) is strictly decreasing. Selected values are given in the table. \\[ \\begin{array}{c|cccccc} t \\text{ (minutes)} & 0 & 4 & 10 & 15 & 20 & 24 \\\\ \\hline B(t) \\text{ (feet)} & 120 & 180 & 330 & 420 & 460 & 450 \\\\ \\hline P(t) \\text{ (gallons)} & 40.0 & 37.6 & 34.0 & 31.5 & 29.5 & 28.0 \\end{array} \\]"
   },
   "skills": [
      "BC-SKL-04004",
      "BC-SKL-04001",
      "BC-SKL-02014",
      "BC-SKL-02015",
      "BC-SKL-02016",
      "BC-SKL-02002",
      "BC-SKL-02003"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Use the data in the table to approximate \\( B'(7) \\). Show the computations that lead to your answer, and indicate units of measure.",
         "setup_required": false,
         "answer_latex": "25 \\text{ feet per minute}",
         "worked_solution": [
            {
               "text": "The table values that bracket t = 7 are at t = 4 and t = 10.",
               "latex": "B'(7) \\approx \\frac{B(10) - B(4)}{10 - 4} = \\frac{330 - 180}{6} = 25"
            },
            {
               "text": "Units are feet of height per minute of time.",
               "latex": "\\text{feet per minute}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99005",
               "skills": [
                  "BC-SKL-02014",
                  "BC-SKL-02016",
                  "BC-SKL-04004"
               ],
               "criterion": "Gives 25 supported by the difference quotient (330 - 180)/(10 - 4), using the rows t = 4 and t = 10 that bracket t = 7. A value with no difference and quotient shown does not earn the point.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
