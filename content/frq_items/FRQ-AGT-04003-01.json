   "stem": {
      "text": "A particle moves along the \\( x \\)-axis. Its position at time \\( t \\) is \\( s(t) = 2t^{3} - 15t^{2} + 36t - 10 \\) for \\( 0 \\le t \\le 5 \\), where \\( s(t) \\) is measured in meters and \\( t \\) in seconds."
   },
   "skills": [
      "BC-SKL-04006",
      "BC-SKL-04007",
      "BC-SKL-04008",
      "BC-SKL-04010"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Find the average velocity of the particle over the time interval \\( 0 \\le t \\le 4 \\). Show the computation that leads to your answer.",
         "setup_required": false,
         "answer_latex": "\\frac{s(4) - s(0)}{4 - 0} = 8",
         "worked_solution": [
            {
               "text": "Position at the two ends of the interval.",
               "latex": "s(0) = -10, \\quad s(4) = 128 - 240 + 144 - 10 = 22"
            },
            {
               "text": "Average velocity is the change in position over the elapsed time.",
               "latex": "\\frac{s(4) - s(0)}{4 - 0} = \\frac{22 - (-10)}{4} = 8"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99021",
               "skills": [
                  "BC-SKL-04006"
               ],
               "criterion": "Writes (s(4) - s(0))/(4 - 0) with the values, (22 - (-10))/4, and gives 8. The unsimplified quotient 32/4 is accepted.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "answer",
                  "expected": "8",
                  "up_to_constant": false,
                  "variable": "t",
                  "each_side": false
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the velocity and the acceleration of the particle at time \\( t = 1 \\). Is the speed of the particle increasing, decreasing, or neither at time \\( t = 1 \\)? Give a reason for your answer.",
         "setup_required": false,
         "answer_latex": "v(1) = 12, \\; a(1) = -18, \\; \\text{speed decreasing}",
         "worked_solution": [
            {
               "text": "Differentiate the position.",
               "latex": "v(t) = s'(t) = 6t^{2} - 30t + 36"
            },
            {
               "text": "Velocity at t = 1.",
               "latex": "v(1) = 6 - 30 + 36 = 12"
            },
            {
               "text": "Differentiate the velocity.",
               "latex": "a(t) = v'(t) = 12t - 30"
            },
            {
               "text": "Acceleration at t = 1.",
               "latex": "a(1) = 12 - 30 = -18"
            },
            {
               "text": "Velocity is positive and acceleration is negative, so the speed is decreasing.",
               "latex": "v(1) > 0, \\; a(1) < 0 \\Rightarrow \\text{speed decreasing}"
            }
         ],
         "points": [
            {
               "point_id": "b1",
