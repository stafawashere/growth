   "stem": {
      "text": "A potter rolls a piece of clay into a right circular cylinder. As the clay is rolled, the radius \\( r \\) of the cylinder decreases and its length \\( L \\) increases, while its volume stays constant at \\( 72\\pi \\) cubic centimeters. At a certain instant the radius is 2 centimeters and is decreasing at a rate of 0.1 centimeter per second. The volume of the cylinder is \\( V = \\pi r^{2} L \\), and the area of its curved side is \\( S = 2\\pi r L \\)."
   },
   "skills": [
      "BC-SKL-04017",
      "BC-SKL-04018",
      "BC-SKL-04019",
      "BC-SKL-04021",
      "BC-SKL-04023",
      "BC-SKL-04024",
      "BC-SKL-04025",
      "BC-SKL-04026",
      "BC-SKL-04027"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Find the length of the cylinder at the instant the radius is 2 centimeters.",
         "setup_required": false,
         "answer_latex": "L = 18",
         "worked_solution": [
            {
               "text": "Substitute r = 2 into the volume relation.",
               "latex": "\\pi (2)^{2} L = 72\\pi"
            },
            {
               "text": "Solve for L.",
               "latex": "L = 18"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-04018",
                  "BC-SKL-04026"
               ],
               "criterion": "Gives L = 18 centimeters from pi(2^2)L = 72 pi.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "answer",
                  "expected": "18",
                  "up_to_constant": false,
                  "variable": "x"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the rate at which the length of the cylinder is changing at that instant. Indicate units of measure.",
         "setup_required": false,
         "answer_latex": "\\frac{dL}{dt} = \\frac{9}{5}",
         "worked_solution": [
            {
               "text": "Differentiate the constant volume with respect to t, with the product rule and the chain rule.",
               "latex": "0 = \\pi\\left(2r\\frac{dr}{dt}L + r^{2}\\frac{dL}{dt}\\right)"
            },
            {
               "text": "Substitute r = 2, L = 18 and dr/dt = -0.1 after differentiating.",
               "latex": "0 = 2(2)(-0.1)(18) + 4\\frac{dL}{dt}"
            },
            {
               "text": "Solve for the rate of change of the length.",
               "latex": "\\frac{dL}{dt} = \\frac{9}{5}"
            },
            {
               "text": "Units.",
               "latex": "\\frac{dL}{dt} = 1.8 \\text{ cm/s}"
            }
         ],
         "points": [
