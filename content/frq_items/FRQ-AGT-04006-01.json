      {
         "id": "c",
         "prompt": "Find the rate at which the area of the curved side of the cylinder is changing at that instant. Indicate units of measure.",
         "setup_required": false,
         "answer_latex": "\\frac{dS}{dt} = \\frac{18\\pi}{5}",
         "worked_solution": [
            {
               "text": "Differentiate S = 2 pi r L with respect to t.",
               "latex": "\\frac{dS}{dt} = 2\\pi\\left(\\frac{dr}{dt}L + r\\frac{dL}{dt}\\right)"
            },
            {
               "text": "Substitute the values at that instant, using dL/dt from part (b).",
               "latex": "\\frac{dS}{dt} = 2\\pi\\left((-0.1)(18) + 2(1.8)\\right) = 2\\pi(1.8)"
            },
            {
               "text": "Simplify.",
               "latex": "\\frac{dS}{dt} = \\frac{18\\pi}{5}"
            },
            {
               "text": "Units.",
               "latex": "\\frac{dS}{dt} = 3.6\\pi \\text{ cm}^{2}\\text{/s}"
            }
