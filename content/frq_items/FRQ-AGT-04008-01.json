   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( f'(2) \\). Write an equation for the line tangent to the graph of \\( f \\) at \\( x = 2 \\), and use it to approximate \\( f(2.2) \\).",
         "setup_required": false,
         "answer_latex": "f(2.2) \\approx 5.6",
         "worked_solution": [
            {
               "text": "Slope at the point of tangency.",
               "latex": "f'(2) = \\sqrt{9} = 3"
            },
            {
               "text": "Tangent line through (2, 5).",
               "latex": "y = 5 + 3(x - 2)"
            },
            {
               "text": "Evaluate at x = 2.2.",
               "latex": "f(2.2) \\approx 5 + 3(0.2) = 5.6"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-04032"
               ],
               "criterion": "Gives f'(2) = 3.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "3",
                  "up_to_constant": false,
                  "variable": "x"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99005",
               "skills": [
                  "BC-SKL-04028"
               ],
               "criterion": "Writes the tangent line through (2, 5) with slope 3, for example y = 5 + 3(x - 2), in any equivalent form.",
               "eligible_only_if": [],
               "check": null
            },
            {
