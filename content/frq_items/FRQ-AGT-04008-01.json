               ],
               "criterion": "Approximates f(2.2) by 5.6 from the tangent line.",
               "eligible_only_if": [],
               "check": {
                  "kind": "numeric_three_decimals",
                  "expected": "28/5"
               },
               "follows_from": [
                  "a2"
               ]
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Show that the approximation found in part (a) is less than \\( f(2.2) \\).",
         "setup_required": false,
         "answer_latex": "5.6 < f(2.2)",
         "worked_solution": [
            {
               "text": "Differentiate f' with the chain rule.",
               "latex": "f''(x) = \\frac{3x^{2}}{2\\sqrt{x^{3}+1}}"
            },
            {
               "text": "For 2 <= x <= 2.2 the numerator and denominator are both positive.",
               "latex": "f''(x) > 0"
            },
            {
               "text": "The graph of f is concave up there, so it lies above its tangent line at x = 2.",
               "latex": "5.6 < f(2.2)"
            }
         ],
         "points": [
