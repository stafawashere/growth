         "answer_latex": "2",
         "worked_solution": [
            {"text": "Numerator and denominator both tend to 0.", "latex": "\\lim_{x\\to 0}(e^{2x} - 1 - 2x) = 0, \\quad \\lim_{x\\to 0}x^{2} = 0"},
            {"text": "Apply L'Hospital's Rule; the new quotient is again 0 over 0.", "latex": "\\lim_{x\\to 0}\\frac{2e^{2x} - 2}{2x}"},
            {"text": "Apply the rule a second time.", "latex": "\\lim_{x\\to 0}\\frac{4e^{2x}}{2} = 2"}
         ],
