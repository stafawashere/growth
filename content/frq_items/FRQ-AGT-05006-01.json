         "id": "a",
         "prompt": "Find the absolute maximum value of \\( f \\) on \\( 0 \\le x \\le 6 \\). Justify your answer.",
         "setup_required": false,
         "answer_latex": "36",
         "worked_solution": [
            {
               "text": "Set the derivative equal to zero.",
               "latex": "f'(x) = 3x^{2} - 18x + 24 = 3(x-2)(x-4) = 0, \\quad x = 2, 4"
            },
            {
               "text": "Evaluate f at the critical points and both endpoints.",
               "latex": "f(0) = 0,\\; f(2) = 20,\\; f(4) = 16,\\; f(6) = 36"
            },
            {
               "text": "The largest candidate value is at the right endpoint.",
               "latex": "\\text{absolute maximum } = 36"
            }
         ],
