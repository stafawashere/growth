   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( f'(x) \\). Find the \\( x \\)-coordinates of all critical points of \\( f \\).",
         "setup_required": false,
         "answer_latex": "x = -1, \\; x = 3",
         "worked_solution": [
            {
               "text": "Product rule.",
               "latex": "f'(x) = 2xe^{-x} - \\left(x^{2} - 3\\right)e^{-x} = -(x - 3)(x + 1)e^{-x}"
            },
            {
               "text": "Set the derivative equal to zero. The exponential factor is never zero.",
               "latex": "-(x - 3)(x + 1)e^{-x} = 0"
            },
            {
               "text": "Critical points.",
               "latex": "x = -1, \\; x = 3"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99005",
               "skills": [
                  "BC-SKL-05010"
               ],
               "criterion": "Finds f'(x) = (2x - x^2 + 3)e^(-x), in any equivalent form such as -(x - 3)(x + 1)e^(-x).",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "-(x - 3)*(x + 1)*exp(-x)",
                  "up_to_constant": false,
                  "variable": "x"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99013",
               "skills": [
                  "BC-SKL-05010"
               ],
               "criterion": "Sets f'(x) equal to zero, or an equivalent equation such as x^2 - 2x - 3 = 0, or refers to the critical points as the zeros of f'.",
               "eligible_only_if": [],
               "check": null
            },
            {
               "point_id": "a3",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-05010"
               ],
               "criterion": "Gives both critical points, x = -1 and x = 3, and no others.",
               "eligible_only_if": [
                  "a2"
               ],
               "check": null
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the absolute minimum value of \\( f \\) on the closed interval \\( -2 \\le x \\le 4 \\). Justify your answer.",
         "setup_required": false,
         "answer_latex": "f(-1) = -2e",
         "worked_solution": [
            {
               "text": "Candidates are the critical points and the endpoints.",
               "latex": "x = -2, \\; -1, \\; 3, \\; 4"
            },
            {
               "text": "Evaluate f at each candidate.",
               "latex": "f(-2) = e^{2}, \\; f(-1) = -2e, \\; f(3) = 6e^{-3}, \\; f(4) = 13e^{-4}"
            },
            {
               "text": "Only f(-1) is negative, so it is the smallest.",
               "latex": "f(-1) = -2e"
            }
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99011",
               "skills": [
                  "BC-SKL-05024",
