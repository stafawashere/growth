               ],
               "criterion": "Justifies with a candidates test that evaluates f at x = -2, -1, 3 and 4 (e^2, -2e, 6e^(-3) and 13e^(-4)), with no endpoint missing and no extra candidates.",
               "eligible_only_if": [],
