            }
         ]
      },
      {
         "id": "c",
         "prompt": "Find the absolute maximum value of \\( f \\) on the closed interval \\( -2 \\le x \\le 4 \\). Justify your answer.",
         "setup_required": false,
         "answer_latex": "f(-2) = e^{2}",
         "worked_solution": [
            {
               "text": "Same candidates and values as in part (b).",
               "latex": "f(-2) = e^{2}, \\; f(-1) = -2e, \\; f(3) = 6e^{-3}, \\; f(4) = 13e^{-4}"
            },
            {
               "text": "e^2 > 1, while 6e^(-3) < 6/8 < 1 and 13e^(-4) < 13/16 < 1.",
               "latex": "e^{2} > 1 > 6e^{-3}, \\; e^{2} > 1 > 13e^{-4}"
            },
            {
               "text": "The largest value is at the left endpoint.",
               "latex": "f(-2) = e^{2}"
            }
