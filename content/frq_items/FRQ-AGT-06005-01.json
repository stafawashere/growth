      {
         "id": "c",
         "prompt": "Write an expression, without an integral sign, for \\( W(t) \\), the amount of water in the tank at time \\( t \\) for \\( 0 \\le t \\le 12 \\). Use it to find \\( W(12) \\).",
         "setup_required": false,
         "answer_latex": "W(12) = 344",
         "worked_solution": [
            {
               "text": "Start from the initial amount plus the accumulated net rate.",
               "latex": "W(t) = 200 + \\int_{0}^{t} \\left(30 + 12\\sin\\frac{\\pi s}{6} - 3s\\right) ds"
            },
            {
               "text": "Antidifferentiate and evaluate from 0 to t.",
               "latex": "W(t) = 200 + 30t - \\frac{72}{\\pi}\\cos\\frac{\\pi t}{6} + \\frac{72}{\\pi} - \\frac{3t^{2}}{2}"
            },
            {
               "text": "Substitute t = 12, where cos(2 pi) = 1.",
               "latex": "W(12) = 200 + 360 - \\frac{72}{\\pi} + \\frac{72}{\\pi} - 216 = 344"
            }
         ],
