                  "variable": "t"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the amount of water in the tank at time \\( t = 6 \\).",
         "setup_required": false,
         "answer_latex": "326 + \\frac{144}{\\pi}",
         "worked_solution": [
            {
               "text": "The amount at t = 6 is the starting amount plus the net inflow.",
               "latex": "200 + \\int_{0}^{6} \\left(R(t) - D(t)\\right) dt"
            },
            {
               "text": "The drained amount is the integral of 3t from 0 to 6.",
               "latex": "\\int_{0}^{6} 3t\\,dt = \\left[\\frac{3t^{2}}{2}\\right]_{0}^{6} = 54"
            },
            {
               "text": "Combine with part (a).",
               "latex": "200 + \\left(180 + \\frac{144}{\\pi}\\right) - 54 = 326 + \\frac{144}{\\pi}"
            }
         ],
