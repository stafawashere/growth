   "stem": {
      "text": "Water flows into a tank at the rate \\( R(t) = 30 + 12\\sin\\left(\\dfrac{\\pi t}{6}\\right) \\) liters per hour and drains out of the tank at the rate \\( D(t) = 3t \\) liters per hour, where \\( t \\) is measured in hours and \\( 0 \\le t \\le 12 \\). At time \\( t = 0 \\) the tank holds 200 liters of water."
   },
   "skills": [
      "BC-SKL-06036",
      "BC-SKL-06037",
      "BC-SKL-06034",
      "BC-SKL-08012",
      "BC-SKL-08016",
      "BC-SKL-08017",
      "BC-SKL-08009"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "How many liters of water flow into the tank during the time interval \\( 0 \\le t \\le 6 \\)? Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "180 + \\frac{144}{\\pi}",
         "worked_solution": [
            {
               "text": "Integrate the inflow rate over the interval.",
               "latex": "\\int_{0}^{6} \\left(30 + 12\\sin\\frac{\\pi t}{6}\\right) dt"
            },
            {
               "text": "Antidifferentiate.",
               "latex": "\\left[30t - \\frac{72}{\\pi}\\cos\\frac{\\pi t}{6}\\right]_{0}^{6}"
            },
            {
               "text": "Evaluate, with cos(pi) = -1 and cos(0) = 1.",
               "latex": "\\left(180 + \\frac{72}{\\pi}\\right) - \\left(-\\frac{72}{\\pi}\\right) = 180 + \\frac{144}{\\pi}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99001",
               "skills": [
                  "BC-SKL-08016",
                  "BC-SKL-06036"
               ],
               "criterion": "Writes the definite integral of R(t) from 0 to 6.",
               "eligible_only_if": [],
               "check": {
                  "kind": "bounds_match",
                  "lower": "0",
                  "upper": "6",
                  "integrand": null,
                  "variable": "t"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99003",
               "skills": [
                  "BC-SKL-06034"
               ],
               "criterion": "Writes the antiderivative 30t - (72/pi)cos(pi t/6) of R(t).",
               "eligible_only_if": [
