         "prompt": "Find the battery level at time \\( t = 20 \\).",
         "setup_required": true,
         "answer_latex": "B(20) \\approx 58.593",
         "worked_solution": [
            {
               "text": "The level at t = 20 is the starting level plus the charge gained over 0 <= t <= 20.",
               "latex": "B(20) = 18 + \\int_{0}^{20} c(t)\\,dt"
            },
            {
               "text": "Evaluate the integral on the calculator.",
               "latex": "\\int_{0}^{20} c(t)\\,dt \\approx 40.593"
            },
            {
               "text": "Add.",
               "latex": "B(20) \\approx 58.593"
            }
         ],
         "points": [
