   "stem": {
      "text": "A phone is plugged in to charge. Its battery level is \\( B(t) \\) percent, where \\( t \\) is the number of minutes since the phone was plugged in. For \\( 0 \\le t \\le 60 \\), the battery level increases at a rate modeled by \\( c(t) = 2.2e^{-t^{2}/1600} \\) percent per minute. At time \\( t = 0 \\) the battery level is 18 percent."
   },
   "skills": [
      "BC-SKL-06036",
      "BC-SKL-06037",
      "BC-SKL-06034",
      "BC-SKL-08012",
      "BC-SKL-08016",
      "BC-SKL-08017",
      "BC-SKL-08009"
   ],
   "functions": {
      "c": {
         "variable": "t",
         "expression": "11/5*exp(-t**2/1600)"
      },
      "B": {
         "variable": "t",
         "expression": "Piecewise((18 + Integral(11/5*exp(-s**2/1600), (s, 0, t)), t <= 60), (18 + Integral(11/5*exp(-s**2/1600), (s, 0, 60)) - Integral(3/5 + sin(s/8)/4, (s, 60, t)), True))"
      },
      "u": {
         "variable": "t",
         "expression": "3/5 + sin(t/8)/4"
      }
   },
   "parts": [
      {
