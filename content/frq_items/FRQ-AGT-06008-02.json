         "prompt": "Find \\( \\displaystyle\\int \\frac{\\sin x}{\\cos^{3} x}\\,dx \\).",
         "setup_required": false,
         "answer_latex": "\\frac{1}{2\\cos^{2} x} + C",
         "worked_solution": [
            {
               "text": "Let u = cos x, so du = -sin x dx.",
               "latex": "\\int \\frac{\\sin x}{\\cos^{3} x}\\,dx = -\\int u^{-3}\\,du"
            },
            {
               "text": "Antidifferentiate and back-substitute.",
               "latex": "-\\frac{u^{-2}}{-2} + C = \\frac{1}{2\\cos^{2} x} + C"
            }
         ],
         "points": [
