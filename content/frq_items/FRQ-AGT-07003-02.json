   "stem": {
      "text": "A function \\( y = f(t) \\) is positive and continuous for \\( t \\ge 0 \\), with \\( f(0) = 1 \\). For \\( 0 < t < 2 \\) the function satisfies the differential equation \\( \\dfrac{dy}{dt} = 4t\\sqrt{y} \\), and for \\( t > 2 \\) it satisfies the differential equation \\( \\dfrac{dy}{dt} = -\\dfrac{2y}{t} \\)."
   },
   "skills": [
      "BC-SKL-07024",
      "BC-SKL-07025",
      "BC-SKL-07026",
      "BC-SKL-07027",
      "BC-SKL-07029",
      "BC-SKL-07030",
      "BC-SKL-07033"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Use separation of variables to find \\( f(t) \\) for \\( 0 \\le t \\le 2 \\).",
         "setup_required": false,
         "answer_latex": "f(t) = (t^{2}+1)^{2}",
         "worked_solution": [
            {
               "text": "Separate the variables.",
               "latex": "\\frac{1}{\\sqrt{y}}\\,dy = 4t\\,dt"
            },
            {
               "text": "Antidifferentiate both sides.",
               "latex": "2\\sqrt{y} = 2t^{2} + C"
            },
            {
               "text": "Use f(0) = 1.",
               "latex": "2 = 0 + C, \\quad C = 2"
            },
            {
               "text": "Solve for y. The square root is positive, so squaring loses nothing.",
               "latex": "\\sqrt{y} = t^{2} + 1, \\quad f(t) = (t^{2}+1)^{2}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99028",
               "skills": [
                  "BC-SKL-07024"
               ],
               "criterion": "Separates the variables so that y and dy sit on one side and t and dt on the other, for example dy over the square root of y equals 4t dt.",
