   "parts": [
      {
         "id": "a",
         "prompt": "Find \\( \\dfrac{d^{2}y}{dx^{2}} \\) in terms of \\( x \\) and \\( y \\), and find the value of \\( f''(0) \\).",
         "setup_required": false,
         "answer_latex": "f''(0) = 1",
         "worked_solution": [
            {
               "text": "Differentiate y - 2x with respect to x.",
               "latex": "\\frac{d^{2}y}{dx^{2}} = \\frac{dy}{dx} - 2 = y - 2x - 2"
            },
            {
               "text": "Evaluate at (0, 3).",
               "latex": "f''(0) = 3 - 0 - 2 = 1"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99005",
               "skills": [
                  "BC-SKL-07023"
               ],
               "criterion": "Differentiates the right side with dy/dx carried through and substitutes, giving d2y/dx2 = y - 2x - 2.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "y - 2*x - 2",
                  "up_to_constant": false,
                  "variable": "x"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99004",
               "skills": [
                  "BC-SKL-07023"
               ],
               "criterion": "Gives f''(0) = 1.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "answer",
                  "expected": "1",
                  "up_to_constant": false,
                  "variable": "x"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Use Euler's method, starting at \\( x = 0 \\) with two steps of equal size, to approximate \\( f(1) \\). Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "f(1) \\approx \\frac{25}{4}",
         "worked_solution": [
            {
               "text": "Step size.",
               "latex": "\\Delta x = 0.5"
            },
            {
               "text": "First step from (0, 3), slope 3 - 0 = 3.",
               "latex": "f(0.5) \\approx 3 + 0.5(3) = 4.5"
            },
            {
               "text": "Second step from (0.5, 4.5), slope 4.5 - 1 = 3.5.",
               "latex": "f(1) \\approx 4.5 + 0.5(3.5) = 6.25"
            }
         ],
         "points": [
