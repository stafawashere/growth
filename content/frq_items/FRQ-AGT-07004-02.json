   "stem": {
      "text": "Let \\( y = f(x) \\) be the solution to the differential equation \\( \\dfrac{dy}{dx} = y - 2x \\) with the initial condition \\( f(0) = 3 \\)."
   },
   "skills": [
      "BC-SKL-07019",
