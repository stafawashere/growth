   "parts": [
      {
         "id": "a",
         "prompt": "Show that \\( y = 5e^{2x} - 2x - 1 \\) is a solution to the differential equation.",
         "setup_required": false,
         "answer_latex": "\\frac{dy}{dx} = 2y + 4x",
         "worked_solution": [
            {"text": "Differentiate the candidate.", "latex": "\\frac{dy}{dx} = 10e^{2x} - 2"},
            {"text": "Substitute into the right side.", "latex": "2y + 4x = 10e^{2x} - 4x - 2 + 4x = 10e^{2x} - 2"},
            {"text": "The two sides agree for every x.", "latex": "\\frac{dy}{dx} = 2y + 4x"}
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99068",
               "skills": ["BC-SKL-07006"],
               "criterion": "Computes dy/dx = 10e^(2x) - 2 and shows 2y + 4x simplifies to the same expression.",
               "eligible_only_if": [],
               "check": null
            }
         ]
      },
      {
         "id": "b",
         "prompt": "For some constant \\( k \\), the function \\( y = ke^{2x} - 2x - 1 \\) is the solution to the differential equation with \\( y(0) = 3 \\). Find \\( k \\).",
         "setup_required": false,
         "answer_latex": "k = 4",
         "worked_solution": [
            {"text": "Use the initial condition.", "latex": "3 = k e^{0} - 0 - 1"},
            {"text": "Solve.", "latex": "k = 4"}
         ],
         "points": [
