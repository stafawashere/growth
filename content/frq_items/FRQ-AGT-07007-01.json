               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "4", "up_to_constant": false, "variable": "k"}
            }
         ]
      },
      {
         "id": "c",
         "prompt": "Find the solution to the differential equation whose graph is a line, \\( y = mx + b \\).",
         "setup_required": false,
         "answer_latex": "y = -2x - 1",
         "worked_solution": [
            {"text": "Substitute y = mx + b.", "latex": "m = 2(mx + b) + 4x = (2m + 4)x + 2b"},
            {"text": "Match coefficients.", "latex": "2m + 4 = 0, \\quad m = 2b \\Rightarrow m = -2, \\; b = -1"},
            {"text": "The linear solution.", "latex": "y = -2x - 1"}
         ],
         "points": [
