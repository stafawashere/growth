   "stem": {
      "text": "Let \\( f(x) = 6x - x^{2} \\) and \\( g(x) = x^{2} - 2x \\). Let \\( R \\) be the region bounded by the graphs of \\( f \\) and \\( g \\)."
   },
   "skills": [
      "BC-SKL-08018",
      "BC-SKL-08019",
      "BC-SKL-08020",
      "BC-SKL-08021",
      "BC-SKL-08022"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Find the area of \\( R \\). Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "\\frac{64}{3}",
         "worked_solution": [
            {
               "text": "The graphs meet where 6x - x^2 = x^2 - 2x.",
               "latex": "2x^{2} - 8x = 0 \\implies x = 0, \\ x = 4"
            },
            {
               "text": "On 0 < x < 4 the graph of f lies above the graph of g, for example f(1) = 5 > g(1) = -1.",
               "latex": "\\int_{0}^{4} \\left[(6x - x^{2}) - (x^{2} - 2x)\\right] dx = \\int_{0}^{4} (8x - 2x^{2})\\,dx"
            },
            {
               "text": "Antidifferentiate.",
               "latex": "\\left[4x^{2} - \\frac{2x^{3}}{3}\\right]_{0}^{4}"
            },
            {
               "text": "Evaluate.",
               "latex": "64 - \\frac{128}{3} = \\frac{64}{3}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99059",
               "skills": [
                  "BC-SKL-08018",
                  "BC-SKL-08019"
