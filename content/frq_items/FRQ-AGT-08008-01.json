      },
      {
         "id": "b",
         "prompt": "The vertical line \\( x = k \\) divides \\( R \\) into two regions of equal area. Write an equation involving an integral expression whose solution is \\( k \\), and find the value of \\( k \\).",
         "setup_required": false,
         "answer_latex": "k = 2",
         "worked_solution": [
            {
               "text": "The part of R to the left of x = k has half the area of R.",
               "latex": "\\int_{0}^{k} (8x - 2x^{2})\\,dx = \\frac{32}{3}"
            },
            {
               "text": "Antidifferentiate and evaluate.",
               "latex": "4k^{2} - \\frac{2k^{3}}{3} = \\frac{32}{3} \\iff k^{3} - 6k^{2} + 16 = 0"
            },
            {
               "text": "k = 2 is a root, and the other two roots, 2 plus or minus 2 sqrt(3), lie outside 0 < k < 4.",
               "latex": "(k - 2)(k^{2} - 4k - 8) = 0"
            },
            {
               "text": "State the value.",
               "latex": "k = 2"
            }
         ],
