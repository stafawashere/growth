      },
      {
         "id": "c",
         "prompt": "Find the area of the region that lies inside the outer loop of the curve and outside the inner loop.",
         "setup_required": false,
         "answer_latex": "\\pi + 3\\sqrt{3}",
         "worked_solution": [
            {
               "text": "The outer loop is traced while r is nonnegative, from theta = -pi/6 to theta = 7pi/6.",
               "latex": "\\frac{1}{2}\\int_{-\\pi/6}^{7\\pi/6} (1 + 2\\sin\\theta)^{2}\\,d\\theta = \\frac{1}{2}\\left(4\\pi + 3\\sqrt{3}\\right) = 2\\pi + \\frac{3\\sqrt{3}}{2}"
            },
            {
               "text": "Subtract the inner loop area from part (b).",
               "latex": "\\left(2\\pi + \\frac{3\\sqrt{3}}{2}\\right) - \\left(\\pi - \\frac{3\\sqrt{3}}{2}\\right) = \\pi + 3\\sqrt{3}"
            }
         ],
         "points": [
