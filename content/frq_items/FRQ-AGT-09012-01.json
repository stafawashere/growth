   "stem": {
      "text": "The polar curve \\( r = 1 + 2\\sin\\theta \\) for \\( 0 \\le \\theta \\le 2\\pi \\) is a limacon with an inner loop. The inner loop is traced for the angles at which \\( r \\le 0 \\)."
   },
   "skills": [
      "BC-SKL-09035",
      "BC-SKL-09036",
      "BC-SKL-09037",
      "BC-SKL-09038"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Find the area of the region in the first quadrant that lies inside the curve, bounded by the curve and the rays \\( \\theta = 0 \\) and \\( \\theta = \\tfrac{\\pi}{2} \\).",
         "setup_required": false,
         "answer_latex": "2 + \\frac{3\\pi}{4}",
         "worked_solution": [
            {
               "text": "Polar area is one half the integral of r squared.",
               "latex": "\\frac{1}{2}\\int_{0}^{\\pi/2} (1 + 2\\sin\\theta)^{2}\\,d\\theta"
            },
            {
               "text": "Expand and use the double angle identity for sine squared.",
               "latex": "(1 + 2\\sin\\theta)^{2} = 3 + 4\\sin\\theta - 2\\cos 2\\theta"
            },
            {
               "text": "Antidifferentiate and evaluate.",
               "latex": "\\frac{1}{2}\\left[3\\theta - 4\\cos\\theta - \\sin 2\\theta\\right]_{0}^{\\pi/2} = \\frac{1}{2}\\left(\\frac{3\\pi}{2} + 4\\right)"
            },
            {
               "text": "Simplify.",
               "latex": "2 + \\frac{3\\pi}{4}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99048",
               "skills": [
                  "BC-SKL-09035"
               ],
               "criterion": "Writes a definite integral whose integrand contains (1 + 2 sin theta)^2, the square of r, with or without the one half and the differential.",
               "eligible_only_if": [],
               "check": null
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99001",
               "skills": [
                  "BC-SKL-09035",
                  "BC-SKL-09036"
               ],
               "criterion": "Uses the limits 0 and pi/2 on one half the integral of (1 + 2 sin theta)^2.",
               "eligible_only_if": [
                  "a1"
               ],
               "check": {
                  "kind": "bounds_match",
                  "lower": "0",
                  "upper": "pi/2",
                  "integrand": null,
                  "variable": "theta"
               }
            },
            {
               "point_id": "a3",
               "point_type_id": "BC-PT-99005",
               "skills": [
                  "BC-SKL-09038"
               ],
               "criterion": "Gives the area 2 + 3pi/4, supported by the integral of part (a).",
               "eligible_only_if": [
                  "a2"
               ],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "answer",
                  "expected": "2 + 3*pi/4",
                  "up_to_constant": false,
                  "variable": "theta"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the two values of \\( \\theta \\) in \\( 0 \\le \\theta \\le 2\\pi \\) at which \\( r = 0 \\), and find the area of the region enclosed by the inner loop.",
         "setup_required": false,
         "answer_latex": "\\theta = \\frac{7\\pi}{6}, \\frac{11\\pi}{6}; \\quad \\pi - \\frac{3\\sqrt{3}}{2}",
         "worked_solution": [
            {
               "text": "Solve 1 + 2 sin theta = 0.",
               "latex": "\\sin\\theta = -\\frac{1}{2} \\implies \\theta = \\frac{7\\pi}{6}, \\ \\frac{11\\pi}{6}"
            },
            {
               "text": "r is negative between these angles, and that arc traces the inner loop once.",
               "latex": "\\frac{1}{2}\\int_{7\\pi/6}^{11\\pi/6} (1 + 2\\sin\\theta)^{2}\\,d\\theta"
            },
            {
               "text": "Evaluate with the same antiderivative as part (a).",
               "latex": "\\frac{1}{2}\\left[3\\theta - 4\\cos\\theta - \\sin 2\\theta\\right]_{7\\pi/6}^{11\\pi/6} = \\frac{1}{2}\\left(2\\pi - 4\\sqrt{3} + \\sqrt{3}\\right)"
            },
            {
               "text": "Simplify.",
               "latex": "\\pi - \\frac{3\\sqrt{3}}{2}"
            }
         ],
