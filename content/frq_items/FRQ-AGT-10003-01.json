               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "1", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "c",
         "prompt": "Write \\( f(x) \\) as a rational function of \\( x \\).",
         "setup_required": false,
         "answer_latex": "f(x) = \\frac{2}{3 - x}",
         "worked_solution": [
            {"text": "Geometric with first term 1 and ratio (x - 1)/2.", "latex": "f(x) = \\frac{1}{1 - \\frac{x - 1}{2}}"},
            {"text": "Simplify.", "latex": "f(x) = \\frac{2}{3 - x}"}
         ],
         "points": [
            {
               "point_id": "c1",
               "point_type_id": "BC-PT-99067",
