   "stem": {
      "text": "Let \\( f(x) = \\displaystyle\\sum_{n=0}^{\\infty} \\frac{(x - 1)^{n}}{2^{n}} \\) for \\( |x - 1| < 2 \\)."
   },
   "skills": ["BC-SKL-10006", "BC-SKL-10007", "BC-SKL-10008", "BC-SKL-10009", "BC-SKL-10010", "BC-SKL-10063", "BC-SKL-10072"],
   "parts": [
      {
         "id": "a",
         "prompt": "Find the sum of the series \\( \\displaystyle\\sum_{n=0}^{\\infty} 5\\left(-\\tfrac{2}{3}\\right)^{n} \\).",
         "setup_required": false,
         "answer_latex": "3",
         "worked_solution": [
            {"text": "Geometric with first term 5 and ratio -2/3, and |r| < 1.", "latex": "a = 5, \\quad r = -\\tfrac{2}{3}"},
            {"text": "Sum.", "latex": "\\frac{5}{1 + \\tfrac{2}{3}} = 3"}
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99067",
               "skills": ["BC-SKL-10006", "BC-SKL-10007", "BC-SKL-10008"],
               "criterion": "Uses 5 over 1 minus (-2/3) and gives 3.",
               "eligible_only_if": [],
               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "3", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Find the sum of the series \\( \\displaystyle\\sum_{n=1}^{\\infty} 3\\left(\\tfrac{1}{4}\\right)^{n} \\).",
         "setup_required": false,
         "answer_latex": "1",
         "worked_solution": [
            {"text": "The first term is the n = 1 term.", "latex": "a = \\frac{3}{4}, \\quad r = \\frac{1}{4}"},
            {"text": "Sum.", "latex": "\\frac{3/4}{1 - 1/4} = 1"}
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99067",
               "skills": ["BC-SKL-10008", "BC-SKL-10009"],
