               "check": {"kind": "sympy_equivalence", "target": "answer", "expected": "2/(3 - x)", "up_to_constant": false, "variable": "x"}
            }
         ]
      },
      {
         "id": "d",
         "prompt": "Find the value of \\( x \\) for which \\( f(x) = 4 \\).",
         "setup_required": false,
         "answer_latex": "x = \\frac{5}{2}",
         "worked_solution": [
            {"text": "Solve.", "latex": "\\frac{2}{3 - x} = 4 \\Rightarrow 3 - x = \\frac{1}{2} \\Rightarrow x = \\frac{5}{2}"},
            {"text": "5/2 satisfies |x - 1| < 2.", "latex": "\\left|\\tfrac{5}{2} - 1\\right| = \\tfrac{3}{2} < 2"}
