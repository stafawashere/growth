      },
      {
         "id": "b",
         "prompt": "Find the value of \\( f'''(0) \\).",
         "setup_required": false,
         "answer_latex": "f'''(0) = 2",
         "worked_solution": [
            {
               "text": "Differentiate f''(x) = f(x) + x f'(x).",
               "latex": "f'''(x) = 2f'(x) + x f''(x)"
            },
            {
               "text": "Evaluate at 0.",
               "latex": "f'''(0) = 2(1) + 0 = 2"
            }
