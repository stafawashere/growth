            }
         ]
      },
      {
         "id": "d",
         "prompt": "Show that \\( f^{(4)}(1) = 2 \\). Then find the coefficient of \\( (x - 1)^{4} \\) in the Taylor series for \\( f \\) about \\( x = 1 \\).",
         "setup_required": false,
         "answer_latex": "\\frac{1}{12}",
         "worked_solution": [
            {
               "text": "Differentiate f'''(x) = 2f'(x) + x f''(x).",
               "latex": "f^{(4)}(x) = 3f''(x) + x f'''(x)"
            },
            {
               "text": "Evaluate at x = 1 with the values from parts (a) and (b).",
               "latex": "f^{(4)}(1) = 3(1) + 1\\cdot(-1) = 2"
            },
            {
               "text": "Divide by 4!.",
               "latex": "\\frac{f^{(4)}(1)}{4!} = \\frac{2}{24} = \\frac{1}{12}"
            }
         ],
