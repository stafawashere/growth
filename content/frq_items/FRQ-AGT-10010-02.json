               ],
               "criterion": "Completes the polynomial with (x - 1)^2/2 - (x - 1)^3/6 and no terms of higher degree.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "2 - (x - 1) + (x - 1)**2/2 - (x - 1)**3/6",
                  "up_to_constant": false,
                  "variable": "x"
               },
               "follows_from": [
                  "a2",
