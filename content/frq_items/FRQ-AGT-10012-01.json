      {
         "id": "c",
         "prompt": "Write the third-degree Taylor polynomial for \\( g \\) about \\( x = 0 \\).",
         "setup_required": false,
         "answer_latex": "P_{3}(x) = x - 2x^{2} + 2x^{3}",
         "worked_solution": [
            {
               "text": "Multiply the series for f by x.",
