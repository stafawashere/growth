      {
         "id": "b",
         "prompt": "Find \\( g''(0) \\) and \\( g'''(0) \\). Show the work that leads to your answers.",
         "setup_required": false,
         "answer_latex": "g''(0) = -4, \\quad g'''(0) = 12",
         "worked_solution": [
            {
               "text": "Differentiate the product twice.",
               "latex": "g''(x) = -4e^{-2x} + 4xe^{-2x}"
            },
            {
               "text": "Evaluate at 0.",
               "latex": "g''(0) = -4"
            },
            {
               "text": "Differentiate once more.",
               "latex": "g'''(x) = 12e^{-2x} - 8xe^{-2x}"
            },
            {
               "text": "Evaluate at 0.",
               "latex": "g'''(0) = 12"
            }
         ],
