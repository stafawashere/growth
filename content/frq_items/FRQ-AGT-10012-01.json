   "parts": [
      {
         "id": "a",
         "prompt": "Write the first four nonzero terms of the Maclaurin series for \\( f \\). Then write the first three nonzero terms of the Maclaurin series for \\( f'(x) \\).",
         "setup_required": false,
         "answer_latex": "f: \\; 1 - 2x + 2x^{2} - \\frac{4}{3}x^{3}, \\qquad f': \\; -2 + 4x - 4x^{2}",
         "worked_solution": [
            {
               "text": "Substitute -2x for u in the series for e^u.",
               "latex": "e^{-2x} = 1 + (-2x) + \\frac{(-2x)^{2}}{2!} + \\frac{(-2x)^{3}}{3!} + \\cdots"
            },
            {
               "text": "Simplify the first four terms.",
               "latex": "f(x) \\approx 1 - 2x + 2x^{2} - \\frac{4}{3}x^{3}"
            },
            {
               "text": "Differentiate term by term.",
               "latex": "f'(x) \\approx -2 + 4x - 4x^{2}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99035",
               "skills": [
                  "BC-SKL-10046",
                  "BC-SKL-10061"
               ],
               "criterion": "Gives the first two terms 1 - 2x of the Maclaurin series for f, as a list or as the start of a polynomial or series.",
