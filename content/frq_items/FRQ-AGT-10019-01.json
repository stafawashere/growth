               ],
               "criterion": "Gives the four nonzero terms 2 + x + x^2/8 + x^3/48, with the constant term 2 fixed by F(0) = 2, as a sum or a list.",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "2 + x + x**2/8 + x**3/48",
                  "up_to_constant": false,
