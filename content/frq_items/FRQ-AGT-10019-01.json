   "stem": {
      "text": "The function \\( f \\) is defined by the power series \\[ f(x) = \\sum_{n=0}^{\\infty} \\frac{x^{n}}{4^{n}} \\] for \\( -4 < x < 4 \\). The function \\( F \\) satisfies \\( F'(x) = f(x) \\) for \\( -4 < x < 4 \\) and \\( F(0) = 2 \\)."
   },
   "skills": [
      "BC-SKL-10069"
   ],
   "parts": [
      {
         "id": "a",
         "prompt": "Write \\( f(x) \\) as a rational function of \\( x \\) for \\( -4 < x < 4 \\). Then find the value of \\( \\displaystyle\\sum_{n=0}^{\\infty} \\frac{(-3)^{n}}{4^{n}} \\).",
         "setup_required": false,
         "answer_latex": "f(x) = \\frac{4}{4 - x}, \\qquad \\sum_{n=0}^{\\infty} \\frac{(-3)^{n}}{4^{n}} = \\frac{4}{7}",
         "worked_solution": [
            {
               "text": "The series is geometric with first term 1 and ratio x/4.",
               "latex": "f(x) = \\frac{1}{1 - \\frac{x}{4}} = \\frac{4}{4 - x}"
            },
            {
               "text": "The numerical series is geometric with first term 1 and ratio -3/4.",
               "latex": "\\sum_{n=0}^{\\infty} \\left(-\\frac{3}{4}\\right)^{n} = \\frac{1}{1 + \\frac{3}{4}} = \\frac{4}{7}"
            }
         ],
         "points": [
            {
               "point_id": "a1",
               "point_type_id": "BC-PT-99067",
               "skills": [
                  "BC-SKL-10069"
               ],
               "criterion": "Writes f(x) as first term over one minus ratio, 1/(1 - x/4), or an equivalent form such as 4/(4 - x).",
               "eligible_only_if": [],
               "check": {
                  "kind": "sympy_equivalence",
                  "target": "any_line",
                  "expected": "4/(4 - x)",
                  "up_to_constant": false,
                  "each_side": true,
                  "variable": "x"
               }
            },
            {
               "point_id": "a2",
               "point_type_id": "BC-PT-99067",
               "skills": [
                  "BC-SKL-10069"
               ],
               "criterion": "Finds the sum 4/7 from first term 1 and ratio -3/4, or as f(-3) = 4/7.",
               "eligible_only_if": [],
               "check": null
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Write the first four nonzero terms and the general term of the Maclaurin series for \\( F(x) \\).",
         "setup_required": false,
         "answer_latex": "F(x) = 2 + x + \\frac{x^{2}}{8} + \\frac{x^{3}}{48} + \\cdots + \\frac{x^{n+1}}{(n + 1)4^{n}} + \\cdots",
         "worked_solution": [
            {
               "text": "Integrate the series for f term by term.",
               "latex": "\\int_{0}^{x} \\sum_{n=0}^{\\infty} \\frac{t^{n}}{4^{n}}\\,dt = \\sum_{n=0}^{\\infty} \\frac{x^{n+1}}{(n + 1)4^{n}}"
            },
            {
               "text": "Add the constant fixed by F(0) = 2.",
               "latex": "F(x) = 2 + \\sum_{n=0}^{\\infty} \\frac{x^{n+1}}{(n + 1)4^{n}}"
            },
            {
               "text": "The first four nonzero terms.",
               "latex": "F(x) \\approx 2 + x + \\frac{x^{2}}{8} + \\frac{x^{3}}{48}"
            }
         ],
         "points": [
            {
               "point_id": "b1",
               "point_type_id": "BC-PT-99003",
               "skills": [
                  "BC-SKL-10069"
               ],
               "criterion": "Antidifferentiates the terms of the series for f term by term, giving x + x^2/8 + x^3/48 or the corresponding terms of an antiderivative series, with or without a constant.",
               "eligible_only_if": [],
