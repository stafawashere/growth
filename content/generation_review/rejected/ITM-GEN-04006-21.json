            "Pi",
            -1
         ]
      ],
      "units": "inches per second"
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "With h the depth and r the radius of the water surface, \\( V = \\tfrac{1}{3}\\pi r^{2} h \\), and by similar triangles \\( r = \\tfrac{h}{2} \\), so \\( V = \\tfrac{1}{3}\\pi \\left(\\tfrac{h}{2}\\right)^{2} h = \\tfrac{\\pi}{12} h^{3} \\).",
         "rule_named": "relating equation with the radius eliminated"
      },
      {
         "step": 2,
         "text": "Differentiate with respect to time: \\( \\frac{dV}{dt} = \\frac{\\pi}{4} h^{2} \\frac{dh}{dt} \\).",
         "point_type_id": "BC-PT-99023",
         "rule_named": "chain rule"
      },
      {
         "step": 3,
         "text": "Substitute h = 7 and \\( \\frac{dV}{dt} = 8 \\): \\( \\frac{dh}{dt} = \\frac{32}{49 \\pi} \\).",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               32,
               49
            ],
            [
               "Power",
               "Pi",
               -1
            ]
         ],
         "point_type_id": "BC-PT-99004",
         "rule_named": "solve for the requested rate"
      }
   ],
