   "stem": {
      "text": "Water is poured at a constant rate of 8 cubic inches per second into a tank shaped like a cone with its vertex pointing down. The height of the tank is 2 times the radius of its circular top. At the instant when the water is 7 inches deep, find the rate at which the depth of the water is increasing. Give an exact answer with units.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
