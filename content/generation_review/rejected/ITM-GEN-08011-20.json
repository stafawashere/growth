{
   "id": "ITM-GEN-08011-20",
   "archetype_id": "BC-QA-08011",
   "variant_id": "BC-QV-08011-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - 2 x^{2} + 8 x - 9 \\) and \\( g(x) = - 2 x - 1 \\). The region R shown is bounded by the graphs of f and g. R is the base of a solid whose cross sections perpendicular to the x-axis are squares. Find the exact volume of the solid.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         162,
         5
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The side of each cross section is the vertical distance across R, \\( s = f(x) - g(x) = - 2 x^{2} + 10 x - 8 \\).",
         "rule_named": "distance between the boundary curves"
      },
      {
         "step": 2,
         "text": "Because a square with side s has area s^2, each cross section has area \\( s^{2} \\).",
         "rule_named": "area of the named shape"
      },
      {
         "step": 3,
         "text": "The volume is \\( \\int_{1}^{4} 1\\left(- 2 x^{2} + 10 x - 8\\right)^{2}\\,dx \\), which equals \\( \\frac{162}{5} \\).",
         "mathjson": [
            "Rational",
            162,
            5
         ],
         "point_type_id": "BC-PT-99001",
         "rule_named": "volume by cross sections"
      }
   ],
