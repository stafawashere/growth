   "stem": {
      "text": "Let \\( f(x) = 2 x^{2} - 1 \\). Let R be the region bounded by the graph of f, the line \\( y = -1 \\), and the vertical line \\( x = 4 \\). Find the exact volume of the solid generated when R is revolved about the line \\( y = -1 \\).",
      "command_verb": "find"
   },
   "answer_key": {
