   "answer_key": {
      "form": "statement",
      "label": "f is continuous on \\( [0, 6) \\cup (6, \\infty) \\)."
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The square root needs \\( x \\ge 0 \\), so \\( x \\ge 0 \\).",
         "rule_named": "domain of a square root"
      },
      {
         "step": 2,
         "text": "The denominator is 0 at \\( x = 6 \\), so that input is excluded.",
         "rule_named": "domain of a quotient"
      },
      {
         "step": 3,
         "text": "Quotients and roots are continuous on their domains, so f is continuous on \\( [0, 6) \\cup (6, \\infty) \\), continuous from the right at \\( x = 0 \\), and never at \\( x = 6 \\).",
         "rule_named": "continuity on the domain"
