   "worked_solution": [
      {
         "step": 1,
         "text": "From the row x = 3: \\( f(3) = -1 \\), \\( f'(3) = 2 \\), \\( g(3) = -5 \\) and \\( g'(3) = -2 \\).",
         "rule_named": "read the table"
