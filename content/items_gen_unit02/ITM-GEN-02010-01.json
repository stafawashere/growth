   "stem": {
      "text": "Let \\( h(x) = - \\cot{\\left(x \\right)} + 2 \\sec{\\left(x \\right)} \\). Find the exact value of \\( h'\\left(\\frac{\\pi}{4}\\right) \\).",
      "command_verb": "find"
