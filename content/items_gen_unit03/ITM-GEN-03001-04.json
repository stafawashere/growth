   "worked_solution": [
      {
         "step": 1,
         "text": "The composite has outer function F with \\( \\frac{d}{du} u^{2} = 2 u \\) and inner function \\( u = 7 - 2 x^{2} \\), whose derivative is \\( - 4 x \\).",
         "point_type_id": "BC-PT-99023",
