   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate both sides with respect to x, using the product rule on the mixed term and a factor \\( \\frac{dy}{dx} \\) on each term in y: \\( 2x + \\left(y + x\\frac{dy}{dx}\\right) - 6 y^{2}\\frac{dy}{dx} = 2 \\).",
         "rule_named": "implicit differentiation"
      },
      {
         "step": 2,
         "text": "Collect the terms with \\( \\frac{dy}{dx} \\) and divide: \\( \\frac{dy}{dx} = \\frac{- 2 x - y + 2}{x - 6 y^{2}} \\).",
         "rule_named": "solve for dy/dx"
      },
      {
         "step": 3,
         "text": "At \\( (-2, 2) \\), \\( \\frac{dy}{dx} = \\frac{-4}{26} = - \\frac{2}{13} \\).",
         "mathjson": [
            "Rational",
            -2,
            13
