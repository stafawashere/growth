   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate both sides with respect to x, using the product rule on the mixed term and a factor \\( \\frac{dy}{dx} \\) on each term in y: \\( 2x - 4\\left(y + x\\frac{dy}{dx}\\right) - 4 y\\frac{dy}{dx} = 4 \\).",
         "rule_named": "implicit differentiation"
      },
      {
         "step": 2,
         "text": "Collect the terms with \\( \\frac{dy}{dx} \\) and divide: \\( \\frac{dy}{dx} = \\frac{- 2 x + 4 y + 4}{- 4 x - 4 y} \\).",
         "rule_named": "solve for dy/dx"
      },
      {
         "step": 3,
         "text": "At \\( (3, -2) \\), \\( \\frac{dy}{dx} = \\frac{10}{4} = \\frac{5}{2} \\).",
