   "format": "mcq",
   "stem": {
      "text": "Let \\( y = f(x) \\) be the solution of the differential equation \\( \\frac{dy}{dx} = - x y + 4 x - 3 y \\) whose graph passes through the point \\( (0, 1) \\). Find the value of \\( \\frac{d^{2}y}{dx^{2}} \\) at this point.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 12
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate the equation with respect to x, using the product rule on the mixed term and the chain rule on each y: \\( \\frac{d^{2}y}{dx^{2}} = - y + \\left(- x - 3\\right)\\frac{dy}{dx} + 4 \\).",
         "point_type_id": "BC-PT-99022",
         "rule_named": "product rule and chain rule"
      },
      {
         "step": 2,
         "text": "At \\( (0, 1) \\), \\( \\frac{dy}{dx} = -3 \\).",
         "mathjson": -3,
         "rule_named": "first derivative at the point"
      },
      {
         "step": 3,
         "text": "So \\( \\frac{d^{2}y}{dx^{2}} = \\left(-1\\right) + \\left(-3\\right) \\cdot \\left(-3\\right) + 4 = 12 \\).",
         "mathjson": 12,
         "point_type_id": "BC-PT-99027",
         "rule_named": "substitute the point and the first derivative"
      }
   ],
