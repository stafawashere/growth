   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate the equation with respect to x, using the product rule on the mixed term and the chain rule on each y: \\( y'' = y + \\left(x + 4\\right)y' - 3 \\).",
         "point_type_id": "BC-PT-99022",
         "rule_named": "product rule and chain rule"
      },
      {
         "step": 2,
         "text": "At \\( (1, -3) \\), \\( y' = -18 \\).",
         "mathjson": -18,
         "rule_named": "first derivative at the point"
      },
      {
         "step": 3,
         "text": "So \\( y'' = \\left(-3\\right) + 5 \\cdot \\left(-18\\right) + \\left(-3\\right) = -96 \\).",
