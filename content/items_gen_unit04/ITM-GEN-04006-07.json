   "worked_solution": [
      {
         "step": 1,
         "text": "The volume is \\( V = \\tfrac{4}{3}\\pi r^{3} \\), with r the radius, both depending on time.",
         "rule_named": "relating equation"
      },
      {
         "step": 2,
         "text": "Differentiate with respect to time: \\( \\frac{dV}{dt} = 4\\pi r^{2} \\frac{dr}{dt} \\).",
