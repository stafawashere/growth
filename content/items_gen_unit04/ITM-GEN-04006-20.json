   "stem": {
      "text": "A ladder 15 meters long leans against a vertical wall. The bottom of the ladder slides away from the wall along level ground at a constant rate of 3 meters per second. At the instant when the bottom of the ladder is 9 meters from the wall, find the rate of change of the height of the top of the ladder. Give an exact answer with units.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
