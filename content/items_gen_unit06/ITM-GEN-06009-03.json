   "worked_solution": [
      {
         "step": 1,
         "text": "Let \\( u = s \\) and \\( dv = \\cos{\\left(4 s \\right)}\\,ds \\), so \\( du = ds \\) and \\( v = \\frac{\\sin{\\left(4 s \\right)}}{4} \\).",
         "point_type_id": "BC-PT-99056",
