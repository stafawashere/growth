   "stem": {
      "text": "Evaluate the improper integral \\( \\int_{1}^{2} \\frac{4 x}{\\left(x^{2} - 1\\right)^{2}}\\,dx \\), or show that it diverges.",
      "command_verb": "evaluate"
   },
   "answer_key": {
