   "stem": {
      "text": "Let \\( h(x) = \\int_{3}^{2 x^{3}} \\left(- t^{2}\\right)\\,dt \\). Find \\( h^{\\prime}(-1) \\).",
      "command_verb": "find"
   },
   "answer_key": {
