   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Split the interval at x = 3: \\( \\int_{3}^{7} f(x)\\,dx = -11 - 5 = -16 \\).",
         "point_type_id": "BC-PT-99005",
         "rule_named": "additivity over adjacent intervals"
      },
      {
         "step": 2,
         "text": "h jumps at x = 4, so split its integral there: \\( 4 \\cdot 1 - 4 \\cdot 3 = -8 \\).",
