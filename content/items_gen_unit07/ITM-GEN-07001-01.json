   "stem": {
      "text": "The slope field for the differential equation \\( \\frac{dy}{dx} = 6 - 2 y \\) is shown. Describe the solution curve through the point \\( (2, 1) \\) across the whole window of the slope field.",
      "command_verb": "describe"
   },
   "answer_key": {
      "form": "statement",
      "label": "The solution curve through \\( (2, 1) \\) rises across the whole window, flattening toward the line \\( y = 3 \\) from below as x increases, and never touches the line \\( y = 3 \\)."
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At \\( (2, 1) \\) the slope is \\( 4 \\), which is positive, and every segment below the line \\( y = 3 \\) has that sign, so the curve rises through the point.",
         "rule_named": "slope from the right side of the equation"
      },
      {
         "step": 2,
         "text": "The segments along \\( y = 3 \\) are horizontal, so that line is itself a solution and the curve cannot cross or reach it; the segments get flatter near it, so the curve bends toward it on one side and away on the other.",
         "rule_named": "equilibrium solution"
      },
      {
         "step": 3,
         "text": "Following the segments in both directions to the edges of the window, the curve rises, flattening toward the line \\( y = 3 \\) from below as x increases.",
         "point_type_id": "BC-PT-99065",
         "rule_named": "solution curve follows the field"
      }
   ],
