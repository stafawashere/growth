   "stem": {
      "text": "The slope field for the differential equation \\( \\frac{dy}{dx} = \\frac{y}{3} \\) is shown. Describe the solution curve through the point \\( (-1, 1) \\) across the whole window of the slope field.",
      "command_verb": "describe"
   },
   "answer_key": {
      "form": "statement",
      "label": "The solution curve through \\( (-1, 1) \\) rises across the whole window, flattening toward the line \\( y = 0 \\) from above as x decreases, and never touches the line \\( y = 0 \\)."
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At \\( (-1, 1) \\) the slope is \\( \\frac{1}{3} \\), which is positive, and every segment above the line \\( y = 0 \\) has that sign, so the curve rises through the point.",
         "rule_named": "slope from the right side of the equation"
      },
      {
         "step": 2,
         "text": "The segments along \\( y = 0 \\) are horizontal, so that line is itself a solution and the curve cannot cross or reach it; the segments get flatter near it, so the curve bends toward it on one side and away on the other.",
         "rule_named": "equilibrium solution"
      },
      {
         "step": 3,
         "text": "Following the segments in both directions to the edges of the window, the curve rises, flattening toward the line \\( y = 0 \\) from above as x decreases.",
         "point_type_id": "BC-PT-99065",
         "rule_named": "solution curve follows the field"
      }
   ],
