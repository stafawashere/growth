   "stem": {
      "text": "The slope field for the differential equation \\( \\frac{dy}{dt} = - \\frac{y}{2} - \\frac{1}{2} \\) is shown. Describe the solution curve through the point \\( (2, 0) \\) across the whole window of the slope field.",
      "command_verb": "describe"
   },
   "answer_key": {
      "form": "statement",
      "label": "The solution curve through \\( (2, 0) \\) falls across the whole window, flattening toward the line \\( y = -1 \\) from above as t increases, and never touches the line \\( y = -1 \\)."
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At \\( (2, 0) \\) the slope is \\( - \\frac{1}{2} \\), which is negative, and every segment above the line \\( y = -1 \\) has that sign, so the curve falls through the point.",
         "rule_named": "slope from the right side of the equation"
      },
      {
         "step": 2,
         "text": "The segments along \\( y = -1 \\) are horizontal, so that line is itself a solution and the curve cannot cross or reach it; the segments get flatter near it, so the curve bends toward it on one side and away on the other.",
         "rule_named": "equilibrium solution"
      },
      {
         "step": 3,
         "text": "Following the segments in both directions to the edges of the window, the curve falls, flattening toward the line \\( y = -1 \\) from above as t increases.",
         "point_type_id": "BC-PT-99065",
         "rule_named": "solution curve follows the field"
      }
   ],
