   },
   "answer_key": {
      "form": "statement",
      "label": "The solution curve through \\( (-1, -3) \\) falls across the whole window, flattening toward the line \\( y = -2 \\) from below as x decreases, and never touches the line \\( y = -2 \\)."
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At \\( (-1, -3) \\) the slope is \\( - \\frac{1}{2} \\), which is negative, and every segment below the line \\( y = -2 \\) has that sign, so the curve falls through the point.",
         "rule_named": "slope from the right side of the equation"
      },
      {
         "step": 2,
         "text": "The segments along \\( y = -2 \\) are horizontal, so that line is itself a solution and the curve cannot cross or reach it; the segments get flatter near it, so the curve bends toward it on one side and away on the other.",
         "rule_named": "equilibrium solution"
      },
      {
         "step": 3,
         "text": "Following the segments in both directions to the edges of the window, the curve falls, flattening toward the line \\( y = -2 \\) from below as x decreases.",
         "point_type_id": "BC-PT-99065",
         "rule_named": "solution curve follows the field"
      }
   ],
