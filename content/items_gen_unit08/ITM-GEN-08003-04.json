   "stem": {
      "text": "A particle moves along the x-axis with velocity \\( v(t) = 3 t^{2} - 15 t + 12 \\) for \\( t \\ge 0 \\). Find the exact total distance the particle travels over the time interval \\( 0 \\le t \\le \\frac{9}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         81,
         4
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{9}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = 3 \\left(t - 4\\right) \\left(t - 1\\right) \\), the velocity changes sign at \\( t = 1 \\) and \\( t = 4 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 1] \\), \\( \\int_{0}^{1} v(t)\\,dt = \\frac{11}{2} \\).",
         "mathjson": [
            "Rational",
            11,
            2
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [1, 4] \\), \\( \\int_{1}^{4} v(t)\\,dt = - \\frac{27}{2} \\).",
         "mathjson": [
            "Rational",
            -27,
            2
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [4, \\frac{9}{2}] \\), \\( \\int_{4}^{\\frac{9}{2}} v(t)\\,dt = \\frac{5}{4} \\).",
         "mathjson": [
            "Rational",
            5,
            4
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( \\frac{11}{2} + \\frac{27}{2} + \\frac{5}{4} = \\frac{81}{4} \\).",
         "mathjson": [
            "Rational",
            81,
            4
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
