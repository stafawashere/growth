   "stem": {
      "text": "A cart on a straight track moves along a line so that its velocity at time t seconds is \\( v(t) = - 4 t^{2} + 28 t - 40 \\) centimeters per second. Find the exact total distance, in centimeters, that it travels over the time interval \\( 0 \\le t \\le \\frac{11}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         163,
         3
      ],
      "units": "centimeters"
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{11}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = - 4 \\left(t - 5\\right) \\left(t - 2\\right) \\), the velocity changes sign at \\( t = 2 \\) and \\( t = 5 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 2] \\), \\( \\int_{0}^{2} v(t)\\,dt = - \\frac{104}{3} \\).",
         "mathjson": [
            "Rational",
            -104,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [2, 5] \\), \\( \\int_{2}^{5} v(t)\\,dt = 18 \\).",
         "mathjson": 18,
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [5, \\frac{11}{2}] \\), \\( \\int_{5}^{\\frac{11}{2}} v(t)\\,dt = - \\frac{5}{3} \\).",
         "mathjson": [
            "Rational",
            -5,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( \\frac{104}{3} + 18 + \\frac{5}{3} = \\frac{163}{3} \\).",
         "mathjson": [
            "Rational",
            163,
            3
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
