   "format": "mcq",
   "stem": {
      "text": "A particle moves along a line so that its velocity at time t seconds is \\( v(t) = - 4 t^{2} + 40 t - 84 \\) centimeters per second. Find the exact total distance, in centimeters, that it travels over the time interval \\( 0 \\le t \\le \\frac{17}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         1039,
         6
      ],
      "units": "centimeters"
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{17}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = - 4 \\left(t - 7\\right) \\left(t - 3\\right) \\), the velocity changes sign at \\( t = 3 \\) and \\( t = 7 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 3] \\), \\( \\int_{0}^{3} v(t)\\,dt = -108 \\).",
         "mathjson": -108,
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [3, 7] \\), \\( \\int_{3}^{7} v(t)\\,dt = \\frac{128}{3} \\).",
         "mathjson": [
            "Rational",
            128,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [7, \\frac{17}{2}] \\), \\( \\int_{7}^{\\frac{17}{2}} v(t)\\,dt = - \\frac{45}{2} \\).",
         "mathjson": [
            "Rational",
            -45,
            2
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( 108 + \\frac{128}{3} + \\frac{45}{2} = \\frac{1039}{6} \\).",
         "mathjson": [
            "Rational",
            1039,
            6
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
