   "format": "mcq",
   "stem": {
      "text": "A particle moves along the x-axis with velocity \\( v(t) = - 2 t^{2} + 24 t - 64 \\) for \\( t \\ge 0 \\). Find the exact total distance the particle travels over the time interval \\( 0 \\le t \\le 9 \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         398,
         3
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{9} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = - 2 \\left(t - 8\\right) \\left(t - 4\\right) \\), the velocity changes sign at \\( t = 4 \\) and \\( t = 8 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 4] \\), \\( \\int_{0}^{4} v(t)\\,dt = - \\frac{320}{3} \\).",
         "mathjson": [
            "Rational",
            -320,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [4, 8] \\), \\( \\int_{4}^{8} v(t)\\,dt = \\frac{64}{3} \\).",
         "mathjson": [
            "Rational",
            64,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [8, 9] \\), \\( \\int_{8}^{9} v(t)\\,dt = - \\frac{14}{3} \\).",
         "mathjson": [
            "Rational",
            -14,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( \\frac{320}{3} + \\frac{64}{3} + \\frac{14}{3} = \\frac{398}{3} \\).",
         "mathjson": [
            "Rational",
            398,
            3
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
