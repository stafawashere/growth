   "stem": {
      "text": "A bead on a wire moves along a line so that its velocity at time t seconds is \\( v(t) = - 3 t^{2} + 36 t - 96 \\) meters per second. Find the exact total distance, in meters, that it travels over the time interval \\( 0 \\le t \\le \\frac{17}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         1549,
         8
      ],
      "units": "meters"
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{17}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = - 3 \\left(t - 8\\right) \\left(t - 4\\right) \\), the velocity changes sign at \\( t = 4 \\) and \\( t = 8 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 4] \\), \\( \\int_{0}^{4} v(t)\\,dt = -160 \\).",
         "mathjson": -160,
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [4, 8] \\), \\( \\int_{4}^{8} v(t)\\,dt = 32 \\).",
         "mathjson": 32,
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [8, \\frac{17}{2}] \\), \\( \\int_{8}^{\\frac{17}{2}} v(t)\\,dt = - \\frac{13}{8} \\).",
         "mathjson": [
            "Rational",
            -13,
            8
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( 160 + 32 + \\frac{13}{8} = \\frac{1549}{8} \\).",
         "mathjson": [
            "Rational",
            1549,
            8
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
