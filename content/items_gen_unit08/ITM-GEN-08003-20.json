   "stem": {
      "text": "A particle moves along the x-axis with velocity \\( v(t) = - 4 t^{2} + 60 t - 200 \\) for \\( t \\ge 0 \\). Find the exact total distance the particle travels over the time interval \\( 0 \\le t \\le \\frac{21}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         1508,
         3
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{21}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = - 4 \\left(t - 10\\right) \\left(t - 5\\right) \\), the velocity changes sign at \\( t = 5 \\) and \\( t = 10 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 5] \\), \\( \\int_{0}^{5} v(t)\\,dt = - \\frac{1250}{3} \\).",
         "mathjson": [
            "Rational",
            -1250,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [5, 10] \\), \\( \\int_{5}^{10} v(t)\\,dt = \\frac{250}{3} \\).",
         "mathjson": [
            "Rational",
            250,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [10, \\frac{21}{2}] \\), \\( \\int_{10}^{\\frac{21}{2}} v(t)\\,dt = - \\frac{8}{3} \\).",
         "mathjson": [
            "Rational",
            -8,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( \\frac{1250}{3} + \\frac{250}{3} + \\frac{8}{3} = \\frac{1508}{3} \\).",
         "mathjson": [
            "Rational",
            1508,
            3
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
