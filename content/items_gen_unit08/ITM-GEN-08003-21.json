   "format": "mcq",
   "stem": {
      "text": "A particle moves along the x-axis with velocity \\( v(t) = t^{2} - 9 t + 14 \\) for \\( t \\ge 0 \\). Find the exact total distance the particle travels over the time interval \\( 0 \\le t \\le \\frac{17}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         161,
         4
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Total distance is \\( \\int_{0}^{\\frac{17}{2}} \\left|v(t)\\right|\\,dt \\). Since \\( v(t) = \\left(t - 7\\right) \\left(t - 2\\right) \\), the velocity changes sign at \\( t = 2 \\) and \\( t = 7 \\), so the interval is split there.",
         "rule_named": "total distance as the integral of speed"
      },
      {
         "step": 2,
         "text": "On \\( [0, 2] \\), \\( \\int_{0}^{2} v(t)\\,dt = \\frac{38}{3} \\).",
         "mathjson": [
            "Rational",
            38,
            3
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 3,
         "text": "On \\( [2, 7] \\), \\( \\int_{2}^{7} v(t)\\,dt = - \\frac{125}{6} \\).",
         "mathjson": [
            "Rational",
            -125,
            6
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 4,
         "text": "On \\( [7, \\frac{17}{2}] \\), \\( \\int_{7}^{\\frac{17}{2}} v(t)\\,dt = \\frac{27}{4} \\).",
         "mathjson": [
            "Rational",
            27,
            4
         ],
         "rule_named": "definite integral of a polynomial"
      },
      {
         "step": 5,
         "text": "Add the sizes of the three pieces: the total distance is \\( \\frac{38}{3} + \\frac{125}{6} + \\frac{27}{4} = \\frac{161}{4} \\).",
         "mathjson": [
            "Rational",
            161,
            4
         ],
         "rule_named": "sum of absolute changes"
      }
   ],
