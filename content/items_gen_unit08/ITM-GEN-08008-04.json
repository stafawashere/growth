{
   "id": "ITM-GEN-08008-04",
   "archetype_id": "BC-QA-08008",
   "variant_id": "BC-QV-08008-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - x^{2} + x - 2 \\) and \\( g(x) = - x - 2 \\). The shaded region R shown is bounded by the graphs of f and g. Find the exact area of R.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         4,
         3
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Setting \\( f(x) = g(x) \\) gives \\( - x^{2} + 2 x = 0 \\), so the curves meet at \\( x = 0 \\) and \\( x = 2 \\), and f is above g between them.",
         "point_type_id": "BC-PT-99059",
         "rule_named": "upper minus lower"
      },
      {
         "step": 2,
         "text": "The area is \\( \\int_{0}^{2} \\left(- x^{2} + 2 x\\right)\\,dx \\).",
         "point_type_id": "BC-PT-99001",
         "rule_named": "area between curves"
      },
      {
         "step": 3,
         "text": "An antiderivative of the integrand is \\( - \\frac{x^{3}}{3} + x^{2} \\).",
         "point_type_id": "BC-PT-99003",
         "rule_named": "power rule"
      },
      {
         "step": 4,
         "text": "Evaluating from \\( 0 \\) to \\( 2 \\), the area is \\( \\frac{4}{3} \\).",
         "mathjson": [
            "Rational",
            4,
            3
         ],
         "point_type_id": "BC-PT-99004",
         "rule_named": "Fundamental Theorem of Calculus"
      }
   ],
