   "stem": {
      "text": "Let \\( f(x) = - 3 x^{2} + 16 x - 20 \\) and \\( g(x) = x - 3 \\). Let R be the region bounded by the graphs of f and g and the vertical lines \\( x = 2 \\) and \\( x = 3 \\). Find the exact area of R.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
