   "worked_solution": [
      {
         "step": 1,
         "text": "Solve each equation for x: \\( x = y^{2} \\) from the graph of f, with \\( y \\ge 0 \\), and \\( x = 4 y + 5 \\) from the graph of g.",
         "rule_named": "rewrite each curve as a function of y"
