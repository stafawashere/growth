{
   "id": "ITM-GEN-08010-02",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = 3 x^{2} - 18 x + \\frac{93}{4} \\) and \\( g(x) = 3 \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = 0 \\) to \\( x = \\frac{11}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         65,
         2
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = 3 \\left(x - \\frac{9}{2}\\right) \\left(x - \\frac{3}{2}\\right) \\), so the graphs cross at \\( x = \\frac{3}{2} \\) and \\( x = \\frac{9}{2} \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{0}^{\\frac{3}{2}} \\left(f(x) - g(x)\\right)\\,dx = \\frac{27}{2} \\), \\( \\int_{\\frac{3}{2}}^{\\frac{9}{2}} \\left(g(x) - f(x)\\right)\\,dx = \\frac{27}{2} \\) and \\( \\int_{\\frac{9}{2}}^{\\frac{11}{2}} \\left(f(x) - g(x)\\right)\\,dx = \\frac{11}{2} \\).",
         "mathjson": [
            "Rational",
            27,
            2
         ],
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{65}{2} \\).",
         "mathjson": [
            "Rational",
            65,
            2
         ],
         "rule_named": "additivity of area"
      }
   ],
