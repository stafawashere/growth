{
   "id": "ITM-GEN-08010-03",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = 2 x^{2} - 6 x + \\frac{7}{2} \\) and \\( g(x) = 2 x \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = -1 \\) to \\( x = 4 \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         113,
         6
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = 2 \\left(x - \\frac{7}{2}\\right) \\left(x - \\frac{1}{2}\\right) \\), so the graphs cross at \\( x = \\frac{1}{2} \\) and \\( x = \\frac{7}{2} \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{-1}^{\\frac{1}{2}} \\left(f(x) - g(x)\\right)\\,dx = 9 \\), \\( \\int_{\\frac{1}{2}}^{\\frac{7}{2}} \\left(g(x) - f(x)\\right)\\,dx = 9 \\) and \\( \\int_{\\frac{7}{2}}^{4} \\left(f(x) - g(x)\\right)\\,dx = \\frac{5}{6} \\).",
         "mathjson": 9,
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{113}{6} \\).",
         "mathjson": [
            "Rational",
            113,
            6
         ],
         "rule_named": "additivity of area"
      }
   ],
   "options": [
