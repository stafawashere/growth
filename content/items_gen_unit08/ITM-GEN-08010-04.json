{
   "id": "ITM-GEN-08010-04",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = 3 x^{2} - 4 x + 3 \\) and \\( g(x) = 2 x + 3 \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = -1 \\) to \\( x = \\frac{5}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         71,
         8
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = 3 x \\left(x - 2\\right) \\), so the graphs cross at \\( x = 0 \\) and \\( x = 2 \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{-1}^{0} \\left(f(x) - g(x)\\right)\\,dx = 4 \\), \\( \\int_{0}^{2} \\left(g(x) - f(x)\\right)\\,dx = 4 \\) and \\( \\int_{2}^{\\frac{5}{2}} \\left(f(x) - g(x)\\right)\\,dx = \\frac{7}{8} \\).",
         "mathjson": 4,
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{71}{8} \\).",
         "mathjson": [
            "Rational",
            71,
            8
         ],
         "rule_named": "additivity of area"
      }
   ],
   "options": [
