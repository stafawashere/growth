{
   "id": "ITM-GEN-08010-05",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = x^{2} - 6 x + 4 \\) and \\( g(x) = -1 \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = -1 \\) to \\( x = 6 \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         71,
         3
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = \\left(x - 5\\right) \\left(x - 1\\right) \\), so the graphs cross at \\( x = 1 \\) and \\( x = 5 \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{-1}^{1} \\left(f(x) - g(x)\\right)\\,dx = \\frac{32}{3} \\), \\( \\int_{1}^{5} \\left(g(x) - f(x)\\right)\\,dx = \\frac{32}{3} \\) and \\( \\int_{5}^{6} \\left(f(x) - g(x)\\right)\\,dx = \\frac{7}{3} \\).",
         "mathjson": [
            "Rational",
            32,
            3
         ],
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{71}{3} \\).",
         "mathjson": [
            "Rational",
            71,
            3
         ],
         "rule_named": "additivity of area"
      }
   ],
   "options": [
