{
   "id": "ITM-GEN-08010-06",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = 2 x^{2} - 21 x + 43 \\) and \\( g(x) = 1 - x \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = 1 \\) to \\( x = 8 \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         142,
         3
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = 2 \\left(x - 7\\right) \\left(x - 3\\right) \\), so the graphs cross at \\( x = 3 \\) and \\( x = 7 \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{1}^{3} \\left(f(x) - g(x)\\right)\\,dx = \\frac{64}{3} \\), \\( \\int_{3}^{7} \\left(g(x) - f(x)\\right)\\,dx = \\frac{64}{3} \\) and \\( \\int_{7}^{8} \\left(f(x) - g(x)\\right)\\,dx = \\frac{14}{3} \\).",
         "mathjson": [
            "Rational",
            64,
            3
         ],
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{142}{3} \\).",
         "mathjson": [
            "Rational",
            142,
            3
         ],
         "rule_named": "additivity of area"
      }
   ],
