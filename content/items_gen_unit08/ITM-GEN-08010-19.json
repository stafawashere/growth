{
   "id": "ITM-GEN-08010-19",
   "archetype_id": "BC-QA-08010",
   "variant_id": "BC-QV-08010-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = x^{2} - 6 x + 14 \\) and \\( g(x) = 2 x - 1 \\). Find the exact total area of the shaded regions shown, which lie between the graphs of f and g from \\( x = 1 \\) to \\( x = \\frac{11}{2} \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         199,
         24
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "\\( f(x) - g(x) = \\left(x - 5\\right) \\left(x - 3\\right) \\), so the graphs cross at \\( x = 3 \\) and \\( x = 5 \\), both inside the interval. f is above g before the first crossing and after the second, and below g between them.",
         "rule_named": "intersections and order of the curves"
      },
      {
         "step": 2,
         "text": "The pieces are \\( \\int_{1}^{3} \\left(f(x) - g(x)\\right)\\,dx = \\frac{20}{3} \\), \\( \\int_{3}^{5} \\left(g(x) - f(x)\\right)\\,dx = \\frac{4}{3} \\) and \\( \\int_{5}^{\\frac{11}{2}} \\left(f(x) - g(x)\\right)\\,dx = \\frac{7}{24} \\).",
         "mathjson": [
            "Rational",
            4,
            3
         ],
         "rule_named": "area of each piece, upper minus lower"
      },
      {
         "step": 3,
         "text": "The total area is the sum of the pieces, \\( \\frac{199}{24} \\).",
         "mathjson": [
            "Rational",
            199,
            24
         ],
         "rule_named": "additivity of area"
      }
   ],
   "options": [
