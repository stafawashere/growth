{
   "id": "ITM-GEN-08011-02",
   "archetype_id": "BC-QA-08011",
   "variant_id": "BC-QV-08011-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - 2 x^{2} + 2 x + 2 \\) and \\( g(x) = -2 \\). The region R shown is bounded by the graphs of f and g. R is the base of a solid whose cross sections perpendicular to the x-axis are semicircles whose diameters lie in the base. Find the exact volume of the solid.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Multiply",
         [
            "Rational",
            81,
            20
         ],
         "Pi"
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The diameter of each cross section is the vertical distance across R, \\( s = f(x) - g(x) = - 2 x^{2} + 2 x + 4 \\).",
         "rule_named": "distance between the boundary curves"
      },
      {
         "step": 2,
         "text": "Because a semicircle with diameter s has radius s/2 and area (1/2) pi (s/2)^2, each cross section has area \\( \\frac{\\pi}{8}s^{2} \\).",
         "rule_named": "area of the named shape"
      },
      {
         "step": 3,
         "text": "The volume is \\( \\int_{-1}^{2} \\frac{\\pi}{8}\\left(- 2 x^{2} + 2 x + 4\\right)^{2}\\,dx \\), which equals \\( \\frac{81 \\pi}{20} \\).",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               81,
               20
            ],
            "Pi"
         ],
         "point_type_id": "BC-PT-99001",
         "rule_named": "volume by cross sections"
      }
   ],
