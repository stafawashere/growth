{
   "id": "ITM-GEN-08011-04",
   "archetype_id": "BC-QA-08011",
   "variant_id": "BC-QV-08011-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - 2 x^{2} + 3 x - 2 \\) and \\( g(x) = - x - 2 \\). The region R shown is bounded by the graphs of f and g. R is the base of a solid whose cross sections perpendicular to the x-axis are rectangles whose heights are 2 times their bases. Find the exact volume of the solid.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         128,
         15
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The base of each cross section is the vertical distance across R, \\( s = f(x) - g(x) = - 2 x^{2} + 4 x \\).",
         "rule_named": "distance between the boundary curves"
      },
      {
         "step": 2,
         "text": "Because a rectangle with base s and height 2s has area 2s^2, each cross section has area \\( 2s^{2} \\).",
         "rule_named": "area of the named shape"
      },
      {
         "step": 3,
         "text": "The volume is \\( \\int_{0}^{2} 2\\left(- 2 x^{2} + 4 x\\right)^{2}\\,dx \\), which equals \\( \\frac{128}{15} \\).",
         "mathjson": [
            "Rational",
            128,
            15
         ],
         "point_type_id": "BC-PT-99001",
         "rule_named": "volume by cross sections"
      }
   ],
