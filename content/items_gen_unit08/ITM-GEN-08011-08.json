{
   "id": "ITM-GEN-08011-08",
   "archetype_id": "BC-QA-08011",
   "variant_id": "BC-QV-08011-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - x^{2} + x + 1 \\) and \\( g(x) = 1 - 2 x \\). The region R shown is bounded by the graphs of f and g. R is the base of a solid whose cross sections perpendicular to the x-axis are equilateral triangles. Find the exact volume of the solid.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Multiply",
         [
            "Rational",
            81,
            40
         ],
         [
            "Sqrt",
            3
         ]
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The side of each cross section is the vertical distance across R, \\( s = f(x) - g(x) = - x^{2} + 3 x \\).",
         "rule_named": "distance between the boundary curves"
      },
      {
         "step": 2,
         "text": "Because an equilateral triangle with side s has area (sqrt(3)/4) s^2, each cross section has area \\( \\frac{\\sqrt{3}}{4}s^{2} \\).",
         "rule_named": "area of the named shape"
      },
      {
         "step": 3,
         "text": "The volume is \\( \\int_{0}^{3} \\frac{\\sqrt{3}}{4}\\left(- x^{2} + 3 x\\right)^{2}\\,dx \\), which equals \\( \\frac{81 \\sqrt{3}}{40} \\).",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               81,
               40
            ],
            [
               "Sqrt",
               3
            ]
         ],
         "point_type_id": "BC-PT-99001",
         "rule_named": "volume by cross sections"
      }
   ],
