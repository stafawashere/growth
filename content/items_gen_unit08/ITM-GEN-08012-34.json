   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = 2 x^{2} + 1 \\). The region R shown is bounded by the graph of f, the line \\( y = 1 \\), and the vertical line \\( x = 4 \\). Find the exact volume of the solid generated when R is revolved about the line \\( y = 1 \\).",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Multiply",
         [
            "Rational",
            4096,
            5
         ],
         "Pi"
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Each slice perpendicular to the x-axis is a disc whose radius is the distance from the curve to the axis, \\( r = f(x) - 1 = 2 x^{2} \\).",
         "point_type_id": "BC-PT-99058",
         "rule_named": "disc radius"
      },
      {
         "step": 2,
         "text": "The volume is \\( \\pi\\int_{0}^{4} \\left(2 x^{2}\\right)^{2}\\,dx \\).",
         "point_type_id": "BC-PT-99001",
         "rule_named": "disc method"
      },
      {
         "step": 3,
         "text": "Since \\( \\int_{0}^{4} 4 x^{4}\\,dx = \\frac{4096}{5} \\), the volume is \\( \\frac{4096 \\pi}{5} \\).",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               4096,
               5
            ],
            "Pi"
         ],
         "point_type_id": "BC-PT-99004",
