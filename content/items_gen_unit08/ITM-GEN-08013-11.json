{
   "id": "ITM-GEN-08013-11",
   "archetype_id": "BC-QA-08013",
   "variant_id": "BC-QV-08013-01",
   "format": "mcq",
   "stem": {
      "text": "Let \\( f(x) = - x^{2} + 5 x - 3 \\) and \\( g(x) = 1 \\). The region R shown is bounded by the graphs of f and g. Find the exact volume of the solid generated when R is revolved about the x-axis.",
      "command_verb": "find"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Multiply",
         [
            "Rational",
            171,
            10
         ],
         "Pi"
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The graphs meet where \\( f(x) - g(x) = - x^{2} + 5 x - 4 = 0 \\), at \\( x = 1 \\) and \\( x = 4 \\). The axis is the x-axis, below R, so the outer radius is \\( R = f(x) = - x^{2} + 5 x - 3 \\) and the inner radius is \\( r = g(x) = 1 \\).",
         "point_type_id": "BC-PT-99058",
         "rule_named": "washer radii"
      },
      {
         "step": 2,
         "text": "The volume is \\( \\pi\\int_{1}^{4} \\left(R^{2} - r^{2}\\right)\\,dx \\), and \\( \\int_{1}^{4} \\left(R^{2} - r^{2}\\right)\\,dx = \\frac{171}{10} \\), so the volume is \\( \\frac{171 \\pi}{10} \\).",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               171,
               10
            ],
            "Pi"
         ],
         "point_type_id": "BC-PT-99001",
         "rule_named": "washer method"
      }
   ],
