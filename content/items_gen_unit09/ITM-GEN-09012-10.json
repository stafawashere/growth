   "stem": {
      "text": "Find the exact area of the region bounded by the polar curve \\( r = \\cos{\\left(4 \\theta \\right)} + 3 \\) and the rays \\( \\theta = \\pi \\) and \\( \\theta = \\frac{3 \\pi}{2} \\).",
      "command_verb": "find"
