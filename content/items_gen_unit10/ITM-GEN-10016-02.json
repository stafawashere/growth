   "worked_solution": [
      {
         "step": 1,
         "text": "Start from the Maclaurin series for \\( e^{x} \\) and replace x by \\( 7x \\), raising the whole of \\( 7x \\) to each power.",
         "rule_named": "substitution into a known series"
