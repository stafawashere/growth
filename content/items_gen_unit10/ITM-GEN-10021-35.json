   "worked_solution": [
      {
         "step": 1,
         "text": "A series converges exactly when its sequence of partial sums approaches a finite limit, and that limit is its sum.",
         "rule_named": "convergence as the limit of the partial sums"
      },
      {
         "step": 2,
         "text": "Each term splits as \\( \\frac{9}{\\left(n + 5\\right) \\left(n + 6\\right)} = \\frac{9}{n + 5} - \\frac{9}{n + 6} \\), so in the nth partial sum every middle term cancels and \\( S_n = \\frac{3}{2} - \\frac{9}{n + 6} \\).",
         "rule_named": "partial sums of a telescoping series"
      },
      {
         "step": 3,
         "text": "As n increases, \\( \\frac{9}{n + 6} \\) approaches 0, so the sum is \\( \\frac{3}{2} \\).",
         "mathjson": [
            "Rational",
            3,
            2
         ],
         "rule_named": "limit of the partial sums"
      }
