   "stem": {
      "text": "The series \\( \\sum_{n=1}^{\\infty} \\frac{9}{\\left(n + 5\\right) \\left(n + 6\\right)} \\) converges. Find its sum.",
      "command_verb": "find"
   },
   "answer_key": {
