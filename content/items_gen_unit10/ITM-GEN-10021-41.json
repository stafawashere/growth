   "stem": {
      "text": "The series \\( \\sum_{n=1}^{\\infty} \\frac{3}{\\left(n + 4\\right) \\left(n + 5\\right)} \\) converges. Find its sum.",
      "command_verb": "find"
   },
   "answer_key": {
