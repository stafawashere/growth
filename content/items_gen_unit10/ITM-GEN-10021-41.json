   "worked_solution": [
      {
         "step": 1,
         "text": "A series converges exactly when its sequence of partial sums approaches a finite limit, and that limit is its sum.",
         "rule_named": "convergence as the limit of the partial sums"
      },
      {
         "step": 2,
         "text": "Each term splits as \\( \\frac{3}{\\left(n + 4\\right) \\left(n + 5\\right)} = \\frac{3}{n + 4} - \\frac{3}{n + 5} \\), so in the nth partial sum every middle term cancels and \\( S_n = \\frac{3}{5} - \\frac{3}{n + 5} \\).",
         "rule_named": "partial sums of a telescoping series"
      },
      {
         "step": 3,
         "text": "As n increases, \\( \\frac{3}{n + 5} \\) approaches 0, so the sum is \\( \\frac{3}{5} \\).",
         "mathjson": [
            "Rational",
            3,
            5
         ],
         "rule_named": "limit of the partial sums"
      }
