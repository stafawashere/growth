   "stem": {
      "text": "Evaluate \\( \\lim_{x \\to 3} \\dfrac{x^2 - x - 6}{x^2 - 9} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
