                        12
                     ]
                  ]
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x not equal to 4 the factor x - 4 divides out, leaving (x + 3)/(x + sqrt(x + 12)).",
         "mathjson": [
