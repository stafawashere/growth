                        4
                     ]
                  ],
                  3
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x not equal to 5 the factor x - 5 divides out, leaving 1/(sqrt(x + 4) + 3).",
         "mathjson": [
