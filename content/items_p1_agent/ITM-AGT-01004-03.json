   "format": "mcq",
   "stem": {
      "text": "What is \\( \\lim_{x \\to 0} \\dfrac{\\sin^2 x}{1 - \\cos x} \\)?"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 2
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = 0 the numerator is sin^2(0) = 0 and the denominator is 1 - cos(0) = 0, so the quotient is zero over zero.",
         "mathjson": 0
      },
      {
         "step": 2,
         "text": "Use the Pythagorean identity sin^2 x = 1 - cos^2 x = (1 - cos x)(1 + cos x).",
         "mathjson": [
            "Multiply",
            [
               "Subtract",
               1,
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Add",
               1,
               [
                  "Cos",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x near 0 with cos x not equal to 1, the factor 1 - cos x divides out, leaving 1 + cos x.",
         "mathjson": [
            "Add",
            1,
            [
               "Cos",
               "x"
            ]
         ]
      },
      {
         "step": 4,
         "text": "The simplified expression is continuous at 0, so the limit is 1 + cos(0) = 2.",
         "mathjson": 2
      }
   ],
