               ]
            ],
            [
               "Multiply",
               [
                  "Subtract",
                  "x",
                  2
               ],
               [
                  "Add",
                  "x",
                  1
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x not equal to 2 the common factor x - 2 divides out, leaving (x - 5)/(x + 1).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               "x",
               5
            ],
            [
               "Add",
               "x",
               1
            ]
         ]
      },
      {
         "step": 4,
         "text": "The simplified quotient is continuous at 2, so the limit is (2 - 5)/(2 + 1) = -3/3 = -1.",
         "mathjson": -1
      }
