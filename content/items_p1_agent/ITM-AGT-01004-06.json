   "stem": {
      "text": "Evaluate \\( \\lim_{x \\to -4} \\dfrac{x^2 - 16}{x + 4} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": -8
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = -4 the numerator is 16 - 16 = 0 and the denominator is -4 + 4 = 0, so the quotient is zero over zero.",
         "mathjson": 0
      },
      {
         "step": 2,
         "text": "Factor the difference of squares: x^2 - 16 = (x - 4)(x + 4). For x not equal to -4 the factor x + 4 divides out, leaving x - 4.",
         "mathjson": [
            "Subtract",
            "x",
            4
         ]
      },
      {
         "step": 3,
         "text": "The limit is -4 - 4 = -8.",
         "mathjson": -8
      }
