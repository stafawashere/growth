   "stem": {
      "text": "Find \\( \\lim_{x \\to 2} \\dfrac{x - \\frac{6}{x + 1}}{x - 2} \\). Give an exact value."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
