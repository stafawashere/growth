      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = 2 the numerator is 2 - 6/3 = 0 and the denominator is 0, so the form is zero over zero.",
         "mathjson": 0
      },
      {
         "step": 2,
         "text": "Combine the numerator over the common denominator x + 1: x - 6/(x + 1) = (x^2 + x - 6)/(x + 1) = (x - 2)(x + 3)/(x + 1), so the quotient is (x - 2)(x + 3)/((x + 1)(x - 2)).",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               [
                  "Subtract",
                  "x",
                  2
               ],
               [
                  "Add",
                  "x",
                  3
               ]
            ],
            [
               "Multiply",
               [
                  "Add",
                  "x",
                  1
               ],
               [
                  "Subtract",
                  "x",
                  2
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x not equal to 2 the factor x - 2 divides out, leaving (x + 3)/(x + 1).",
         "mathjson": [
            "Divide",
            [
               "Add",
               "x",
               3
            ],
            [
               "Add",
               "x",
               1
            ]
         ]
      },
      {
         "step": 4,
         "text": "At x = 2 this is (2 + 3)/(2 + 1) = 5/3.",
         "mathjson": [
            "Rational",
