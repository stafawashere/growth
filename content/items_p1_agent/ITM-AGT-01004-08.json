      "mathjson": 3
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = 2 the numerator is 8 - 12 + 4 = 0 and the denominator is 4 - 8 + 4 = 0, so the quotient is zero over zero.",
         "mathjson": 0
      },
      {
         "step": 2,
         "text": "Dividing the numerator by x - 2 gives x^2 - x - 2 = (x - 2)(x + 1), so x^3 - 3x^2 + 4 = (x - 2)^2 (x + 1). The denominator is (x - 2)^2.",
         "mathjson": [
            "Multiply",
            [
               "Power",
               [
                  "Subtract",
                  "x",
                  2
               ],
               2
            ],
            [
               "Add",
               "x",
               1
            ]
         ]
      },
      {
         "step": 3,
         "text": "The repeated factor (x - 2)^2 divides out for x not equal to 2, leaving x + 1.",
         "mathjson": [
            "Add",
            "x",
            1
         ]
      },
      {
         "step": 4,
         "text": "The limit is 2 + 1 = 3.",
         "mathjson": 3
      }
