                  3
               ],
               [
                  "Subtract",
                  "x",
                  1
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x not equal to 1 the factor x - 1 divides out, leaving (x - 2)/(x - 3).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               "x",
               2
            ],
            [
               "Subtract",
               "x",
               3
            ]
         ]
      },
      {
         "step": 4,
         "text": "At x = 1 this is (1 - 2)/(1 - 3) = 1/2.",
         "mathjson": [
