   "stem": {
      "text": "Evaluate \\( \\lim_{x \\to \\pi/2} \\dfrac{\\sin^2 x - 3\\sin x + 2}{\\sin^2 x + 2\\sin x - 3} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         -1,
         4
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = pi/2, sin x = 1, so the numerator is 1 - 3 + 2 = 0 and the denominator is 1 + 2 - 3 = 0, and the quotient is zero over zero.",
         "mathjson": 0
      },
      {
         "step": 2,
         "text": "Treat sin x as the variable and factor: sin^2 x - 3 sin x + 2 = (sin x - 1)(sin x - 2) and sin^2 x + 2 sin x - 3 = (sin x - 1)(sin x + 3).",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               [
                  "Subtract",
                  [
                     "Sin",
                     "x"
                  ],
                  1
               ],
               [
                  "Subtract",
                  [
                     "Sin",
                     "x"
                  ],
                  2
               ]
            ],
            [
               "Multiply",
               [
                  "Subtract",
                  [
                     "Sin",
                     "x"
                  ],
                  1
               ],
               [
                  "Add",
                  [
                     "Sin",
                     "x"
                  ],
                  3
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "For x near pi/2 with x not equal to pi/2, sin x is not 1, so the factor sin x - 1 divides out, leaving (sin x - 2)/(sin x + 3).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Sin",
                  "x"
               ],
               2
            ],
            [
               "Add",
               [
                  "Sin",
                  "x"
               ],
               3
            ]
         ]
      },
      {
         "step": 4,
         "text": "The simplified expression is continuous at pi/2, so the limit is (1 - 2)/(1 + 3) = -1/4.",
         "mathjson": [
            "Rational",
            -1,
            4
         ]
      }
   ],
