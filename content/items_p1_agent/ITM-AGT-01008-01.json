   "stem": {
      "text": "The function h is defined by h(x) = 4 - 3x for x < -2 and h(x) = kx + 16 for x >= -2, where k is a constant. Find the value of k that makes h continuous at x = -2."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 3
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The left-hand limit at x = -2 comes from 4 - 3x and equals 10.",
         "mathjson": 10
      },
      {
         "step": 2,
         "text": "The right-hand limit and h(-2) come from kx + 16 and equal -2k + 16.",
         "mathjson": [
            "Add",
            [
               "Multiply",
               -2,
               "k"
            ],
            16
         ]
      },
      {
         "step": 3,
         "text": "Setting 10 = -2k + 16 gives 2k = 6.",
         "mathjson": [
            "Equal",
            [
               "Multiply",
               2,
               "k"
            ],
            6
         ]
      },
      {
         "step": 4,
         "text": "So k = 3.",
         "mathjson": 3
      }
   ],
