   "stem": {
      "text": "The function m is defined by m(x) = (x^2 - 16)/(x - 4) for x != 4 and m(4) = 2k + 2, where k is a constant. Find the value of k for which m is continuous at x = 4."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 3
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "For x != 4, (x^2 - 16)/(x - 4) = x + 4, so the limit of m(x) as x approaches 4 is 8.",
         "mathjson": 8
      },
      {
         "step": 2,
         "text": "Continuity at x = 4 needs m(4) to equal that limit, so 2k + 2 = 8.",
         "mathjson": [
            "Equal",
            [
               "Add",
               [
                  "Multiply",
                  2,
                  "k"
               ],
               2
            ],
            8
         ]
      },
      {
         "step": 3,
         "text": "Then 2k = 6.",
         "mathjson": [
            "Equal",
            [
               "Multiply",
               2,
               "k"
            ],
            6
         ]
      },
      {
         "step": 4,
         "text": "So k = 3.",
         "mathjson": 3
      }
   ],
