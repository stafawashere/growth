   "format": "short_answer",
   "stem": {
      "text": "Let v be defined by v(x) = a(3^x) + b for x < 0, v(x) = 3x + 5 for 0 <= x <= 1, and v(x) = 2bx + a for x > 1, where a and b are constants. Find the value of a for which v is continuous for all real x."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 2
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "At x = 0 the left branch tends to a(3^0) + b = a + b and the middle branch gives 5, so a + b = 5.",
         "mathjson": [
            "Equal",
            [
               "Add",
               "a",
               "b"
            ],
            5
         ]
      },
      {
         "step": 2,
         "text": "At x = 1 the middle branch gives 8 and the right branch gives 2b + a, so a + 2b = 8.",
         "mathjson": [
            "Equal",
            [
               "Add",
               "a",
               [
                  "Multiply",
                  2,
                  "b"
               ]
            ],
            8
         ]
      },
      {
         "step": 3,
         "text": "Subtracting the first equation from the second gives b = 3.",
         "mathjson": [
            "Equal",
            "b",
            3
         ]
      },
      {
         "step": 4,
         "text": "Then a = 5 - 3 = 2.",
         "mathjson": 2
      }
   ],
