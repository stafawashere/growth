   "stem": {
      "text": "Let q(x) = (x^2 - 4) / (x^3 - 4x). On how many separate maximal intervals is q continuous?"
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": 4
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Factor the denominator as x(x - 2)(x + 2), which is zero at x = -2, x = 0 and x = 2.",
         "mathjson": [
            "Multiply",
            "x",
            [
               "Subtract",
               "x",
               2
            ],
            [
               "Add",
               "x",
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "q is rational, so it is continuous on its domain. Cancelling x^2 - 4 gives 1/x only where x is not -2 or 2, so those inputs stay excluded.",
         "mathjson": [
            "Divide",
            1,
            "x"
         ]
      },
      {
         "step": 3,
         "text": "q is continuous on (-infinity, -2), (-2, 0), (0, 2) and (2, infinity).",
         "mathjson": 2
      },
      {
         "step": 4,
         "text": "Those are four separate maximal intervals.",
         "mathjson": 4
      }
