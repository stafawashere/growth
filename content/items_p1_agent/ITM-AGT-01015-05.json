   "stem": {
      "text": "Let q(x) = (x^2 - 1) / ((x^2 + 5x + 4)(x - 3)). Consider the largest interval that contains x = 0 and on which q is continuous. What is the sum of the integers in that interval?"
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": 3
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The denominator (x + 1)(x + 4)(x - 3) is zero at x = -4, -1 and 3. Cancelling the common factor x + 1 does not change the domain of q, so x = -1 stays excluded.",
         "mathjson": [
            "Multiply",
            [
               "Add",
               "x",
               1
            ],
            [
               "Add",
               "x",
               4
            ],
            [
               "Subtract",
               "x",
               3
            ]
         ]
      },
      {
         "step": 2,
         "text": "q is a rational function, continuous at every input of its domain, so q is continuous on (-infinity, -4) U (-4, -1) U (-1, 3) U (3, infinity).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Power",
                  "x",
                  2
               ],
               1
            ],
            [
               "Multiply",
               [
                  "Add",
                  "x",
                  1
               ],
               [
                  "Add",
                  "x",
                  4
               ],
               [
                  "Subtract",
                  "x",
                  3
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "The piece that contains x = 0 is (-1, 3), open at both ends. Its integers are 0, 1 and 2.",
         "mathjson": [
            "Add",
            0,
            1,
            2
         ]
      },
      {
         "step": 4,
         "text": "The sum of those integers is 3.",
         "mathjson": 3
      }
   ],
