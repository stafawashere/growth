   },
   "worked_solution": [
      {
         "step": 1,
         "text": "For x < 1 the rule needs x >= -8 and x not equal to -4, and for x >= 1 it needs x <= 17 and x not equal to 5, so f is undefined at -4 and 5 and outside [-8, 17].",
         "mathjson": [
            "Multiply",
            [
               "Add",
               "x",
               4
            ],
