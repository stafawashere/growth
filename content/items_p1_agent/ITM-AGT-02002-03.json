                  ]
               ],
               3
            ],
            "h"
         ]
      },
      {
         "step": 2,
         "text": "Multiply numerator and denominator by the conjugate sqrt(9 + h) + 3; the numerator becomes (9 + h) - 9 = h.",
         "mathjson": [
            "Divide",
            "h",
            [
               "Multiply",
               "h",
               [
                  "Add",
                  [
                     "Sqrt",
                     [
                        "Add",
                        9,
                        "h"
                     ]
                  ],
                  3
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Divide out h, leaving 1/(sqrt(9 + h) + 3) for h not equal to 0.",
         "mathjson": [
            "Divide",
            1,
            [
               "Add",
               [
                  "Sqrt",
                  [
                     "Add",
                     9,
                     "h"
                  ]
               ],
               3
            ]
         ]
      },
      {
         "step": 4,
         "text": "Let h approach 0: 1/(3 + 3), so f'(6) = 1/6.",
         "mathjson": [
            "Rational",
            1,
            6
         ]
      }
