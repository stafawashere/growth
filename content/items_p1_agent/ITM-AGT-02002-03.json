   "worked_solution": [
      {
         "step": 1,
         "text": "Write the difference quotient at 6: [sqrt(9 + h) - 3]/h, since f(6) = sqrt(9) = 3.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Sqrt",
