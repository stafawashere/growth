               "Power",
               "x",
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "The derivative of cos(x) is -sin(x), so -4cos(x) differentiates to (-4)(-sin(x)) = 4sin(x).",
         "mathjson": [
            "Multiply",
            4,
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 3,
         "text": "The derivative of e^x is e^x.",
         "mathjson": [
            "Exp",
            "x"
         ]
      },
