   "worked_solution": [
      {
         "step": 1,
         "text": "The derivative of cos(x) is -sin(x), so 2cos(x) differentiates to -2sin(x).",
         "mathjson": [
            "Multiply",
            -2,
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The derivative of ln(x) is 1/x for x > 0, so 7ln(x) differentiates to 7/x.",
         "mathjson": [
            "Divide",
            7,
            "x"
         ]
      },
      {
         "step": 3,
         "text": "The derivative of e^x is e^x, so -e^x differentiates to -e^x.",
         "mathjson": [
            "Negate",
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 4,
         "text": "Combine the three terms.",
