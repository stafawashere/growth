   "worked_solution": [
      {
         "step": 1,
         "text": "The derivative of sin(x) is cos(x), so 2sin(x) differentiates to 2cos(x).",
         "mathjson": [
            "Multiply",
            2,
            [
               "Cos",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The derivative of ln(x) is 1/x for x > 0, so 7ln(x) differentiates to 7/x.",
         "mathjson": [
            "Divide",
            7,
            "x"
         ]
      },
      {
         "step": 3,
         "text": "The derivative of e^x is e^x, so -e^x differentiates to -e^x.",
         "mathjson": [
            "Negate",
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 4,
         "text": "Combine the three terms.",
