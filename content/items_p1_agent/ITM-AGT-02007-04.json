   "format": "short_answer",
   "stem": {
      "text": "Let k(x) = 2ln(x) + 3cos(x) + e^x for x > 0. Find the exact value of k'(pi/6)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Add",
         [
            "Subtract",
            [
               "Divide",
               12,
