               6
            ]
         ]
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The derivative of ln(x) is 1/x, so 2ln(x) differentiates to 2/x.",
         "mathjson": [
            "Divide",
            2,
            "x"
         ]
      },
      {
         "step": 2,
         "text": "The derivative of cos(x) is -sin(x), so 3cos(x) differentiates to -3sin(x).",
         "mathjson": [
            "Multiply",
            -3,
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 3,
         "text": "The natural exponential is its own derivative, so e^x differentiates to e^x.",
         "mathjson": [
            "Exp",
            "x"
         ]
      },
      {
         "step": 4,
         "text": "Combine the terms: k'(x) = 2/x - 3sin(x) + e^x.",
         "mathjson": [
            "Add",
            [
               "Subtract",
               [
                  "Divide",
                  2,
                  "x"
               ],
               [
                  "Multiply",
                  3,
                  [
                     "Sin",
                     "x"
                  ]
               ]
            ],
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 5,
         "text": "Evaluate at x = pi/6. Here 2/(pi/6) = 12/pi and sin(pi/6) = 1/2, so k'(pi/6) = 12/pi - 3/2 + e^(pi/6).",
         "mathjson": [
            "Add",
            [
               "Subtract",
               [
                  "Divide",
                  12,
                  "Pi"
               ],
               [
                  "Rational",
                  3,
                  2
               ]
            ],
            [
