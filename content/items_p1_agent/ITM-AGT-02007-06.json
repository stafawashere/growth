   "worked_solution": [
      {
         "step": 1,
         "text": "The derivative of e^t is e^t, so 5e^t differentiates to 5e^t.",
         "mathjson": [
            "Multiply",
            5,
            [
               "Exp",
               "t"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The derivative of cos(t) is -sin(t), so -3cos(t) differentiates to 3sin(t).",
         "mathjson": [
            "Multiply",
            3,
            [
               "Sin",
               "t"
            ]
         ]
      },
      {
         "step": 3,
         "text": "By the power rule, t^4 differentiates to 4t^3.",
         "mathjson": [
            "Multiply",
            4,
            [
               "Power",
               "t",
               3
            ]
         ]
      },
      {
         "step": 4,
         "text": "Combine the three terms.",
