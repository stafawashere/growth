   "worked_solution": [
      {
         "step": 1,
         "text": "The derivative of cos(x) is -sin(x), so 6cos(x) differentiates to -6sin(x).",
         "mathjson": [
            "Multiply",
            -6,
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The derivative of e^x is e^x, so -e^x differentiates to -e^x.",
         "mathjson": [
            "Negate",
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 3,
         "text": "Combine the terms: r'(x) = -6sin(x) - e^x.",
         "mathjson": [
            "Subtract",
            [
               "Multiply",
               -6,
               [
                  "Sin",
                  "x"
               ]
            ],
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 4,
         "text": "Evaluate at x = pi/6, where sin(pi/6) = 1/2: r'(pi/6) = -3 - e^(pi/6).",
         "mathjson": [
            "Subtract",
            -3,
