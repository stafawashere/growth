{
   "id": "ITM-AGT-02008-01",
   "archetype_id": "BC-QA-02008",
   "variant_id": null,
   "format": "short_answer",
   "stem": {
      "text": "Let g(x) = (x^2 cos(x))/(x + 1) for x > -1. Find the exact value of g'(pi)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Negate",
         [
            "Divide",
            [
               "Multiply",
               "Pi",
               [
                  "Add",
                  2,
                  "Pi"
               ]
            ],
            [
               "Power",
               [
                  "Add",
                  1,
                  "Pi"
               ],
               2
            ]
         ]
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The numerator N = x^2 cos(x) is a product, so N' = 2x cos(x) - x^2 sin(x), and the denominator D = x + 1 has D' = 1.",
         "mathjson": [
            "Add",
            [
               "Negate",
               [
                  "Multiply",
                  [
                     "Power",
                     "x",
                     2
                  ],
                  [
                     "Sin",
                     "x"
                  ]
               ]
            ],
            [
               "Multiply",
               2,
               "x",
               [
                  "Cos",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "At x = pi, cos(pi) = -1 and sin(pi) = 0, so N = -pi^2, N' = -2 pi, D = pi + 1 and D' = 1.",
         "mathjson": [
            "Negate",
            [
               "Multiply",
               2,
               "Pi"
            ]
         ]
      },
      {
         "step": 3,
         "text": "The quotient rule gives g'(pi) = (D N' - N D')/D^2 = ((pi + 1)(-2 pi) - (-pi^2)(1))/(pi + 1)^2.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Negate",
                  [
                     "Multiply",
                     2,
                     "Pi",
                     [
                        "Add",
                        1,
                        "Pi"
                     ]
                  ]
               ],
               [
                  "Power",
                  "Pi",
                  2
               ]
            ],
            [
               "Power",
               [
                  "Add",
                  1,
                  "Pi"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "The numerator is -2 pi^2 - 2 pi + pi^2 = -pi^2 - 2 pi, so g'(pi) = -pi (pi + 2)/(pi + 1)^2.",
         "mathjson": [
            "Negate",
            [
               "Divide",
               [
                  "Multiply",
                  "Pi",
                  [
                     "Add",
                     2,
                     "Pi"
                  ]
               ],
               [
                  "Power",
                  [
                     "Add",
                     1,
                     "Pi"
                  ],
                  2
               ]
            ]
         ]
      }
   ],
