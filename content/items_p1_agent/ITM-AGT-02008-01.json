   "stem": {
      "text": "Let g(x) = x^2 cos(x). Find the exact value of g'(pi)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Multiply",
         -2,
         "Pi"
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Take u = x^2 and v = cos(x), so u' = 2x and v' = -sin(x).",
         "mathjson": [
            "Multiply",
            2,
            "x"
         ]
      },
      {
         "step": 2,
         "text": "The product rule gives g'(x) = 2x cos(x) - x^2 sin(x).",
         "mathjson": [
            "Subtract",
            [
               "Multiply",
               2,
               "x",
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Multiply",
               [
                  "Power",
                  "x",
                  2
               ],
               [
                  "Sin",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "At x = pi, cos(pi) = -1 and sin(pi) = 0, so g'(pi) = 2 pi (-1) - pi^2 (0) = -2 pi.",
         "mathjson": [
            "Multiply",
            -2,
            "Pi"
         ]
      }
   ],
