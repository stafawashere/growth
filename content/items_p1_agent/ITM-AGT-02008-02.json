   "worked_solution": [
      {
         "step": 1,
         "text": "Take N = x + 1, so N' = 1. The denominator D = x e^x is a product, so D' = e^x + x e^x = (x + 1) e^x.",
         "mathjson": [
            "Multiply",
            [
               "Add",
               "x",
               1
            ],
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule gives h'(x) = (D N' - N D')/D^2 = (x e^x - (x + 1)(x + 1) e^x)/(x e^x)^2.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  "x",
                  [
                     "Exp",
                     "x"
                  ]
               ],
               [
                  "Multiply",
                  [
                     "Power",
                     [
                        "Add",
                        "x",
                        1
                     ],
                     2
                  ],
                  [
                     "Exp",
                     "x"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Multiply",
                  "x",
                  [
                     "Exp",
                     "x"
                  ]
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "Cancel one factor of e^x. The numerator is x - (x^2 + 2x + 1) = -(x^2 + x + 1), so h'(x) = -(x^2 + x + 1)/(x^2 e^x).",
         "mathjson": [
            "Negate",
            [
