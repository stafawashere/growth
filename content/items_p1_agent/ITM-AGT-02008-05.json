   "worked_solution": [
      {
         "step": 1,
         "text": "Take N = sin(x) and D = 1 + cos(x), so N' = cos(x) and D' = -sin(x).",
         "mathjson": [
            "Cos",
            "x"
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule gives k'(x) = ((1 + cos(x)) cos(x) - sin(x)(-sin(x)))/(1 + cos(x))^2.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
