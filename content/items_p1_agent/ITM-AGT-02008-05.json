                  ],
                  2
               ]
            ],
            [
               "Power",
               [
                  "Add",
                  [
                     "Cos",
                     "x"
                  ],
                  1
               ],
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "The numerator of q'(x) is cos(x) + cos^2(x) + sin^2(x) = 1 + cos(x), so q'(x) = 1/(1 + cos(x)).",
         "mathjson": [
            "Divide",
            1,
            [
               "Add",
               [
                  "Cos",
                  "x"
               ],
               1
            ]
         ]
      },
      {
         "step": 3,
         "text": "The product rule gives k'(x) = u' q + u q' = e^x sin(x)/(1 + cos(x)) + e^x/(1 + cos(x)).",
         "mathjson": [
            "Add",
            [
               "Divide",
               [
                  "Multiply",
                  [
                     "Exp",
                     "x"
                  ],
                  [
                     "Sin",
                     "x"
                  ]
               ],
               [
                  "Add",
                  [
                     "Cos",
                     "x"
                  ],
                  1
               ]
            ],
            [
               "Divide",
               [
                  "Exp",
                  "x"
               ],
               [
                  "Add",
                  [
                     "Cos",
                     "x"
                  ],
                  1
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Combine over the common denominator, so k'(x) = e^x (sin(x) + 1)/(1 + cos(x)).",
         "mathjson": [
            "Divide",
