   "worked_solution": [
      {
         "step": 1,
         "text": "Take u = e^x, so u' = e^x. The quotient rule gives q'(x) = ((1 + cos(x)) cos(x) - sin(x)(-sin(x)))/(1 + cos(x))^2.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Multiply",
                  [
                     "Add",
                     [
                        "Cos",
                        "x"
                     ],
                     1
