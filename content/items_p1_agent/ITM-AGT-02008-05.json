                        "x"
                     ]
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Add",
                  1,
                  [
                     "Cos",
                     "x"
                  ]
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The numerator is cos(x) + cos^2(x) + sin^2(x) = cos(x) + 1, by the Pythagorean identity.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
