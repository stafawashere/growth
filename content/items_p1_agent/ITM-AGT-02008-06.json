   "stem": {
      "text": "Let q(x) = (x e^x)/(x + 1) for x > -1. What is the value of q'(1)?"
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Divide",
         [
            "Multiply",
            3,
            "ExponentialE"
         ],
         4
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "The numerator N = x e^x is itself a product, so N' = e^x + x e^x = (1 + x) e^x, and the denominator D = x + 1 has D' = 1.",
         "mathjson": [
            "Multiply",
            [
               "Add",
               1,
               "x"
            ],
            [
               "Exp",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "At x = 1: N = e, N' = 2e, D = 2 and D' = 1.",
         "mathjson": [
            "Multiply",
            2,
            "ExponentialE"
         ]
      },
      {
         "step": 3,
         "text": "The quotient rule gives q'(1) = (D N' - N D')/D^2 = (2(2e) - e(1))/2^2.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  2,
                  [
                     "Multiply",
                     2,
                     "ExponentialE"
                  ]
               ],
               "ExponentialE"
            ],
            [
               "Power",
               2,
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "Simplify to q'(1) = 3e/4.",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               3,
               "ExponentialE"
            ],
            4
         ]
      }
