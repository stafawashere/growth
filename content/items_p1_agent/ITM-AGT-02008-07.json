   "worked_solution": [
      {
         "step": 1,
         "text": "The numerator N = t^2 e^t is a product, so N' = 2t e^t + t^2 e^t = (t^2 + 2t) e^t, and the denominator D = t + 1 has D' = 1.",
         "mathjson": [
            "Multiply",
            [
               "Add",
               [
                  "Power",
                  "t",
                  2
               ],
               [
                  "Multiply",
                  2,
                  "t"
               ]
            ],
            [
               "Exp",
               "t"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule gives w'(t) = (D N' - N D')/D^2 = ((t + 1)(t^2 + 2t) e^t - t^2 e^t)/(t + 1)^2.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Negate",
                  [
                     "Multiply",
                     [
                        "Power",
                        "t",
                        2
                     ],
                     [
                        "Exp",
                        "t"
                     ]
                  ]
               ],
               [
                  "Multiply",
                  [
                     "Add",
                     "t",
                     1
                  ],
                  [
                     "Add",
                     [
                        "Power",
                        "t",
                        2
                     ],
                     [
                        "Multiply",
                        2,
                        "t"
                     ]
                  ],
                  [
                     "Exp",
                     "t"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Add",
                  "t",
                  1
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "Expand: (t + 1)(t^2 + 2t) - t^2 = t^3 + 2t^2 + 2t = t (t^2 + 2t + 2), so w'(t) = t e^t (t^2 + 2t + 2)/(t + 1)^2.",
         "mathjson": [
