         10,
         9
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Take N = x^2 - 3 and D = 2x + 1, so N' = 2x and D' = 2. At x = 1: N = -2, N' = 2, D = 3, D' = 2.",
         "mathjson": -2
      },
      {
         "step": 2,
         "text": "The quotient rule gives m'(1) = (D N' - N D')/D^2 = (3(2) - (-2)(2))/3^2.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  3,
                  2
               ],
               [
                  "Multiply",
                  -2,
                  2
               ]
            ],
            [
               "Power",
               3,
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The numerator is 6 + 4 = 10 and the denominator is 9, so m'(1) = 10/9.",
         "mathjson": [
            "Divide",
            10,
            9
         ]
      }
