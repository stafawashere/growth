   "worked_solution": [
      {
         "step": 1,
         "text": "Take u = ln(x), so u' = 1/x. The quotient rule gives p'(x) = ((x + 2)(1) - x(1))/(x + 2)^2 = 2/(x + 2)^2.",
         "mathjson": [
            "Divide",
            2,
            [
               "Power",
               [
                  "Add",
                  "x",
                  2
               ],
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "The product rule gives s'(x) = u' p + u p' = (1/x)(x/(x + 2)) + 2 ln(x)/(x + 2)^2.",
         "mathjson": [
            "Add",
            [
               "Divide",
               [
                  "Multiply",
                  2,
                  [
                     "Ln",
                     "x"
                  ]
               ],
               [
                  "Power",
