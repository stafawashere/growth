   "worked_solution": [
      {
         "step": 1,
         "text": "Take N = ln(x) and D = x^2, so N' = 1/x and D' = 2x.",
         "mathjson": [
            "Divide",
            1,
            "x"
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule gives s'(x) = (x^2 (1/x) - ln(x)(2x))/(x^2)^2 = (x - 2x ln(x))/x^4.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
