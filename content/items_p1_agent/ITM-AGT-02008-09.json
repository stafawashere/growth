                  "Multiply",
                  2,
                  "x",
                  [
                     "Ln",
                     "x"
                  ]
               ]
            ],
            [
               "Power",
               "x",
               4
            ]
         ]
      },
      {
         "step": 3,
         "text": "Divide the numerator and denominator by x, so s'(x) = (1 - 2 ln(x))/x^3.",
