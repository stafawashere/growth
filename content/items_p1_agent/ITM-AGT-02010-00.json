                     ],
                     1
                  ],
                  [
                     "Cos",
                     "x"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "Group -sin^2 x - cos^2 x as -1 with the Pythagorean identity, so dy/dx = (-1 - cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               -1,
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "Split the fraction: -1/sin^2 x is -csc^2 x and -cos x/sin^2 x is -csc x cot x, so dy/dx = -csc^2 x - csc x cot x.",
         "mathjson": [
