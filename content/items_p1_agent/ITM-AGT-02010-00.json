   "worked_solution": [
      {
         "step": 1,
         "text": "Write both terms over sin x, so y = (cos x + 1)/sin x.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Cos",
                  "x"
               ],
               1
            ],
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "Apply the quotient rule. The numerator has derivative -sin x and the denominator has derivative cos x, so dy/dx = (-sin x sin x - (cos x + 1)cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  [
                     "Negate",
                     [
                        "Sin",
                        "x"
                     ]
                  ],
                  [
