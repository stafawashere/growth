   "worked_solution": [
      {
         "step": 1,
         "text": "Rewrite the function as one quotient, f(x) = x cos x/sin x.",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               "x",
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The numerator x cos x has derivative cos x - x sin x by the product rule, so the quotient rule gives f'(x) = ((cos x - x sin x)sin x - x cos x cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  [
                     "Subtract",
                     [
                        "Cos",
                        "x"
                     ],
                     [
                        "Multiply",
                        "x",
                        [
                           "Sin",
                           "x"
                        ]
                     ]
                  ],
                  [
                     "Sin",
                     "x"
                  ]
               ],
               [
                  "Multiply",
                  "x",
                  [
                     "Cos",
                     "x"
                  ],
                  [
                     "Cos",
                     "x"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The terms -x sin^2 x - x cos^2 x combine to -x by the Pythagorean identity, so f'(x) = (sin x cos x - x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  [
                     "Sin",
                     "x"
                  ],
                  [
                     "Cos",
                     "x"
                  ]
               ],
               "x"
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "Splitting the fraction gives f'(x) = cot x - x csc^2 x.",
         "mathjson": [
            "Subtract",
            [
               "Cot",
               "x"
            ],
            [
               "Multiply",
               "x",
               [
                  "Power",
                  [
                     "Csc",
                     "x"
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 5,
         "text": "At x = pi/6, cot x = sqrt(3) and csc^2 x = 4, so f'(pi/6) = sqrt(3) - 4(pi/6) = sqrt(3) - 2pi/3.",
         "mathjson": [
            "Subtract",
