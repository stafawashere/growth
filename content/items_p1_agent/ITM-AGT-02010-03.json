                  "x"
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "Over the common denominator sin x cos x the numerator is sin^2 x + cos^2 x = 1, so g(x) = 1/(sin x cos x).",
         "mathjson": [
            "Divide",
            1,
            [
               "Multiply",
               [
                  "Sin",
                  "x"
               ],
               [
                  "Cos",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "The quotient rule with a constant numerator gives g'(x) = -(cos^2 x - sin^2 x)/(sin^2 x cos^2 x).",
         "mathjson": [
            "Divide",
            [
               "Negate",
               [
                  "Subtract",
                  [
                     "Power",
                     [
                        "Cos",
                        "x"
                     ],
