                  [
                     "Cos",
                     "x"
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Split the fraction into sin^2 x/(sin^2 x cos^2 x) - cos^2 x/(sin^2 x cos^2 x), so g'(x) = sec^2 x - csc^2 x.",
         "mathjson": [
