   "worked_solution": [
      {
         "step": 1,
         "text": "Write each term with sine and cosine, g(x) = sin x/cos x + cos x/sin x.",
         "mathjson": [
            "Add",
            [
               "Divide",
               [
                  "Sin",
                  "x"
