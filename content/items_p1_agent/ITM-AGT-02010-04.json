   "stem": {
      "text": "Let h(t) = csc t cot t. Rewrite h(t) as a single quotient in sin t and cos t and find h'(t), written in terms of csc t and cot t."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
