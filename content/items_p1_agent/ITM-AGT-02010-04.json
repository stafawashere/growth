   "worked_solution": [
      {
         "step": 1,
         "text": "Since csc t = 1/sin t and cot t = cos t/sin t, h(t) = cos t/sin^2 t.",
         "mathjson": [
            "Divide",
            [
               "Cos",
               "t"
            ],
            [
               "Power",
               [
                  "Sin",
                  "t"
               ],
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "The denominator sin^2 t has derivative 2sin t cos t, so the quotient rule gives h'(t) = (-sin t sin^2 t - cos t(2sin t cos t))/sin^4 t.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  [
                     "Negate",
                     [
                        "Sin",
                        "t"
                     ]
                  ],
                  [
