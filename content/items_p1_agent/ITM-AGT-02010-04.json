                     "t"
                  ],
                  [
                     "Cos",
                     "t"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "t"
               ],
               4
            ]
         ]
      },
      {
         "step": 3,
         "text": "Cancel one sin t and write -sin^2 t - 2cos^2 t as -(1 + cos^2 t) with the Pythagorean identity, so h'(t) = -(1 + cos^2 t)/sin^3 t.",
         "mathjson": [
            "Divide",
            [
               "Negate",
               [
                  "Add",
                  1,
                  [
                     "Power",
                     [
                        "Cos",
                        "t"
                     ],
                     2
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "t"
               ],
               3
            ]
         ]
      },
      {
         "step": 4,
         "text": "Split the fraction: 1/sin^3 t is csc^3 t and cos^2 t/sin^3 t is csc t cot^2 t, so h'(t) = -csc^3 t - csc t cot^2 t.",
         "mathjson": [
            "Subtract",
