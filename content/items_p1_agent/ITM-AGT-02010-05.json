                  ]
               ]
            ],
            [
               "Multiply",
               2,
               [
                  "Power",
                  [
                     "Csc",
                     "x"
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 5,
         "text": "At x = pi/4, csc x = sqrt(2), cot x = 1 and csc^2 x = 2, so h'(pi/4) = -sqrt(2) - 4.",
         "mathjson": [
            "Subtract",
            -4,
