   "worked_solution": [
      {
         "step": 1,
         "text": "Over the denominator sin x, h(x) = (1 - 2cos x)/sin x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               1,
               [
                  "Multiply",
                  2,
                  [
                     "Cos",
                     "x"
                  ]
               ]
            ],
            [
               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule with numerator derivative 2sin x and denominator derivative cos x gives h'(x) = (2sin x sin x - (1 - 2cos x)cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  2,
                  [
                     "Sin",
                     "x"
                  ],
                  [
                     "Sin",
                     "x"
                  ]
               ],
               [
                  "Multiply",
                  [
                     "Subtract",
                     1,
                     [
                        "Multiply",
                        2,
                        [
                           "Cos",
                           "x"
                        ]
                     ]
                  ],
                  [
                     "Cos",
                     "x"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The terms 2sin^2 x + 2cos^2 x equal 2 by the Pythagorean identity, so h'(x) = (2 - cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               2,
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "In reciprocal form, h'(x) = 2csc^2 x - csc x cot x.",
         "mathjson": [
            "Subtract",
            [
               "Multiply",
               2,
               [
                  "Power",
                  [
                     "Csc",
                     "x"
                  ],
                  2
               ]
            ],
            [
               "Multiply",
               [
                  "Csc",
                  "x"
               ],
               [
                  "Cot",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 5,
         "text": "At x = pi/6, csc x = 2, cot x = sqrt(3) and csc^2 x = 4, so h'(pi/6) = 8 - 2sqrt(3).",
         "mathjson": [
            "Subtract",
            8,
            [
               "Multiply",
               2,
               [
                  "Sqrt",
                  3
               ]
            ]
         ]
      }
