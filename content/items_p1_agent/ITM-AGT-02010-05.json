               "Sin",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule gives h'(x) = (-2sin x sin x - (1 + 2cos x)cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  -2,
                  [
                     "Sin",
                     "x"
                  ],
                  [
