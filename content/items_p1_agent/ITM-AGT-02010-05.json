   "worked_solution": [
      {
         "step": 1,
         "text": "Over the denominator sin x, h(x) = (1 + 2cos x)/sin x.",
         "mathjson": [
            "Divide",
            [
               "Add",
               1,
               [
                  "Multiply",
                  2,
                  [
                     "Cos",
                     "x"
                  ]
               ]
