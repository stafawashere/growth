                     "x"
                  ]
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The terms -2sin^2 x - 2cos^2 x equal -2 by the Pythagorean identity, so h'(x) = (-2 - cos x)/sin^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               -2,
               [
                  "Cos",
                  "x"
               ]
            ],
            [
               "Power",
               [
                  "Sin",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "In reciprocal form, h'(x) = -csc x cot x - 2csc^2 x.",
         "mathjson": [
            "Subtract",
            [
               "Negate",
               [
                  "Multiply",
                  [
                     "Csc",
                     "x"
                  ],
                  [
