               "Cos",
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule with numerator derivative 6cos x and denominator derivative -sin x gives f'(x) = (6cos x cos x + (6sin x - 1)sin x)/cos^2 x.",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Multiply",
                  6,
