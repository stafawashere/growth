               [
                  "Cos",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The terms 6cos^2 x + 6sin^2 x equal 6 by the Pythagorean identity, so f'(x) = (6 - sin x)/cos^2 x.",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               6,
               [
                  "Sin",
                  "x"
               ]
            ],
            [
               "Power",
               [
