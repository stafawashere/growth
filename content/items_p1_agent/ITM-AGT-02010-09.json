                  "Sec",
                  "x"
               ],
               2
            ]
         ]
      },
      {
         "step": 4,
         "text": "At x = pi/6, csc^2 x = 4 and sec^2 x = 4/3, so q'(pi/6) = -16 + 4/3 = -44/3.",
         "mathjson": [
