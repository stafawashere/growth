                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Both numerators reduce with the Pythagorean identity, so q'(x) = -4/sin^2 x + 1/cos^2 x = -4csc^2 x + sec^2 x.",
         "mathjson": [
            "Add",
            [
               "Negate",
               [
                  "Multiply",
                  4,
                  [
