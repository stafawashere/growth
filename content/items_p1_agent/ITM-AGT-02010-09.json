                     "Sin",
                     "x"
                  ],
                  [
                     "Cos",
                     "x"
                  ]
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule on each term gives q'(x) = (-sin^2 x - cos^2 x)/sin^2 x - 4(cos^2 x + sin^2 x)/cos^2 x.",
         "mathjson": [
            "Subtract",
            [
               "Divide",
               [
                  "Subtract",
                  [
                     "Negate",
                     [
