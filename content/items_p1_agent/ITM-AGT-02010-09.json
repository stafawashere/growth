                  ],
                  2
               ]
            ],
            [
               "Multiply",
               4,
               [
                  "Divide",
                  [
                     "Add",
                     [
                        "Power",
                        [
                           "Cos",
                           "x"
                        ],
                        2
                     ],
                     [
                        "Power",
                        [
                           "Sin",
                           "x"
                        ],
                        2
                     ]
                  ],
                  [
                     "Power",
                     [
                        "Cos",
                        "x"
                     ],
                     2
                  ]
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Both numerators reduce with the Pythagorean identity, so q'(x) = -1/sin^2 x - 4/cos^2 x = -csc^2 x - 4sec^2 x.",
         "mathjson": [
            "Subtract",
            [
               "Negate",
               [
                  "Power",
                  [
                     "Csc",
                     "x"
                  ],
                  2
               ]
            ],
            [
               "Multiply",
               4,
               [
                  "Power",
                  [
                     "Sec",
                     "x"
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "At x = pi/6, csc^2 x = 4 and sec^2 x = 4/3, so q'(pi/6) = -4 - 16/3 = -28/3.",
         "mathjson": [
            "Rational",
            -28,
