   "worked_solution": [
      {
         "step": 1,
         "text": "Write q(x) = cos x/sin x - 4sin x/cos x.",
         "mathjson": [
            "Subtract",
            [
               "Divide",
               [
                  "Cos",
                  "x"
               ],
               [
