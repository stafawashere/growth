                  "x"
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "The quotient rule on each term gives q'(x) = 4(-sin^2 x - cos^2 x)/sin^2 x + (cos^2 x + sin^2 x)/cos^2 x.",
         "mathjson": [
            "Add",
            [
