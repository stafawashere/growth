   "format": "mcq",
   "stem": {
      "text": "Let g(x) = x e^(x + 2). The line tangent to the graph of g at the point where x = -2 is y = L(x). Find L(x)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Add",
         [
            "Negate",
            "x"
         ],
         -4
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "By the product rule, g'(x) = e^(x + 2) + x e^(x + 2) = (x + 1) e^(x + 2).",
         "mathjson": [
            "Multiply",
            [
               "Add",
               "x",
               1
            ],
            [
               "Exp",
               [
                  "Add",
                  "x",
                  2
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "The slope is g'(-2) = (-1) e^0 = -1.",
         "mathjson": -1
      },
      {
         "step": 3,
         "text": "The height is g(-2) = (-2) e^0 = -2, so the point of tangency is (-2, -2).",
         "mathjson": -2
      },
      {
         "step": 4,
         "text": "Point slope form gives y = -2 - (x + 2), which simplifies to y = -x - 4.",
         "mathjson": [
            "Add",
            [
               "Negate",
               "x"
            ],
            -4
         ]
      }
   ],
