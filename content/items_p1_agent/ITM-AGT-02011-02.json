                  "Add",
                  "x",
                  3
               ],
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "The slope is h'(-2) = (4 - 12) / 1 = -8.",
         "mathjson": -8
      },
      {
         "step": 3,
         "text": "The height is h(-2) = 4 / 1 = 4, so the point of tangency is (-2, 4).",
         "mathjson": 4
      },
      {
         "step": 4,
         "text": "Point slope form gives y = 4 - 8(x + 2), which is y = -8x - 12.",
         "mathjson": [
            "Add",
