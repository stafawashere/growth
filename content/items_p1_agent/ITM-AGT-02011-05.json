   "worked_solution": [
      {
         "step": 1,
         "text": "By the product rule, q'(x) = cos x - (x + 1) sin x.",
         "mathjson": [
            "Subtract",
            [
               "Cos",
               "x"
            ],
            [
               "Multiply",
               [
                  "Add",
                  "x",
                  1
               ],
               [
                  "Sin",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "The slope is q'(-pi/2) = 0 - (1 - pi/2)(-1) = 1 - pi/2.",
         "mathjson": [
            "Subtract",
            1,
            [
               "Divide",
               "Pi",
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The height is q(-pi/2) = (1 - pi/2) times 0 = 0, so the point of tangency is (-pi/2, 0).",
         "mathjson": 0
      },
      {
         "step": 4,
         "text": "Point slope form gives y = 0 + (1 - pi/2)(x + pi/2).",
