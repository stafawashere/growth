                        2,
                        "x"
                     ],
                     4
                  ]
               ]
            ],
            1
         ]
      },
      {
         "step": 2,
         "text": "The slope is w'(2) = 2e^0 + 1 = 3.",
         "mathjson": 3
      },
      {
         "step": 3,
         "text": "The height is w(2) = e^0 + 2 = 3, so the point of tangency is (2, 3).",
         "mathjson": 3
      },
      {
         "step": 4,
         "text": "The tangent line is y = 3 + 3(x - 2).",
         "mathjson": [
            "Add",
            3,
