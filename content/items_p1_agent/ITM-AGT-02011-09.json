      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "By the chain rule, w'(x) = 2e^(2x - 4) + 1.",
         "mathjson": [
            "Add",
            [
               "Multiply",
               2,
               [
                  "Exp",
                  [
                     "Subtract",
                     [
