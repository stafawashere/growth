   "format": "short_answer",
   "stem": {
      "text": "Let w(x) = e^(2x + 4) + 3x. Use the line tangent to the graph of w at the point where x = -2 to approximate w(-1.9)."
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": [
         "Rational",
         -9,
         2
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "By the chain rule, w'(x) = 2e^(2x + 4) + 3.",
         "mathjson": [
            "Add",
            [
               "Multiply",
               2,
               [
                  "Exp",
                  [
                     "Add",
                     [
                        "Multiply",
                        2,
                        "x"
                     ],
                     4
                  ]
               ]
            ],
            3
         ]
      },
      {
         "step": 2,
         "text": "The slope is w'(-2) = 2e^0 + 3 = 5.",
         "mathjson": 5
      },
      {
         "step": 3,
         "text": "The height is w(-2) = e^0 - 6 = -5, so the point of tangency is (-2, -5).",
         "mathjson": -5
      },
      {
         "step": 4,
         "text": "The tangent line is y = -5 + 5(x + 2).",
         "mathjson": [
            "Add",
            -5,
            [
               "Multiply",
               5,
               [
                  "Add",
                  "x",
                  2
               ]
            ]
         ]
      },
      {
         "step": 5,
         "text": "At x = -1.9 the line gives -5 + 5(0.1) = -4.5.",
         "mathjson": [
            "Rational",
            -9,
            2
         ]
      }
   ],
