                     3,
                     "x"
                  ]
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "At x = pi/9 the innermost value is 3x = pi/3, where sin(pi/3) = sqrt(3)/2 and cos(pi/3) = 1/2.",
         "mathjson": [
            "Multiply",
            [
               "Rational",
               1,
               2
            ],
            [
               "Sqrt",
               3
            ]
         ]
      },
      {
         "step": 3,
         "text": "Substitute: f'(pi/9) = e^(sqrt(3)/2) * (1/2) * 3 = (3/2) e^(sqrt(3)/2).",
