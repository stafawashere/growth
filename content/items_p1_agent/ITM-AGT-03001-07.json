   "format": "short_answer",
   "stem": {
      "text": "Let f(x) = x / sqrt(2x + 1) for x > -1/2. Find the exact value of f'(4)."
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": [
         "Rational",
         5,
         27
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Apply the quotient rule: f'(x) = [sqrt(2x + 1) * 1 - x * d/dx(sqrt(2x + 1))] / (2x + 1).",
         "mathjson": [
            "Add",
            1,
            [
               "Multiply",
               2,
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "By the chain rule with the linear inner function 2x + 1, d/dx(sqrt(2x + 1)) = (1/(2 sqrt(2x + 1))) * 2 = 1/sqrt(2x + 1).",
         "mathjson": [
            "Power",
            [
               "Add",
               1,
               [
                  "Multiply",
                  2,
                  "x"
               ]
            ],
            [
               "Rational",
               -1,
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "Clear the compound fraction: f'(x) = [(2x + 1) - x] / (2x + 1)^(3/2) = (x + 1) / (2x + 1)^(3/2).",
         "mathjson": [
            "Multiply",
            [
               "Power",
               [
                  "Add",
                  1,
                  [
                     "Multiply",
                     2,
                     "x"
                  ]
               ],
               [
                  "Rational",
                  -3,
                  2
               ]
            ],
            [
               "Add",
               1,
               "x"
            ]
         ]
      },
      {
         "step": 4,
         "text": "At x = 4, 2x + 1 = 9 and 9^(3/2) = 27, so f'(4) = 5/27.",
         "mathjson": [
            "Rational",
            5,
            27
         ]
      }
   ],
