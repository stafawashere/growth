               ],
               "Pi"
            ]
         ]
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "g is a product of two composites, so g'(x) = (e^(2x))' sin^2(x) + e^(2x) (sin^2(x))'.",
         "mathjson": [
            "Exp",
            [
               "Multiply",
               2,
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "By the chain rule, (e^(2x))' = 2e^(2x) and (sin^2(x))' = 2 sin(x) cos(x). So g'(x) = 2e^(2x) sin^2(x) + 2e^(2x) sin(x) cos(x).",
         "mathjson": [
            "Add",
            [
               "Multiply",
               2,
               [
                  "Power",
                  [
                     "Sin",
                     "x"
                  ],
                  2
               ],
               [
                  "Exp",
                  [
                     "Multiply",
                     2,
                     "x"
                  ]
               ]
            ],
            [
               "Multiply",
               2,
               [
                  "Cos",
                  "x"
               ],
               [
                  "Exp",
                  [
                     "Multiply",
                     2,
                     "x"
                  ]
               ],
               [
                  "Sin",
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "At x = pi/6, e^(2x) = e^(pi/3), sin(pi/6) = 1/2 and cos(pi/6) = sqrt(3)/2, so sin^2(x) = 1/4 and sin(x) cos(x) = sqrt(3)/4.",
         "mathjson": [
            "Divide",
            [
               "Sqrt",
               3
            ],
            4
         ]
      },
      {
         "step": 4,
         "text": "Then g'(pi/6) = 2e^(pi/3)(1/4) + 2e^(pi/3)(sqrt(3)/4) = (1 + sqrt(3)) e^(pi/3) / 2.",
         "mathjson": [
            "Multiply",
