   "format": "short_answer",
   "stem": {
      "text": "Consider the curve x^2 + 3xy - y^2 = 3x^2. Find the slope of the curve at the point on it where x = 1 and y > 1."
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": 2
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Find the y-coordinate first. With x = 1 the equation becomes 1 + 3y - y^2 = 3, so y^2 - 3y + 2 = 0 and y = 1 or y = 2. The condition y > 1 selects y = 2.",
         "mathjson": 2
      },
      {
         "step": 2,
         "text": "Differentiate every term of both sides with respect to x, using the product rule on 3xy: 2x + 3y + 3x(dy/dx) - 2y(dy/dx) = 6x.",
         "mathjson": [
            "Equal",
            [
               "Subtract",
               [
                  "Add",
                  [
                     "Add",
                     [
                        "Multiply",
                        3,
                        "dydx",
                        "x"
                     ],
                     [
                        "Multiply",
                        2,
                        "x"
                     ]
                  ],
                  [
                     "Multiply",
                     3,
                     "y"
                  ]
               ],
               [
                  "Multiply",
                  2,
                  "dydx",
                  "y"
               ]
            ],
            [
               "Multiply",
               6,
               "x"
            ]
         ]
      },
      {
         "step": 3,
         "text": "Collect the dy/dx terms on the left: (3x - 2y)(dy/dx) = 4x - 3y.",
         "mathjson": [
            "Equal",
            [
               "Multiply",
               [
                  "Subtract",
                  [
                     "Multiply",
                     3,
                     "x"
                  ],
                  [
                     "Multiply",
                     2,
                     "y"
                  ]
               ],
               "dydx"
            ],
            [
               "Subtract",
               [
                  "Multiply",
                  4,
                  "x"
               ],
               [
                  "Multiply",
                  3,
                  "y"
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Divide by 3x - 2y, so dy/dx = (4x - 3y)/(3x - 2y).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  4,
                  "x"
               ],
               [
                  "Multiply",
                  3,
                  "y"
               ]
            ],
            [
               "Subtract",
               [
                  "Multiply",
                  3,
                  "x"
               ],
               [
                  "Multiply",
                  2,
                  "y"
               ]
            ]
         ]
      },
      {
         "step": 5,
         "text": "Substitute x = 1 and y = 2: dy/dx = (4 - 6)/(3 - 4) = 2.",
         "mathjson": 2
      }
   ],
