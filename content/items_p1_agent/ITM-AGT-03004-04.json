                  "y",
                  "dydx"
               ]
            ],
            3
         ]
      },
      {
         "step": 2,
         "text": "Collect the dy/dx terms: (2y - 3x)(dy/dx) = 3 - 2x + 3y.",
         "mathjson": [
            "Equal",
            [
               "Multiply",
               [
                  "Subtract",
                  [
                     "Multiply",
                     2,
                     "y"
                  ],
                  [
                     "Multiply",
                     3,
