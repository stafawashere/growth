   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate both sides with respect to x, using the product rule on 3xy and attaching dy/dx to the y^2 term: 2x - 3y - 3x(dy/dx) + 2y(dy/dx) = 3.",
         "mathjson": [
            "Equal",
            [
