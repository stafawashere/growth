                  3,
                  [
                     "Multiply",
                     2,
                     "x"
                  ]
               ],
               [
                  "Multiply",
                  3,
                  "y"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Divide by 2y - 3x, so dy/dx = (3 - 2x + 3y)/(2y - 3x).",
         "mathjson": [
            "Divide",
            [
               "Add",
               [
                  "Subtract",
