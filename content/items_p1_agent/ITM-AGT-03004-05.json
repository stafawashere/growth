   "format": "short_answer",
   "stem": {
      "text": "For the curve 3x^2 - 2xy + y^3 = y + 8, find the value of dy/dx at the point (2, 1)."
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": 5
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate both sides with respect to x, using the product rule on 2xy and attaching dy/dx to every y term, including the y on the right: 6x - 2y - 2x(dy/dx) + 3y^2(dy/dx) = dy/dx.",
         "mathjson": [
            "Equal",
            [
               "Add",
               [
                  "Multiply",
                  6,
                  "x"
               ],
               [
                  "Negate",
                  [
                     "Multiply",
                     2,
                     "y"
                  ]
               ],
               [
                  "Negate",
                  [
                     "Multiply",
                     2,
                     "x",
                     "dydx"
                  ]
               ],
               [
                  "Multiply",
                  3,
                  [
                     "Power",
                     "y",
                     2
                  ],
                  "dydx"
               ]
            ],
            "dydx"
         ]
      },
      {
         "step": 2,
         "text": "Move every dy/dx term to one side and collect: (3y^2 - 2x - 1)(dy/dx) = 2y - 6x.",
         "mathjson": [
            "Equal",
            [
               "Multiply",
               [
                  "Subtract",
                  [
                     "Subtract",
                     [
                        "Multiply",
                        3,
                        [
                           "Power",
                           "y",
                           2
                        ]
                     ],
                     [
                        "Multiply",
                        2,
                        "x"
                     ]
                  ],
                  1
               ],
               "dydx"
            ],
            [
               "Subtract",
               [
                  "Multiply",
                  2,
                  "y"
               ],
               [
                  "Multiply",
                  6,
                  "x"
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Divide by 3y^2 - 2x - 1, so dy/dx = (2y - 6x)/(3y^2 - 2x - 1).",
         "mathjson": [
            "Divide",
            [
               "Subtract",
               [
                  "Multiply",
                  2,
                  "y"
               ],
               [
                  "Multiply",
                  6,
                  "x"
               ]
            ],
            [
               "Subtract",
               [
                  "Subtract",
                  [
                     "Multiply",
                     3,
                     [
                        "Power",
                        "y",
                        2
                     ]
                  ],
                  [
                     "Multiply",
                     2,
                     "x"
                  ]
               ],
               1
            ]
         ]
      },
      {
         "step": 4,
         "text": "Substitute x = 2 and y = 1: dy/dx = (2 - 12)/(3 - 4 - 1) = (-10)/(-2) = 5.",
         "mathjson": 5
      }
   ],
