   "stem": {
      "text": "The variables x and y are both differentiable functions of t and satisfy x^2 + xy = 12 for all t. At the instant when x = 2, y = 4 and dx/dt = 2, find dy/dt."
   },
   "answer_key": {
      "form": "numeric",
      "mathjson": -8
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate both sides with respect to t. Each variable carries its own rate, and xy needs the product rule: 2x(dx/dt) + y(dx/dt) + x(dy/dt) = 0.",
         "mathjson": [
            "Equal",
            [
               "Add",
               [
                  "Add",
                  [
                     "Multiply",
                     2,
                     "dxdt",
                     "x"
                  ],
                  [
                     "Multiply",
                     "dxdt",
                     "y"
                  ]
               ],
               [
                  "Multiply",
                  "dydt",
                  "x"
               ]
            ],
            0
         ]
      },
      {
         "step": 2,
         "text": "Solve for dy/dt: dy/dt = -(2x + y)(dx/dt)/x.",
         "mathjson": [
            "Negate",
            [
               "Divide",
               [
                  "Multiply",
                  "dxdt",
                  [
                     "Add",
                     [
                        "Multiply",
                        2,
                        "x"
                     ],
                     "y"
                  ]
               ],
               "x"
            ]
         ]
      },
      {
         "step": 3,
         "text": "Substitute x = 2, y = 4 and dx/dt = 2: dy/dt = -(4 + 4)(2)/2 = -8.",
         "mathjson": -8
      }
