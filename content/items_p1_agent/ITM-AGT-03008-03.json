         ]
      },
      {
         "step": 2,
         "text": "At (2, -1), dy/dx = (2)(-1) + 2(2) = 2.",
         "mathjson": 2
      },
      {
         "step": 3,
         "text": "Substitute: d^2y/dx^2 = -1 + (2)(2) + 2 = 5.",
         "mathjson": 5
      }
