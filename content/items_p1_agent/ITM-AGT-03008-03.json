   "worked_solution": [
      {
         "step": 1,
         "text": "The product rule on xy gives d^2y/dx^2 = y + x (dy/dx) + 2.",
         "mathjson": [
            "Add",
            "y",
            [
               "Multiply",
               "x",
               [
