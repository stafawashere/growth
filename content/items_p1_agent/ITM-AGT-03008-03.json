                     "Multiply",
                     2,
                     "x"
                  ]
               ]
            ],
            2
         ]
      },
      {
         "step": 2,
         "text": "At (1, 3), dy/dx = (1)(3) + 2(1) = 5.",
         "mathjson": 5
      },
      {
         "step": 3,
         "text": "Substitute: d^2y/dx^2 = 3 + (1)(5) + 2 = 10.",
         "mathjson": 10
      }
