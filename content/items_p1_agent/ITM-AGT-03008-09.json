                     "y",
                     2
                  ]
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "At (2, 1), dy/dx = (2)(1^2) = 2.",
         "mathjson": 2
      },
      {
         "step": 3,
         "text": "Substitute x = 2, y = 1 and dy/dx = 2: d^2y/dx^2 = 1 + 2(2)(1)(2) = 9.",
         "mathjson": 9
      }
