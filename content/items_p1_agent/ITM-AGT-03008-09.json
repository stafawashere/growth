   "worked_solution": [
      {
         "step": 1,
         "text": "The product rule and the chain rule on xy^2 give d^2y/dx^2 = y^2 + 2xy (dy/dx).",
         "mathjson": [
            "Add",
            [
               "Power",
               "y",
               2
            ],
