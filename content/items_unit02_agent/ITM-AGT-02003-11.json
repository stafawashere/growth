   "stem": {
      "text": "Find the value of \\( \\lim_{h \\to 0} \\frac{\\tan\\left(\\frac{\\pi}{6} + h\\right) - \\frac{\\sqrt{3}}{3}}{h} \\)."
   },
   "answer_key": {
