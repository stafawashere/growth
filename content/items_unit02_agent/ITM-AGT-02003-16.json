   "stem": {
      "text": "Find the value of \\( \\lim_{h \\to 0} \\frac{\\sin\\left(\\frac{\\pi}{2} + h\\right) - 1}{h} \\)."
   },
   "answer_key": {
      "form": "symbolic",
