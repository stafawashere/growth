               "Multiply",
               2,
               [
                  "Sqrt",
                  "u"
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Evaluate: \\( g'(9) = \\frac{1}{6} \\).",
         "mathjson": [
            "Rational",
            1,
            6
         ]
      }
