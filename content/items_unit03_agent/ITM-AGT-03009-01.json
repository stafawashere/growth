                     2,
                     "x"
                  ]
               ],
               [
                  "Power",
                  [
                     "Cos",
                     [
                        "Multiply",
                        2,
                        "x"
                     ]
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Assemble the product rule: \\( f'(x) = - 6 \\cdot 2^{x} \\sin{\\left(2 x \\right)} \\cos^{2}{\\left(2 x \\right)} + 2^{x} \\ln{\\left(2 \\right)} \\cos^{3}{\\left(2 x \\right)} \\).",
