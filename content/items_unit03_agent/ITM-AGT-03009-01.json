                     "x"
                  ]
               ],
               3
            ]
         ]
      },
      {
         "step": 2,
         "text": "\\( 2^{x} \\) is an exponential function with a constant base, so its derivative is \\( 2^{x} \\ln{\\left(2 \\right)} \\); the power rule does not apply to it.",
         "mathjson": [
            "Multiply",
            [
               "Power",
               2,
               "x"
            ],
            [
               "Ln",
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The factor \\( \\cos^{3}(2x) \\) is a cube of \\( \\cos(2x) \\), which is a cosine of \\( 2x \\), so apply the chain rule from the outside inward: \\( \\left(\\cos^{3}(2x)\\right)' = - 6 \\sin{\\left(2 x \\right)} \\cos^{2}{\\left(2 x \\right)} \\).",
         "mathjson": [
            "Negate",
            [
               "Multiply",
               6,
               [
                  "Sin",
                  [
