                        2
                     ]
                  ]
               ],
               [
                  "Sin",
                  [
                     "Power",
                     "x",
                     2
                  ]
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Assemble the product rule: \\( f'(x) = - 2 \\cdot 5^{x} x e^{\\cos{\\left(x^{2} \\right)}} \\sin{\\left(x^{2} \\right)} + 5^{x} e^{\\cos{\\left(x^{2} \\right)}} \\ln{\\left(5 \\right)} \\).",
