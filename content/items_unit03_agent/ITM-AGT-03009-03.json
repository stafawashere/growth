                     2
                  ]
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "\\( 5^{x} \\) is an exponential function with a constant base, so its derivative is \\( 5^{x} \\ln{\\left(5 \\right)} \\); the power rule does not apply to it.",
         "mathjson": [
            "Multiply",
            [
               "Power",
               5,
               "x"
            ],
            [
               "Ln",
               5
            ]
         ]
      },
      {
         "step": 3,
         "text": "The factor \\( e^{\\cos(x^{2})} \\) is an exponential of \\( \\cos(x^{2}) \\), which is a cosine of \\( x^{2} \\), so apply the chain rule from the outside inward: \\( \\left(e^{\\cos(x^{2})}\\right)' = - 2 x e^{\\cos{\\left(x^{2} \\right)}} \\sin{\\left(x^{2} \\right)} \\).",
         "mathjson": [
            "Negate",
            [
               "Multiply",
               2,
               "x",
               [
                  "Exp",
                  [
                     "Cos",
                     [
                        "Power",
