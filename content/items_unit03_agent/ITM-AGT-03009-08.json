               ]
            ],
            [
               "Power",
               3,
               "x"
            ]
         ]
      },
      {
         "step": 2,
         "text": "\\( 3^{x} \\) is an exponential function with a constant base, so its derivative is \\( 3^{x} \\ln{\\left(3 \\right)} \\); the power rule does not apply to it.",
         "mathjson": [
            "Multiply",
            [
               "Power",
               3,
               "x"
            ],
            [
               "Ln",
               3
            ]
         ]
      },
      {
         "step": 3,
         "text": "The factor \\( e^{\\sin(5x)} \\) is an exponential of \\( \\sin(5x) \\), which is a sine of \\( 5x \\), so apply the chain rule from the outside inward: \\( \\left(e^{\\sin(5x)}\\right)' = 5 e^{\\sin{\\left(5 x \\right)}} \\cos{\\left(5 x \\right)} \\).",
         "mathjson": [
            "Multiply",
