                        4,
                        "x"
                     ]
                  ],
                  1
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Assemble the quotient rule: \\( f'(x) = 5^{- 2 x} \\left(- 5^{x} \\sqrt{\\sin{\\left(4 x \\right)} + 1} \\ln{\\left(5 \\right)} + \\frac{2 \\cdot 5^{x} \\cos{\\left(4 x \\right)}}{\\sqrt{\\sin{\\left(4 x \\right)} + 1}}\\right) \\).",
