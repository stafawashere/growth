   "stem": {
      "text": "Let \\( g \\) be the function defined by \\( g(x) = \\int_{0}^{x} \\left(\\sqrt{2}\\cos t - 1\\right) \\, dt \\) for \\( 0 < x < 2 \\pi \\). Find the value of \\( x \\) at which \\( g \\) has a relative minimum."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Divide",
