   "stem": {
      "text": "Find the exact value of \\( \\int_{0}^{1} x \\left(x^{2} + 1\\right)^{3} \\, dx \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Rational",
         15,
