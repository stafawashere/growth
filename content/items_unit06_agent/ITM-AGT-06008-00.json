      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Let \\( u = x^{2} + 1 \\).",
         "mathjson": [
            "Add",
            [
               "Power",
               "x",
               2
            ],
            1
         ]
      },
      {
         "step": 2,
         "text": "Then \\( du = 2 x \\, dx \\), so \\( x \\, dx = \\frac{1}{2} \\, du \\).",
         "mathjson": [
            "Rational",
            1,
            2
         ]
      },
      {
         "step": 3,
         "text": "Convert the limits: \\( x = 0 \\) gives \\( u = 1 \\) and \\( x = 1 \\) gives \\( u = 2 \\), so the integral becomes \\( \\int_{1}^{2} \\frac{u^{3}}{2} \\, du \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               "u",
               3
            ],
            2
         ]
      },
      {
         "step": 4,
         "text": "An antiderivative of \\( \\frac{u^{3}}{2} \\) is \\( \\frac{u^{4}}{8} \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               "u",
               4
            ],
            8
         ]
      },
      {
         "step": 5,
         "text": "Evaluate at the new limits: \\( 2 - \\left(\\frac{1}{8}\\right) = \\frac{15}{8} \\).",
         "mathjson": [
            "Rational",
            15,
            8
         ]
      }
