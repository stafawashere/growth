   "stem": {
      "text": "Find the exact value of \\( \\int_{0}^{1} x^{3} \\left(x^{4} + 1\\right)^{2} \\, dx \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
