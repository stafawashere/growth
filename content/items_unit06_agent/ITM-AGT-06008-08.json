   "worked_solution": [
      {
         "step": 1,
         "text": "Let \\( u = x^{4} + 1 \\).",
         "mathjson": [
            "Add",
            [
               "Power",
               "x",
               4
            ],
            1
         ]
      },
      {
         "step": 2,
         "text": "Then \\( du = 4 x^{3} \\, dx \\), so \\( x^{3} \\, dx = \\frac{1}{4} \\, du \\).",
         "mathjson": [
            "Rational",
            1,
            4
         ]
      },
      {
         "step": 3,
         "text": "Convert the limits: \\( x = 0 \\) gives \\( u = 1 \\) and \\( x = 1 \\) gives \\( u = 2 \\), so the integral becomes \\( \\int_{1}^{2} \\frac{u^{2}}{4} \\, du \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               "u",
               2
            ],
            4
         ]
      },
      {
         "step": 4,
         "text": "An antiderivative of \\( \\frac{u^{2}}{4} \\) is \\( \\frac{u^{3}}{12} \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               "u",
               3
            ],
            12
         ]
      },
      {
         "step": 5,
         "text": "Evaluate at the new limits: \\( \\frac{2}{3} - \\left(\\frac{1}{12}\\right) = \\frac{7}{12} \\).",
         "mathjson": [
            "Rational",
            7,
            12
         ]
      }
