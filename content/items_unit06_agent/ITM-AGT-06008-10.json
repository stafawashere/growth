            "Divide",
            [
               "Power",
               "u",
               4
            ],
            8
         ]
      },
      {
         "step": 5,
         "text": "Evaluate at the new limits: \\( \\frac{81}{8} - \\left(\\frac{1}{8}\\right) = 10 \\).",
         "mathjson": 10
