   "worked_solution": [
      {
         "step": 1,
         "text": "Let \\( u = x^{2} \\) and \\( dv = \\cos{\\left(x \\right)} \\, dx \\), so \\( du = 2 x \\, dx \\) and \\( v = \\sin{\\left(x \\right)} \\).",
         "mathjson": [
