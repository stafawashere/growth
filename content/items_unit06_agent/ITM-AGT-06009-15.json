   "format": "mcq",
   "stem": {
      "text": "Find the exact value of \\( \\int_{0}^{1} \\left(x + 1\\right) e^{x} \\, dx \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": "ExponentialE"
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Let \\( u = x + 1 \\) and \\( dv = e^{x} \\, dx \\), so \\( du = dx \\) and \\( v = e^{x} \\).",
         "mathjson": [
            "Exp",
            "x"
         ]
      },
      {
         "step": 2,
         "text": "Then the integral equals \\( \\left[\\left(x + 1\\right) e^{x}\\right]_{0}^{1} - \\int_{0}^{1} e^{x} \\, dx \\), and the boundary term is \\( -1 + 2 e \\).",
         "mathjson": [
            "Add",
            -1,
            [
               "Multiply",
               2,
               "ExponentialE"
            ]
         ]
      },
      {
         "step": 3,
         "text": "The remaining integral is \\( \\int_{0}^{1} e^{x} \\, dx = -1 + e \\).",
         "mathjson": [
            "Add",
            -1,
            "ExponentialE"
         ]
      },
      {
         "step": 4,
         "text": "So the value is \\( -1 + 2 e - \\left(-1 + e\\right) = e \\).",
         "mathjson": "ExponentialE"
      }
   ],
