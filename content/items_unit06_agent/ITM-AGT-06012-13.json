   "stem": {
      "text": "Let \\( g(x) = \\int_{1}^{x^{2} + 1} \\frac{1}{t^{2} + 1} \\, dt \\). Find the exact value of \\( g'\\left(1\\right) \\)."
   },
   "answer_key": {
