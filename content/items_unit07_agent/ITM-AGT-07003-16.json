   "worked_solution": [
      {
         "step": 1,
         "text": "Write \\( e^{x - y} = e^{x} e^{-y} \\) and separate: \\( e^{y} \\, dy = e^{x} \\, dx \\).",
         "mathjson": [
            "Exp",
            "x"
         ]
      },
      {
         "step": 2,
         "text": "Antidifferentiate both sides with one constant: \\( e^{y} = e^{x} + C \\).",
         "mathjson": [
            "Exp",
            "x"
         ]
      },
      {
         "step": 3,
         "text": "At \\( x = 0 \\), \\( y = \\ln{\\left(2 \\right)} \\), so \\( C = 1 \\).",
         "mathjson": 1
      },
      {
         "step": 4,
         "text": "Take the natural logarithm: \\( y = \\ln{\\left(e^{x} + 1 \\right)} \\).",
         "mathjson": [
