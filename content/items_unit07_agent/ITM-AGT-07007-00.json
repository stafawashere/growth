   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate the candidate: \\( y' = k e^{kx} \\) and \\( y'' = k^{2} e^{kx} \\).",
         "mathjson": [
            "Power",
            "k",
            2
         ]
      },
      {
         "step": 2,
         "text": "Substitute into the equation: \\( e^{kx} \\left( k^{2} + k - 12 \\right) = 0 \\).",
