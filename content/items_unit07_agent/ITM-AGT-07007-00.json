   "stem": {
      "text": "The function \\( y = e^{kx} \\) is a solution of the differential equation \\( y'' + y' - 12y = 0 \\), where \\( k > 0 \\). Find the value of the constant \\( k \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 3
