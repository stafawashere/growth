               "k",
               2
            ],
            "k",
            -12
         ]
      },
      {
         "step": 3,
         "text": "Since \\( e^{kx} \\neq 0 \\), \\( k^{2} + k - 12 = 0 \\), so \\( k = 3 \\) or \\( k = -4 \\).",
         "mathjson": -4
      },
      {
         "step": 4,
         "text": "The condition \\( k > 0 \\) keeps \\( k = 3 \\).",
