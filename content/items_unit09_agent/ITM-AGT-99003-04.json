   "format": "mcq",
   "stem": {
      "text": "A curve is given by the polar equation \\( r = \\theta \\). Find the exact slope of the line tangent to the curve at the point where \\( \\theta = \\frac{\\pi}{2} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Negate",
         [
            "Divide",
            2,
            "Pi"
         ]
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "Write the Cartesian coordinates in terms of \\( \\theta \\): \\( x = r\\cos\\theta = \\left(\\theta\\right)\\cos\\theta \\) and \\( y = r\\sin\\theta = \\left(\\theta\\right)\\sin\\theta \\). At \\( \\theta = \\frac{\\pi}{2} \\), \\( r = \\frac{\\pi}{2} \\).",
         "mathjson": [
            "Divide",
            "Pi",
            2
         ]
      },
      {
         "step": 2,
         "text": "Differentiate each product with respect to \\( \\theta \\): \\( \\frac{dx}{d\\theta} = \\frac{dr}{d\\theta}\\cos\\theta - r\\sin\\theta \\) and \\( \\frac{dy}{d\\theta} = \\frac{dr}{d\\theta}\\sin\\theta + r\\cos\\theta \\), where \\( \\frac{dr}{d\\theta} = 1 \\), which is \\( 1 \\) at \\( \\theta = \\frac{\\pi}{2} \\).",
         "mathjson": 1
      },
      {
         "step": 3,
         "text": "At \\( \\theta = \\frac{\\pi}{2} \\): \\( \\frac{dx}{d\\theta} = - \\frac{\\pi}{2} \\) and \\( \\frac{dy}{d\\theta} = 1 \\).",
         "mathjson": 1
      },
      {
         "step": 4,
         "text": "The slope is \\( \\frac{dy}{dx} = \\frac{dy/d\\theta}{dx/d\\theta} = - \\frac{2}{\\pi} \\).",
         "mathjson": [
            "Negate",
            [
               "Divide",
               2,
               "Pi"
            ]
         ]
      }
   ],
