   "worked_solution": [
      {
         "step": 1,
         "text": "Dividing consecutive terms gives the constant quotient \\( r = \\frac{2}{5} \\), so the series is geometric, and \\( |r| < 1 \\).",
         "mathjson": [
            "Rational",
            2,
            5
         ]
      },
      {
         "step": 2,
         "text": "The series starts at \\( n = 1 \\), so the first term is \\( a = \\frac{6}{5} \\).",
         "mathjson": [
            "Rational",
            6,
            5
         ]
      },
      {
         "step": 3,
         "text": "A convergent geometric series equals \\( \\frac{a}{1 - r} = \\frac{\\frac{6}{5}}{1 - \\left(\\frac{2}{5}\\right)} \\).",
         "mathjson": 2
      },
      {
         "step": 4,
         "text": "The value of the series is \\( 2 \\).",
         "mathjson": 2
      }
