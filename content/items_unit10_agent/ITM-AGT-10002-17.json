                     ]
                  ]
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "Writing out the terms from \\( n = 1 \\) to \\( n = N \\), the inner terms cancel and the partial sum is \\( S_N = 1 - \\frac{1}{\\sqrt{N + 1}} \\).",
         "mathjson": [
            "Add",
            1,
            [
               "Negate",
               [
                  "Divide",
                  1,
                  [
                     "Sqrt",
                     [
