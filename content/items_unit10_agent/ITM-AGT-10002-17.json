                        "N",
                        1
                     ]
                  ]
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "As \\( N \\to \\infty \\), the terms containing \\( N \\) approach their limits, so \\( \\lim_{N \\to \\infty} S_N = 1 \\).",
         "mathjson": 1
      },
      {
         "step": 4,
         "text": "The value of the series is \\( 1 \\).",
         "mathjson": 1
      }
