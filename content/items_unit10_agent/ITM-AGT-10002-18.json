   "worked_solution": [
      {
         "step": 1,
         "text": "The general term is already a difference \\( b_n - b_{n+1} \\), so the series telescopes.",
         "mathjson": [
            "Add",
            [
               "Arctan",
               [
                  "Add",
                  "n",
                  1
               ]
            ],
            [
               "Negate",
