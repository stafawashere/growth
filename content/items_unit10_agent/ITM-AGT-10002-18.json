                  "Arctan",
                  "n"
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "Writing out the terms from \\( n = 1 \\) to \\( n = N \\), the inner terms cancel and the partial sum is \\( S_N = \\arctan{\\left(N + 1 \\right)} - \\frac{\\pi}{4} \\).",
         "mathjson": [
            "Add",
            [
               "Arctan",
               [
                  "Add",
                  "N",
                  1
               ]
            ],
            [
               "Negate",
               [
                  "Divide",
                  "Pi",
                  4
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "As \\( N \\to \\infty \\), the terms containing \\( N \\) approach their limits, so \\( \\lim_{N \\to \\infty} S_N = \\frac{\\pi}{4} \\).",
         "mathjson": [
            "Divide",
            "Pi",
            4
         ]
      },
      {
         "step": 4,
         "text": "The value of the series is \\( \\frac{\\pi}{4} \\).",
         "mathjson": [
