                              "Sqrt",
                              3
                           ]
                        ],
                        3
                     ]
                  ]
               ],
               3
            ],
            [
               "Negate",
               [
                  "Divide",
                  [
                     "Multiply",
                     "Pi",
                     [
                        "Sqrt",
                        3
                     ]
                  ],
                  18
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "As \\( b \\to \\infty \\), \\( F(b) \\to \\frac{\\sqrt{3} \\pi}{6} \\), so the integral converges to \\( \\frac{\\sqrt{3} \\pi}{9} \\). This number is the value of the integral, not the sum of the series.",
         "mathjson": [
