   "worked_solution": [
      {
         "step": 1,
         "text": "The relation gives \\( f'(0) = 9 \\). Differentiate the relation, using the chain rule on each term that holds \\( f \\): \\( f'' = 2 f f' - 4 \\).",
         "mathjson": 9
      },
      {
         "step": 2,
         "text": "Evaluate in order at \\( x = 0 \\), feeding each value into the next: \\( f'(0) = 9 \\), \\( f''(0) = 50 \\).",
         "mathjson": 50
      },
      {
         "step": 3,
         "text": "Divide each value by the matching factorial: \\( \\frac{3}{0!} = 3 \\), \\( \\frac{9}{1!} = 9 \\), \\( \\frac{50}{2!} = 25 \\).",
