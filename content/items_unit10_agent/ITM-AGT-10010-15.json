   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate the relation, using the chain rule on each term that holds \\( f \\): \\( f''' = 4 f f' - 1 \\).",
         "mathjson": 2
      },
      {
         "step": 2,
         "text": "Evaluate in order at \\( x = 0 \\), feeding each value into the next: \\( f''(0) = 2 \\), \\( f'''(0) = -9 \\).",
         "mathjson": -9
      },
      {
         "step": 3,
         "text": "Divide each value by the matching factorial: \\( \\frac{-1}{0!} = -1 \\), \\( \\frac{2}{1!} = 2 \\), \\( \\frac{2}{2!} = 1 \\), \\( \\frac{-9}{3!} = -\\frac{3}{2} \\).",
