   "worked_solution": [
      {
         "step": 1,
         "text": "Differentiate the relation, using the product rule and the chain rule on each term that holds \\( f \\): \\( f''' = f + 2 f' f'' + f' x \\).",
         "mathjson": 3
      },
      {
         "step": 2,
         "text": "Evaluate in order at \\( x = 2 \\), feeding each value into the next: \\( f''(2) = 3 \\), \\( f'''(2) = 9 \\).",
         "mathjson": 9
      },
      {
         "step": 3,
         "text": "Divide each value by the matching factorial: \\( \\frac{1}{0!} = 1 \\), \\( \\frac{1}{1!} = 1 \\), \\( \\frac{3}{2!} = \\frac{3}{2} \\), \\( \\frac{9}{3!} = \\frac{3}{2} \\).",
