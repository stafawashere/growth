   "worked_solution": [
      {
         "step": 1,
         "text": "A degree 2 polynomial needs the values through order 2: \\( f(2) = 1 \\), \\( f'(2) = -3 \\), \\( f''(2) = 8 \\). The value of order 3 is not used.",
         "mathjson": 8
      },
      {
         "step": 2,
         "text": "Divide each by the matching factorial: \\( \\frac{1}{0!} = 1 \\), \\( \\frac{-3}{1!} = -3 \\), \\( \\frac{8}{2!} = 4 \\).",
         "mathjson": 4
      },
      {
         "step": 3,
         "text": "Attach \\( (x - 2)^{k} \\) to the coefficient of order \\( k \\): \\( P(x) = 1 - 3(x - 2) + 4(x - 2)^{2} \\).",
         "mathjson": [
            "Add",
