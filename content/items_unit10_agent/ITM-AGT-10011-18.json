                     "Subtract",
                     "x",
                     2
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 4,
         "text": "Substitute \\( x = 1 \\), so \\( (x - 2) = -1 \\): \\( P\\left(1\\right) = 8 \\).",
         "mathjson": 8
      }
