   "worked_solution": [
      {
         "step": 1,
         "text": "For the ratio test, \\( \\left|\\frac{a_{n+1}}{a_n}\\right| = \\frac{\\left(4 n + 4\\right) \\left|{x - 1}\\right|^{2}}{n + 2} \\).",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               [
                  "Power",
                  [
                     "Abs",
                     [
