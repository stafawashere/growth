                     "Multiply",
                     4,
                     "n"
                  ],
                  4
               ]
            ],
            [
               "Add",
               "n",
               2
            ]
         ]
      },
      {
         "step": 2,
         "text": "As \\( n \\to \\infty \\), the limit of this ratio is \\( 4 \\left|{x - 1}\\right|^{2} \\).",
         "mathjson": [
            "Multiply",
            4,
            [
               "Power",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     -1
                  ]
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The series converges when \\( 4 \\left|{x - 1}\\right|^{2} < 1 \\), that is, when \\( \\left|x - 1\\right| < \\frac{1}{2} \\).",
         "mathjson": [
            "Rational",
            1,
            2
         ]
      },
      {
         "step": 4,
         "text": "The radius of convergence is \\( R = \\frac{1}{2} \\).",
         "mathjson": [
            "Rational",
            1,
            2
         ]
      }
