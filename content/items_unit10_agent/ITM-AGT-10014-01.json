   "variant_id": null,
   "format": "mcq",
   "stem": {
      "text": "Find the radius of convergence of the power series \\( \\sum_{n=1}^{\\infty} \\frac{(x+2)^{n}}{3^{2n}\\,n} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 9
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "For the ratio test, \\( \\left|\\frac{a_{n+1}}{a_n}\\right| = \\frac{n \\left|{x + 2}\\right|}{9 \\left(n + 1\\right)} \\).",
         "mathjson": [
            "Divide",
            [
               "Multiply",
               "n",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     2
                  ]
               ]
            ],
            [
               "Multiply",
               9,
               [
                  "Add",
                  "n",
                  1
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "As \\( n \\to \\infty \\), the limit of this ratio is \\( \\frac{\\left|{x + 2}\\right|}{9} \\).",
         "mathjson": [
            "Divide",
            [
               "Abs",
               [
                  "Add",
                  "x",
                  2
               ]
            ],
            9
         ]
      },
      {
         "step": 3,
         "text": "The series converges when \\( \\frac{\\left|{x + 2}\\right|}{9} < 1 \\), that is, when \\( \\left|x + 2\\right| < 9 \\).",
         "mathjson": 9
      },
      {
         "step": 4,
         "text": "The radius of convergence is \\( R = 9 \\).",
         "mathjson": 9
      }
   ],
