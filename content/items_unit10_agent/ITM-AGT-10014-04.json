               "n",
               1
            ]
         ]
      },
      {
         "step": 2,
         "text": "As \\( n \\to \\infty \\), the limit of this ratio is \\( 3 \\left|{x - 4}\\right|^{2} \\).",
         "mathjson": [
            "Multiply",
            3,
            [
               "Power",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     -4
                  ]
               ],
               2
            ]
         ]
      },
      {
         "step": 3,
         "text": "The series converges when \\( 3 \\left|{x - 4}\\right|^{2} < 1 \\), that is, when \\( \\left|x - 4\\right| < \\frac{\\sqrt{3}}{3} \\).",
         "mathjson": [
            "Divide",
            [
               "Sqrt",
               3
            ],
            3
         ]
      },
      {
         "step": 4,
         "text": "The radius of convergence is \\( R = \\frac{\\sqrt{3}}{3} \\).",
