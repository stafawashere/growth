   "worked_solution": [
      {
         "step": 1,
         "text": "For the ratio test, \\( \\left|\\frac{a_{n+1}}{a_n}\\right| = \\frac{3 n \\left|{x - 4}\\right|^{2}}{n + 1} \\).",
         "mathjson": [
            "Divide",
            [
