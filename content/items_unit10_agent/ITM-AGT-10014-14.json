   "stem": {
      "text": "Find the radius of convergence of the power series \\( \\sum_{n=1}^{\\infty} \\frac{(x-2)^{2n}}{6^{n}\\,n^{2}} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
         "Sqrt",
         6
      ]
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "For the ratio test, \\( \\left|\\frac{a_{n+1}}{a_n}\\right| = \\frac{n^{2} \\left|{x - 2}\\right|^{2}}{6 \\left(n + 1\\right)^{2}} \\).",
         "mathjson": [
            "Divide",
