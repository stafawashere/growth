               6,
               [
                  "Power",
                  [
                     "Add",
                     "n",
                     1
                  ],
                  2
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "As \\( n \\to \\infty \\), the limit of this ratio is \\( \\frac{\\left|{x - 2}\\right|^{2}}{6} \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     -2
                  ]
               ],
               2
            ],
            6
         ]
      },
      {
         "step": 3,
         "text": "The series converges when \\( \\frac{\\left|{x - 2}\\right|^{2}}{6} < 1 \\), that is, when \\( \\left|x - 2\\right| < \\sqrt{6} \\).",
         "mathjson": [
            "Sqrt",
            6
         ]
      },
      {
         "step": 4,
         "text": "The radius of convergence is \\( R = \\sqrt{6} \\).",
         "mathjson": [
            "Sqrt",
            6
         ]
      }
