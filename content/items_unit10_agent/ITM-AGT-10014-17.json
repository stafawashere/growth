   "stem": {
      "text": "Find the radius of convergence of the power series \\( \\sum_{n=1}^{\\infty} \\frac{4^{n}x^{2n+1}}{5^{2n}} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": [
