   "stem": {
      "text": "Find the radius of convergence of the power series \\( \\sum_{n=1}^{\\infty} \\frac{(-1)^{n}(x+2)^{2n+1}}{2^{4n}} \\)."
   },
   "answer_key": {
      "form": "symbolic",
      "mathjson": 4
   },
   "worked_solution": [
      {
         "step": 1,
         "text": "For the ratio test, \\( \\left|\\frac{a_{n+1}}{a_n}\\right| = \\frac{\\left|{x + 2}\\right|^{2}}{16} \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     2
                  ]
               ],
               2
            ],
            16
         ]
      },
      {
         "step": 2,
         "text": "As \\( n \\to \\infty \\), the limit of this ratio is \\( \\frac{\\left|{x + 2}\\right|^{2}}{16} \\).",
         "mathjson": [
            "Divide",
            [
               "Power",
               [
                  "Abs",
                  [
                     "Add",
                     "x",
                     2
                  ]
               ],
               2
            ],
            16
         ]
      },
      {
         "step": 3,
         "text": "The series converges when \\( \\frac{\\left|{x + 2}\\right|^{2}}{16} < 1 \\), that is, when \\( \\left|x + 2\\right| < 4 \\).",
         "mathjson": 4
      },
      {
         "step": 4,
         "text": "The radius of convergence is \\( R = 4 \\).",
         "mathjson": 4
      }
   ],
