            ]
         ]
      },
      {
         "step": 3,
         "text": "Multiply every term by \\( 5 x^{3} \\): \\( f(x) = 5x^{3} + 10x^{5} + 20x^{7} + 40x^{9} + \\cdots \\).",
         "mathjson": [
            "Add",
