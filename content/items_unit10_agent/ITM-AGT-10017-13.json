                  9
               ]
            ]
         ]
      },
      {
         "step": 3,
         "text": "Multiply every term by \\( 2 \\): \\( f(x) = 2 - 2x^{3} + x^{6} - \\frac{1}{3}x^{9} + \\cdots \\).",
         "mathjson": [
