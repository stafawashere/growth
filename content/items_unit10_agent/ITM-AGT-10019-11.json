                  7
               ]
            ]
         ]
      },
      {
         "step": 2,
         "text": "Integrate each term, raising the power by 1 and dividing by the new power: \\( f(x) = C + x^{2} - \\frac{1}{3}x^{4} + \\frac{2}{45}x^{6} - \\frac{1}{315}x^{8} + \\cdots \\).",
         "mathjson": [
