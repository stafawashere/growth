   "problem": {
    "text": "Tea is 95 degrees at t = 0 minutes. Its temperature changes at a rate proportional to the difference between 70 degrees and its temperature, constant k > 0. Write the differential equation and initial condition.",
    "command_verb": "write"
   },
   "calculator_status": "no_calculator",
   "steps": [
    {
     "cue": "The stem names a temperature and a time.",
     "why": "H degrees, t minutes; dH/dt degrees per minute."
    },
    {
     "cue": "Proportional to the difference selects k times that difference.",
     "why": "Negative above 70, so H falls toward 70.",
     "expression": [
      "Multiply",
      "k",
      [
       "Add",
       70,
       [
        "Multiply",
        -1,
        "H"
       ]
      ]
     ],
     "relation": "new"
    },
    {
     "cue": "The rate is the derivative of H.",
     "why": "An equation about the rate, not a formula for H.",
     "expression": [
      "Equal",
      [
       "Multiply",
       "dH",
       [
        "Power",
        "dt",
        -1
       ]
      ],
      [
       "Multiply",
       "k",
       [
        "Add",
        70,
        [
         "Multiply",
         -1,
         "H"
        ]
       ]
      ]
     ],
     "relation": "new"
    },
    {
     "cue": "At time t = 0 marks a stated value.",
     "why": "It selects one solution, so it stands apart.",
     "expression": [
      "Equal",
      [
       "Apply",
       "H",
       0
      ],
      95
     ],
     "relation": "new"
    }
   ],
   "answer": {
    "form": "statement",
    "mathjson": "dH/dt = k*(70 - H) with H(0) = 95"
   },
   "delivery": {
