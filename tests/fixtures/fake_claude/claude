#!/usr/bin/env python3
"""GROWTH_FAKE_CLAUDE: a stand-in for the claude CLI in tests.

It reads its mode from $HOME/fake_claude_mode, writes what it was given (argv, stdin, the
environment and the working directory's contents) to $HOME/fake_claude_record.json, and prints
a canned result for the mode. The consolidate mode returns $HOME/fake_claude_structured_output.json
as its structured_output, or an empty consolidation when the file is absent.
"""
import json
import os
import signal
import sys
import time
from pathlib import Path

USAGE = {
   "input_tokens": 1200,
   "output_tokens": 40,
   "cache_creation_input_tokens": 300,
   "cache_read_input_tokens": 900,
}


def result_payload(**overrides):
   payload = {
      "type": "result",
      "subtype": "success",
      "is_error": False,
      "duration_ms": 2345,
      "num_turns": 1,
      "result": "The factor cancels only after the rewrite, so the answer point is lost.",
      "session_id": "fake-session-0001",
      "total_cost_usd": 0.0123,
      "usage": dict(USAGE),
   }
   payload.update(overrides)

   return payload


STREAMED_DELTAS = ("First sentence. ", "Second ", "sentence?")
RATE_LIMIT_INFO = {
   "status": "allowed",
   "resetsAt": 1790000000,
   "rateLimitType": "five_hour",
   "overageStatus": "rejected",
   "unifiedWindows": {
      "five_hour": {"utilization": 0.18, "resetsAt": 1790000000},
      "seven_day": {"utilization": 0.29, "resetsAt": 1790400000},
   },
}
HOLD_WAIT_SECONDS = 10
EMPTY_CONSOLIDATION = {"proposals": [], "student_terms": [], "stated_requests": []}


def emit(event):
   print(json.dumps(event), flush=True)


def init_event():
   return {"type": "system", "subtype": "init", "tools": [], "mcp_servers": []}


def text_delta_event(text):
   return {
      "type": "stream_event",
      "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": text}},
   }


def wait_for_release(home):
   """With fake_claude_hold present, the first delta waits until the test writes
   fake_claude_release, so a caller that shows nothing before exit is caught."""
   is_held = (home / "fake_claude_hold").exists()

   if not is_held:
      return

   deadline = time.monotonic() + HOLD_WAIT_SECONDS

   while time.monotonic() < deadline:
      if (home / "fake_claude_release").exists():
         return

      time.sleep(0.02)


def api_retry_event(error):
   return {
      "type": "system",
      "subtype": "api_retry",
      "attempt": 1,
      "max_retries": 1,
      "retry_delay_ms": 1000,
      "error_status": 429 if error == "rate_limit" else 401,
      "error": error,
   }


def outputs_stream_json():
   has_output_format = "--output-format" in sys.argv

   if not has_output_format:
      return False

   return sys.argv[sys.argv.index("--output-format") + 1] == "stream-json"


def main():
   home = Path(os.environ["HOME"])
   mode_file = home / "fake_claude_mode"
   mode = mode_file.read_text().strip() if mode_file.exists() else "success"
   record = {
      "argv": sys.argv,
      "stdin": sys.stdin.read(),
      "env": dict(os.environ),
      "cwd": os.getcwd(),
      "cwd_entries": sorted(os.listdir(os.getcwd())),
   }
   (home / "fake_claude_record.json").write_text(json.dumps(record))

   if mode == "success":
      print(json.dumps(result_payload()))
      return 0

   if mode == "structured":
      print(json.dumps(result_payload(result="", structured_output={"sentence": "Rewrite first."})))
      return 0

   if mode == "consolidate":
      chosen_output = home / "fake_claude_structured_output.json"
      has_chosen_output = chosen_output.exists()
      structured_output = json.loads(chosen_output.read_text()) if has_chosen_output else EMPTY_CONSOLIDATION
      print(json.dumps(result_payload(result="", structured_output=structured_output)))
      return 0

   if mode == "weekly_limit":
      limited = result_payload(
         subtype="error_during_execution",
         is_error=True,
         result="You've hit your weekly limit. Resets Monday 9am.",
         total_cost_usd=0,
      )
      print(json.dumps(limited))
      return 1

   if mode == "limit_message":
      message = (home / "fake_claude_message").read_text()
      limited = result_payload(subtype="error_during_execution", is_error=True, result=message, total_cost_usd=0)
      print(json.dumps(limited))
      return 1

   if mode == "auth_expired":
      expired = result_payload(
         subtype="success",
         is_error=True,
         result="Failed to authenticate: OAuth session expired and could not be refreshed",
         error="authentication_failed",
         terminal_reason="api_error",
         total_cost_usd=0,
      )
      print(json.dumps(expired))
      return 1

   if mode == "five_hour_limit_stderr":
      print("Claude usage limit reached. Your 5-hour limit resets at 3pm.", file=sys.stderr)
      return 1

   if mode == "stream_json":
      system_event = {"type": "system", "subtype": "init", "tools": ["StructuredOutput"], "mcp_servers": []}
      result_event = result_payload(result="", structured_output={"parts": [], "unreadable": []})
      print(json.dumps(system_event))
      print(json.dumps({"type": "assistant", "message": {"content": []}}))
      print(json.dumps(result_event))
      return 0

   if mode == "stream":
      if not outputs_stream_json():
         print(json.dumps(result_payload(result="".join(STREAMED_DELTAS))))
         return 0

      emit(init_event())

      for index, delta in enumerate(STREAMED_DELTAS):
         emit(text_delta_event(delta))

         if index == 0:
            wait_for_release(home)

      emit({"type": "rate_limit_event", "rate_limit_info": RATE_LIMIT_INFO, "session_id": "fake-session-0001"})
      emit(result_payload(result="".join(STREAMED_DELTAS)))
      return 0

   if mode in ("stream_limit", "stream_auth"):
      # The real CLI handles SIGINT itself. A test run started from a background shell inherits
      # SIGINT ignored, and this fake would keep that without the default handler put back.
      signal.signal(signal.SIGINT, signal.default_int_handler)
      error = "rate_limit" if mode == "stream_limit" else "authentication_failed"
      emit(init_event())
      emit(api_retry_event(error))
      time.sleep(30)
      return 1

   if mode == "malformed":
      print("this is not json")
      return 0

   if mode == "nonzero":
      print("the CLI crashed", file=sys.stderr)
      return 2

   print(f"unknown fake mode {mode}", file=sys.stderr)
   return 3


if __name__ == "__main__":
   sys.exit(main())
