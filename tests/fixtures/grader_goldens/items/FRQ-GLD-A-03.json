         "prompt": "Find \\( f'(x) \\).",
         "setup_required": false,
         "answer_latex": "\\ln x + 1",
         "worked_solution": [
            {
               "text": "Apply the product rule.",
               "latex": "f'(x) = 1 \\cdot \\ln x + x \\cdot \\frac{1}{x} = \\ln x + 1"
            }
         ],
