                  "expected": "log(x) + 1",
                  "up_to_constant": false,
                  "variable": "x"
               }
            }
         ]
      },
      {
         "id": "b",
         "prompt": "Write, but do not evaluate, an integral expression that gives the length of the graph of \\( f \\) from \\( x = 1 \\) to \\( x = e \\).",
         "setup_required": false,
         "answer_latex": "\\int_{1}^{e} \\sqrt{1 + (\\ln x + 1)^{2}}\\,dx",
         "worked_solution": [
            {
               "text": "Arc length integrand is the square root of one plus the square of the derivative.",
               "latex": "\\int_{1}^{e} \\sqrt{1 + (\\ln x + 1)^{2}}\\,dx"
