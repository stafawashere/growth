         "id": "a",
         "prompt": "Determine whether the integral converges or diverges. If it converges, find its value. Show the work that leads to your answer.",
         "setup_required": false,
         "answer_latex": "\\frac{1}{2}",
         "worked_solution": [
            {
               "text": "Replace the infinite limit with a variable.",
               "latex": "\\int_{0}^{\\infty} x e^{-x^{2}}\\,dx = \\lim_{b \\to \\infty} \\int_{0}^{b} x e^{-x^{2}}\\,dx"
            },
            {
               "text": "Antidifferentiate with u = x squared.",
               "latex": "\\int x e^{-x^{2}}\\,dx = -\\frac{1}{2} e^{-x^{2}} + C"
            },
            {
               "text": "Evaluate and take the limit.",
               "latex": "\\lim_{b \\to \\infty} \\left( -\\frac{1}{2} e^{-b^{2}} + \\frac{1}{2} \\right) = \\frac{1}{2}"
            }
         ],
