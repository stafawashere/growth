  "stem": {
    "template": "Let $f(x) = <<f>>$. Write an equation for the line tangent to the graph of $f$ at $x = <<c>>$."
  },
  "steps": [
    {
      "text": "Differentiate. By the power rule, $f'(x) = <<fp>>$.",
      "expr": "fp",
      "point_type_id": "BC-PT-99005",
      "rule_named": "power rule"
    },
    {
      "text": "Evaluate the derivative at the input to get the slope: $f'(<<c>>) = <<m>>$.",
      "expr": "m",
      "point_type_id": "BC-PT-99004"
    },
    {
      "text": "Evaluate the function at the input to get the point of tangency: $\\left(<<c>>, <<y0>>\\right)$."
    },
    {
      "text": "Write the line in point slope form, solved for $y$: $y = <<ln>>$.",
      "expr": "ln",
      "point_type_id": "BC-PT-99082",
      "rule_named": "point slope form"
    }
  ],
  "distractors": [
